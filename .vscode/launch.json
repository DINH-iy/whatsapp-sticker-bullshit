{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Stik-er-in (localhost)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build web",
            "program": "${workspaceFolder}/StickerApp.Web/bin/Debug/net10.0/StickerApp.Web.dll",
            "cwd": "${workspaceFolder}/StickerApp.Web",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5100"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ]
}
