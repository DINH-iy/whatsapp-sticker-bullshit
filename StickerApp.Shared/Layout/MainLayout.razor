@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@if(languageReady)
{
<div @key="L.Code" class="app-language-root">
<main class="simple-app">
    <div class="app-navigation" @onkeydown="HandleMenuKey">
    <a class="app-brand" href="" aria-label="@L["Stik-er-in home"]">
        <span class="app-brand-mark" aria-hidden="true"><Icon Name="image" /></span>
        <span>@L["Stik-er-in"]</span>
    </a>
    <div class="navigation-tools">
    <button class="button icon-button navigation-toggle" type="button" @onclick="ToggleMenu" @ref="menuToggle"
            aria-label="@L[menuOpen ? "Close navigation menu" : "Open navigation menu"]"
            aria-expanded="@(menuOpen ? "true" : "false")" aria-controls="main-navigation">
        <svg class="app-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            @if (menuOpen)
            {
                <path d="M6 6l12 12M6 18L18 6" />
            }
            else
            {
                <path d="M4 6h16M4 12h16M4 18h16" />
            }
        </svg>
    </button>
    <button class="button icon-button navigation-help" type="button" @onclick="() => showGuide=true" aria-label="@L["How to use Stik-er-in"]" title="@L["How to use Stik-er-in"]"><Icon Name="help" /></button>
    <ProfileButton />
    </div>
    <nav id="main-navigation" class="app-nav @(menuOpen ? "navigation-open" : "")" aria-label="@L["Main navigation"]" @onclick="CloseMenu">
        <NavLink href="" Match="NavLinkMatch.All" class="@(Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("packs/") ? "active" : null)">@L["My Packs"]</NavLink>
        @if(FriendsFeature.UnderMaintenance){<div class="navigation-maintenance"><span aria-disabled="true">@L["Friends’ packs"]<small>@L["Under maintenance"]</small></span><EditorPopup Title="@L["Friends’ packs · Under maintenance"]" IconName="info" IconOnly="true"><FriendsGuideContent /></EditorPopup></div>}
        else{<NavLink href="friends">@L["Friends’ packs"]</NavLink>}
        <NavLink href="library">@L["My Library"]</NavLink>
        <NavLink href="gifs">@L["GIF search"]</NavLink>
        <NavLink href="pinterest">@L["Import from Pinterest"]</NavLink>
        <NavLink href="imgur">@L["Import from Imgur"]</NavLink>
        <NavLink href="discord">@L["Import from Discord"]</NavLink>
        <NavLink href="requests">@L["Feature requests"]</NavLink>
        <NavLink class="navigation-settings-link" href="settings">@L["Settings"]</NavLink>
    </nav>
    @if (menuOpen)
    {
        <button class="navigation-dismiss" type="button" aria-label="@L["Dismiss navigation menu"]" tabindex="-1" @onclick="CloseMenu"></button>
    }
    </div>
    <ConnectionStatus />
    @Body
</main>
@if(showGuide){<AppGuideDialog OnClose="() => showGuide=false" />}
<ProfileSetupHost />
<GroupInviteReceiver />
<LocationSurprise />
<PinterestShareReceiver />
<StickerPreparationHost />
<NativeAppearanceHost />
<TapFeedbackHost />
<DiagnosticsHost />
<NavigationHost />
<div id="blazor-error-ui">@L["Error."] <a href="">@L["Reload"]</a></div>

</div>

}
else
{
    <div class="startup-screen" role="status"><span class="feedback-spinner" aria-hidden="true"></span><strong>@L["Stik-er-in"]</strong></div>
}
