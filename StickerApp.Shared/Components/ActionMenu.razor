@using Microsoft.AspNetCore.Components.Web

<div class="toolbar-menu" @onkeydown="HandleKey">
    <button class="button @(Primary ? "primary" : "")" type="button" @onclick="Toggle" disabled="@Disabled" @ref="trigger"
            aria-expanded="@(open ? "true" : "false")" aria-controls="@id">
        <Icon Name="@IconName" /> @Label
    </button>
    @if (open)
    {
        <button class="toolbar-menu-dismiss" type="button" aria-label="Close @Label menu" tabindex="-1" @onclick="Close"></button>
    }
    <div id="@id" class="toolbar-dropdown" hidden="@(!open)" @onclick="Close">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string IconName { get; set; } = "more";
    [Parameter] public bool Primary { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private readonly string id = "actions-" + Guid.NewGuid().ToString("N");
    private bool open;
    private ElementReference trigger;
    private void Toggle() => open = !open;
    private void Close() => open = false;
    private async Task HandleKey(KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || !open) return;
        open = false;
        await trigger.FocusAsync();
    }
}
