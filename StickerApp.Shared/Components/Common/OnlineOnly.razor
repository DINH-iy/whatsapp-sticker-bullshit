@implements IDisposable
@inject StickerApp.Shared.Services.ConnectionState Connection
<div class="online-feature @(!Connection.Online ? "is-offline" : "")">
    <fieldset class="online-feature-controls" disabled="@(!Connection.Online)" title="@(!Connection.Online ? L["No internet connection"] : null)">@ChildContent</fieldset>
    @if(!Connection.Online){<small class="offline-reason" role="status"><Icon Name="wifi-off" />@L["No internet connection"]</small>}
</div>
@code {
    [Parameter] public RenderFragment? ChildContent {get;set;}
    protected override void OnInitialized()=>Connection.Changed+=Changed;
    private void Changed()=>_=InvokeAsync(StateHasChanged);
    public void Dispose()=>Connection.Changed-=Changed;
}
