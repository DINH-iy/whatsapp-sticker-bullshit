@implements IDisposable
@inject StickerApp.Shared.Services.ConnectionState Connection
<div class="online-feature">
    <fieldset class="online-feature-controls" disabled="@(!Connection.Online)" title="@(!Connection.Online ? "No internet connection" : null)">@ChildContent</fieldset>
    @if(!Connection.Online){<small class="offline-reason" role="status">No internet connection</small>}
</div>
@code {
    [Parameter] public RenderFragment? ChildContent {get;set;}
    protected override void OnInitialized()=>Connection.Changed+=Changed;
    private void Changed()=>_=InvokeAsync(StateHasChanged);
    public void Dispose()=>Connection.Changed-=Changed;
}
