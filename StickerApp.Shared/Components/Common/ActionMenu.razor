@implements IAsyncDisposable
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Web

<div class="toolbar-menu @(TileStyle ? "add-sticker-menu" : "")" @onkeydown="HandleKey">
    <button class="@(TileStyle ? "add-sticker-card" : $"button {(Primary ? "primary" : "")}")" type="button" @onclick="Toggle" disabled="@Disabled" @ref="trigger"
            aria-expanded="@(open ? "true" : "false")" aria-controls="@id">
        @if (TriggerContent is not null) { @TriggerContent }
        else { <Icon Name="@IconName" /> @Label }
    </button>
    @if (open)
    {
        <button class="toolbar-menu-dismiss" type="button" aria-label="@L.Format("Close {0} menu", Label)" tabindex="-1" @onclick="Close"></button>
    }
    <div id="@id" class="toolbar-dropdown" @ref="dropdown" hidden="@(!open)" @onclick="Close">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string IconName { get; set; } = "more";
    [Parameter] public bool Primary { get; set; }
    [Parameter] public bool TileStyle { get; set; }
    [Parameter] public RenderFragment? TriggerContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private readonly string id = "actions-" + Guid.NewGuid().ToString("N");
    private bool open;
    private ElementReference trigger, dropdown;
    private IJSObjectReference? module, placement;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (open && placement is null)
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/action-menu.js");
            if (!open) return;
            placement = await module.InvokeAsync<IJSObjectReference>("watch", trigger, dropdown);
        }
        else if (!open && placement is not null)
        {
            await placement.InvokeVoidAsync("dispose"); await placement.DisposeAsync(); placement = null;
        }
    }
    public async ValueTask DisposeAsync()
    {
        try {
            if (placement is not null) { await placement.InvokeVoidAsync("dispose"); await placement.DisposeAsync(); }
            if (module is not null) await module.DisposeAsync();
        } catch (JSDisconnectedException) { }
    }
    private void Toggle() => open = !open;
    private void Close() => open = false;
    private async Task HandleKey(KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || !open) return;
        open = false;
        await trigger.FocusAsync();
    }
}
