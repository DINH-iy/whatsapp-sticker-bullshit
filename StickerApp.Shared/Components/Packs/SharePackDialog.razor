@inject AppLog Log
@implements IAsyncDisposable
@inject StickerApp.Shared.Services.PackSharingService Sharing
@inject IJSRuntime JS

<dialog @ref="dialog" class="folder-dialog" aria-labelledby="share-pack-title"
        @onkeydown="HandleKey" @onkeydown:preventDefault="isWorking">
    <div class="folder-dialog-heading">
        <h2 id="share-pack-title">Share pack</h2>
        <button class="button icon-button" type="button" @onclick="Close" disabled="@isWorking" title="Close" aria-label="Close sharing">
            <Icon Name="close" />
        </button>
    </div>
    <p class="helper">@Pack.Name · @Pack.StickerIds.Count @(Pack.StickerIds.Count == 1 ? "image" : "images")</p>
    <label>File format
        <select @bind="format" disabled="@isWorking">
            <option value="wastickers">Sticker pack (.wastickers)</option>
            <option value="zip">Editable backup (.zip)</option>
        </select>
    </label>
    <p class="helper">.wastickers contains WebP stickers, a cover, and the pack name. Images are prepared automatically. Editable backup keeps GIFs and other original formats, names, and tags.</p>
    <p class="helper">Still images and GIFs can share one .wastickers pack. Still images are exported with two identical frames, so they keep looking still.</p>
    @if (WaitingForPreparation)
    {
        <p class="helper" role="status">Waiting for automatic preparation. If a sticker needs attention, open its info button and edit it. You can save an editable backup at any time.</p>
    }
    <div class="settings-actions">
        <button class="button primary" type="button" @onclick="SaveFile" disabled="@(!isReady || isWorking || WaitingForPreparation)">
            <Icon Name="download" /> @Sharing.FileActionLabel
        </button>
        <button class="button" type="button" @onclick="PublishLink" disabled="@(!isReady || isWorking || !canPublish || WaitingForPreparation)">
            <Icon Name="link" /> Create share link
        </button>
    </div>
    <p class="helper">Send the pack file through chat, email, or Drive. The recipient imports it with Import pack in the Stickers app.</p>
    @if (canPublish)
    {
        <p class="helper">Creating a link uploads this pack to your server. Anyone with the link can download it.</p>
    }
    else if (isReady)
    {
        <p class="helper">To create links, add your sharing server in <a href="settings?tab=developer#pack-sharing">Settings → Developer → Pack sharing</a>.</p>
    }

    @if (isWorking)
    {
        <p role="status">@progress</p>
    }
    @if (result is not null)
    {
        <p class="settings-success" role="status">@(result.Url is null ? "Pack file prepared. Check your downloads or share sheet." : "Pack link created.")</p>
        @if (result.Url is not null)
        {
            <label for="shared-pack-link">Pack link</label>
            <div class="folder-input-row">
                <input id="shared-pack-link" class="folder-input" value="@result.Url" readonly />
                <button class="button icon-button" type="button" title="Copy pack link" aria-label="Copy pack link" @onclick="CopyLink">
                    <Icon Name="copy" />
                </button>
            </div>
            @if (copyNotice is not null)
            {
                <p class="helper" role="status">@copyNotice</p>
            }
        }
        <details class="pack-fingerprint">
            <summary>SHA-256 fingerprint</summary>
            <code>@result.Sha256</code>
            <p class="helper">This identifies the complete exported file. It detects changes, but does not verify the sender’s identity.</p>
        </details>
    }
    @if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
</dialog>
