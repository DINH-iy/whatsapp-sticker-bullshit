@implements IAsyncDisposable
@inject LibraryStore Store
@inject IJSRuntime JS

<dialog @ref="dialog" class="folder-dialog create-pack-dialog" aria-labelledby="new-pack-title" @onkeydown="HandleKey" @onkeydown:preventDefault="saving">
    <div class="folder-dialog-heading">
        <h2 id="new-pack-title">@(Pack is null ? "New pack" : "Edit pack details")</h2>
        <button class="button icon-button" type="button" aria-label="Close pack details" @onclick="Cancel" disabled="@saving"><Icon Name="close" /></button>
    </div>
    <p class="helper">The publisher appears with your pack in exports and WhatsApp.</p>
    <form @onsubmit="CreatePack" @onsubmit:preventDefault>
        <label for="new-pack-name">Pack name</label>
        <input id="new-pack-name" class="new-pack-name" @bind="name" @bind:event="oninput" maxlength="128" required autofocus placeholder="e.g. Everyday reactions" disabled="@saving" />
        <label for="new-pack-publisher" class="settings-field-label">Publisher</label>
        <input id="new-pack-publisher" class="new-pack-name" @bind="publisher" @bind:event="oninput" maxlength="128" required placeholder="Your name or brand" disabled="@saving" />
        @if (error is not null)
        {
            <p class="error" role="alert">@error</p>
        }
        <div class="dialog-actions">
            <button class="button" type="button" @onclick="Cancel" disabled="@saving">Cancel</button>
            <button class="button primary" type="submit" disabled="@(saving || string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(publisher))">@(saving ? "Saving…" : Pack is null ? "Create pack" : "Save details")</button>
        </div>
    </form>
</dialog>
