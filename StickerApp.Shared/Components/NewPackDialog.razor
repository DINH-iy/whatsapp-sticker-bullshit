@implements IAsyncDisposable
@inject LibraryStore Store
@inject IJSRuntime JS

<dialog @ref="dialog" class="folder-dialog create-pack-dialog" aria-labelledby="new-pack-title" @onkeydown="HandleKey" @onkeydown:preventDefault="saving">
    <div class="folder-dialog-heading">
        <h2 id="new-pack-title">New pack</h2>
        <button class="button icon-button" type="button" aria-label="Close new pack" @onclick="Cancel" disabled="@saving"><Icon Name="close" /></button>
    </div>
    <p class="helper">Give your sticker collection a name.</p>
    <form @onsubmit="CreatePack" @onsubmit:preventDefault>
        <label for="new-pack-name">Pack name</label>
        <input id="new-pack-name" class="new-pack-name" @bind="name" @bind:event="oninput" maxlength="128" required autofocus placeholder="e.g. Everyday reactions" disabled="@saving" />
        @if (error is not null)
        {
            <p class="error" role="alert">@error</p>
        }
        <div class="dialog-actions">
            <button class="button" type="button" @onclick="Cancel" disabled="@saving">Cancel</button>
            <button class="button primary" type="submit" disabled="@(saving || string.IsNullOrWhiteSpace(name))">@(saving ? "Creating…" : "Create pack")</button>
        </div>
    </form>
</dialog>
