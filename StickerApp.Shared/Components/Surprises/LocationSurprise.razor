@implements IAsyncDisposable
@inject IJSRuntime JS

@if (isVisible)
{
    <aside class="location-surprise" aria-labelledby="surprise-title">
        <div class="surprise-bats" aria-hidden="true"><span>🦇</span><span>🦇</span><span>🦇</span></div>
        <div class="surprise-content" role="status">
            <span class="surprise-vampire" aria-hidden="true">🧛</span>
            <div>
                <p class="surprise-eyebrow">@L["Romania unlocked"]</p>
                <h2 id="surprise-title">@L["Ce pula mea, ai 5 ani?"]</h2>
                <p>@L["Lasă smiorcăiala și fă-ți stickerele. Grădinița e în altă aplicație."]</p>
            </div>
        </div>
        <button class="button icon-button surprise-close" type="button" title="@L["Dismiss surprise"]"
                aria-label="@L["Dismiss surprise"]" @onclick="HideSurprise"><Icon Name="close" /></button>
    </aside>
}
