@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="dialog" class="folder-dialog import-original-dialog" aria-labelledby="import-original-title" @onkeydown="HandleKey">
    <div class="folder-dialog-heading">
        <h2 id="import-original-title">Add images &amp; GIFs</h2>
        <button class="button icon-button" type="button" @onclick="() => OnCancel.InvokeAsync()" aria-label="Cancel import"><Icon Name="close" /></button>
    </div>
    <p class="helper">Choose which source files to keep alongside the smaller prepared stickers. Nothing is saved until you choose Add.</p>
    <div class="import-original-list">
        @foreach (var item in Items)
        {
            <div class="import-original-row" @key="item">
                <span class="import-file-icon"><Icon Name="@(item.Animated ? "animation" : "image")" /></span>
                <div class="import-original-file"><strong>@item.Name</strong><span class="helper">@(item.Animated ? "GIF / animation" : "Image") · @item.SizeLabel</span></div>
                <label class="toggle-row"><input type="checkbox" @bind="item.KeepOriginal" disabled="@useDefaults" /> Keep original</label>
            </div>
        }
    </div>
    <p class="status-info" role="note">Discarding an original saves space after preparation succeeds. You cannot restore the full-size image or uncut GIF without reimporting your own saved copy. Without a source GIF, further trimming requires reimporting. Failed preparation keeps a recovery source.</p>
    <label class="toggle-row"><input type="checkbox" @bind="useDefaults" /> Always use my Settings defaults; skip these choices next time</label>
    @if (useDefaults)
    {
        <p class="helper">This import will use your image/GIF defaults instead of the choices above. You can turn these choices back on in Settings → General → Keep original files.</p>
    }
    <div class="dialog-actions">
        <button class="button" type="button" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
        <button class="button primary" type="button" @onclick="() => OnConfirm.InvokeAsync(useDefaults)"><Icon Name="plus" /> Add @Items.Count files</button>
    </div>
</dialog>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<OriginalImportChoice> Items { get; set; } = [];
    [Parameter] public EventCallback<bool> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private ElementReference dialog;
    private IJSObjectReference? helper;
    private bool useDefaults;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        helper = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/dialog.js");
        await helper.InvokeVoidAsync("open", dialog);
    }

    private Task HandleKey(KeyboardEventArgs args) => args.Key == "Escape" ? OnCancel.InvokeAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (helper is null) return;
        try { await helper.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
