@inject AppLog Log
@inject StickerApp.Shared.Services.IPackFileSaver FileSaver

<section class="settings-card" id="diagnostics" aria-labelledby="diagnostics-title">
    <h2 id="diagnostics-title">Diagnostics &amp; error logs</h2>
    <p class="helper">Errors are saved locally with timestamps, reference IDs, and technical details. Recent logs are kept across restarts, up to about 1 MB. Nothing is uploaded automatically.</p>
    <div class="settings-actions">
        <button class="button" @onclick="Show" disabled="@working">@(expanded ? "Refresh log" : "View log")</button>
        <button class="button" @onclick="Export" disabled="@working"><Icon Name="download" /> Export log (.txt)</button>
    </div>
    <p class="helper">Export opens your phone’s share sheet or downloads a text file in the browser. Review the file before sharing it. Common credentials, URLs, and image data are redacted.</p>
    @if (Log.StorageError is { } storageError) { <p class="error" role="alert">@storageError</p> }
    @if (error is not null) { <p class="error" role="alert">@error</p> }
    @if (notice is not null) { <p class="helper" role="status">@notice</p> }
    @if (expanded)
    {
        <pre class="diagnostic-log" aria-label="Recent diagnostic log">@preview</pre>
    }
</section>

@code {
    private bool expanded, working;
    private string preview = "";
    private string? error, notice;
    private void Show()
    {
        expanded = true;
        var lines = Log.Read().Split('\n', StringSplitOptions.RemoveEmptyEntries);
        preview = lines.Length == 0 ? "No log entries yet." : string.Join('\n', lines.TakeLast(100));
    }
    private async Task Export()
    {
        if (working) return;
        working = true; error = notice = null;
        try {
            Log.Info("Diagnostics export", "User requested a local diagnostic report.");
            await using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(Log.Report()));
            await FileSaver.SaveAsync($"Stick-it-log-{DateTime.UtcNow:yyyyMMdd-HHmmss}.txt", stream, "text/plain");
            notice = "Log file prepared. Check your downloads or share sheet.";
        } catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or InvalidOperationException or JSException or OperationCanceledException) {
            var id = Log.Error("Diagnostics export", exception);
            error = $"Could not export the log. Reference: {id}.";
        } finally { working = false; }
    }
}
