<details class="editor-zoom-menu">
    <summary class="button" aria-label="Zoom and pan controls"><Icon Name="search" /><span data-view-zoom-label>100%</span></summary>
    <div class="editor-view-controls" role="group" aria-label="Preview zoom and pan">
        <button type="button" class="button icon-button" data-view-zoom-out aria-label="Zoom out">−</button>
        <input type="number" data-view-zoom aria-label="Preview zoom percent" min="25" max="400" step="25" value="100" />
        <span>%</span>
        <button type="button" class="button icon-button" data-view-zoom-in aria-label="Zoom in">+</button>
        <button type="button" class="button" data-view-pan aria-label="Pan preview" aria-pressed="false">Pan</button>
        <button type="button" class="button" data-view-reset>Fit</button>
    </div>
</details>
