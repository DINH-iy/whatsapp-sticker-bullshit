<AppDisclosure Class="editor-zoom-menu" SummaryClass="button" Label="@L["Zoom and pan controls"]" Popup="true"><Header><Icon Name="search" /><span data-view-zoom-label>100%</span></Header><ChildContent>
    <div class="editor-view-controls" role="group" aria-label="@L["Preview zoom and pan"]">
        <button type="button" class="button icon-button" data-view-zoom-out aria-label="@L["Zoom out"]">−</button>
        <input type="number" data-view-zoom aria-label="@L["Preview zoom percent"]" min="25" max="400" step="25" value="100" />
        <span>%</span>
        <button type="button" class="button icon-button" data-view-zoom-in aria-label="@L["Zoom in"]">+</button>
        <button type="button" class="button" data-view-pan aria-label="@L["Pan preview"]" aria-pressed="false">@L["Pan"]</button>
        <button type="button" class="button" data-view-reset>@L["Fit"]</button>
        <label class="toggle-row"><input type="checkbox" data-view-loupe checked />@L["Cutout magnifier"]</label>
    </div>
</ChildContent></AppDisclosure>
