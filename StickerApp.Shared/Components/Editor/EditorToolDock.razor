<aside class="editor-tool-dock @(ActionsOnly ? "actions-only" : "")" aria-label="@($"{Title} controls")">
    @if (!ActionsOnly)
    {
        <strong class="editor-tool-title">@Title</strong>
        <div class="editor-tool-values">@ChildContent</div>
    }
    <div class="editor-tool-actions">
        <button class="button icon-button" type="button" aria-label="Cancel tool changes" title="Cancel tool changes" @onclick="OnCancel" disabled="@Disabled"><Icon Name="close" /></button>
        <button class="button primary icon-button" type="button" aria-label="Apply tool changes" title="Apply tool changes" @onclick="OnApply" disabled="@Disabled"><Icon Name="check" /></button>
    </div>
</aside>

@code {
    [Parameter] public string Title { get; set; } = "Edit";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ActionsOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
