<aside class="editor-tool-dock @(ActionsOnly ? "actions-only" : "")" aria-label="@L.Format("{0} controls", L[Title])">
    <strong class="editor-tool-title">@L[Title]</strong>
    @if (!ActionsOnly)
    {
        <div class="editor-tool-values">@ChildContent</div>
    }
    <div class="editor-tool-actions">
        <button class="button" type="button" aria-label="@L["Cancel tool changes"]" title="@L["Cancel tool changes"]" @onclick="OnCancel" disabled="@Disabled"><Icon Name="close" /><span>@L["Cancel"]</span></button>
        <button class="button primary" type="button" aria-label="@L["Apply tool changes"]" title="@L["Apply tool changes"]" @onclick="OnApply" disabled="@Disabled"><Icon Name="check" /><span>@L["Apply"]</span></button>
    </div>
</aside>

@code {
    [Parameter] public string Title { get; set; } = "Edit";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ActionsOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
