@using System.Globalization

<div class="editor-adjustments" data-adjustment-scope="@Scope">
    @if (Tool == "transform")
    {
        <TransformControls Width="@Value.Width" Height="@Value.Height" X="@Value.X" Y="@Value.Y" Rotation="@Value.Rotation" KeepRatio="@KeepRatio" KeepRatioChanged="KeepRatioChanged" LockRatio="@LockRatio" />
    }
    else if (Tool == "rotate")
    {
        <div class="rotation-control-card">
            <label class="rotation-angle-label">@L["Rotation"]<span class="rotation-angle-input"><input type="number" aria-label="@L["Rotation value"]" min="-180" max="180" step="1" value="@Number(Value.Rotation)" data-layer-property="rotation" /><span aria-hidden="true">°</span></span></label>
            <input aria-label="@L["Rotation"]" type="range" min="-180" max="180" step="1" value="@Number(Value.Rotation)" data-layer-property="rotation" />
            <RotationSnapControls />
            <div class="rotation-quick-actions" role="group" aria-label="@L["Rotation presets"]">
                <button class="button" type="button" @onclick="() => OnRotateBy.InvokeAsync(-90)">−90°</button>
                <button class="button" type="button" @onclick="() => OnRotation.InvokeAsync(0)">@L["Reset"]</button>
                <button class="button" type="button" @onclick="() => OnRotateBy.InvokeAsync(90)">+90°</button>
            </div>
        </div>
    }
    else if (Tool == "opacity")
    {
        <label><span>@L["Opacity (%)"]</span><input type="number" aria-label="@L["Opacity value"]" min="0" max="100" step="1" value="@Number(Value.Opacity * 100)" data-layer-property="opacity" /><input aria-label="@L["Opacity"]" type="range" min="0" max="100" step="1" value="@Number(Value.Opacity * 100)" data-layer-property="opacity" /></label>
        <div class="layer-presets" role="group" aria-label="@L["Opacity presets"]">
            @foreach (var percent in new[] { 0, 25, 50, 75, 100 })
            {
                <button class="button" type="button" @onclick="() => OnOpacity.InvokeAsync(percent)">@percent%</button>
            }
        </div>
    }
    else if (Tool == "border")
    {
        <div class="layer-border-controls">
            <label>@L["Width"]<input type="number" aria-label="@L["Object border width value"]" min="0" max="80" step="1" value="@Number(Value.BorderWidth)" data-layer-property="borderWidth" /><input type="range" aria-label="@L["Object border width"]" min="0" max="80" step="1" value="@Number(Value.BorderWidth)" data-layer-property="borderWidth" /></label>
            <ColorPicker Label="Object border color" Value="@Value.BorderColor" Property="borderColor" />
        </div>
    }
    else if (Tool == "tint")
    {
        <label><span>@L["Hue ·"] <span data-layer-readout="hue">@Number(Value.Hue)</span>°</span><input type="number" aria-label="@L["Hue value"]" min="-180" max="180" step="1" value="@Number(Value.Hue)" data-layer-property="hue" /><input aria-label="@L["Hue"]" type="range" min="-180" max="180" step="1" value="@Number(Value.Hue)" data-layer-property="hue" /></label>
        <label><span>@L["Strength ·"] <span data-layer-readout="colorStrength">@Math.Round(Value.ColorStrength * 100)</span>%</span><input type="number" aria-label="@L["Color strength value"]" min="0" max="100" step="1" value="@Number(Value.ColorStrength * 100)" data-layer-property="colorStrength" /><input aria-label="@L["Color strength"]" type="range" min="0" max="100" step="1" value="@Number(Value.ColorStrength * 100)" data-layer-property="colorStrength" /></label>

    }
</div>

@code {
    [Parameter] public string Tool { get; set; } = "transform";
    [Parameter] public string Scope { get; set; } = "layer";
    [Parameter, EditorRequired] public EditorAdjustmentValues Value { get; set; } = new();
    [Parameter] public int MaxSize { get; set; } = 2048;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowPosition { get; set; } = true;
    [Parameter] public bool LockRatio { get; set; }
    [Parameter] public bool KeepRatio { get; set; } = true;
    [Parameter] public EventCallback<bool> KeepRatioChanged { get; set; }
    [Parameter] public EventCallback<int> OnRotateBy { get; set; }
    [Parameter] public EventCallback<double> OnRotation { get; set; }
    [Parameter] public EventCallback<int> OnOpacity { get; set; }
    [Parameter] public EventCallback<double> OnHue { get; set; }
    [Parameter] public EventCallback<int> OnColorStrength { get; set; }
    [Parameter] public EventCallback<string?> OnTint { get; set; }
    private Task ToggleTint(ChangeEventArgs args) => OnTint.InvokeAsync(args.Value is true ? "#80d4b0" : null);
    private static string Number(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
