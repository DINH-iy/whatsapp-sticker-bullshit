@implements IDisposable

<section class="text-layer-editor" aria-label="@L["Text formatting"]">
    <AppDisclosure Open="true"><Header>@L["Caption & placement"]</Header><ChildContent>
    <label>@L["Caption"]<textarea aria-label="@L["Text content"]" rows="3" maxlength="1000" @bind="draft.Content" @bind:event="oninput" @bind:after="Changed" placeholder="@L["Type text or paste emoji…"]"></textarea></label>
    <div class="text-layout-controls">
        <div class="text-segmented-control" role="group" aria-label="@L["Text flow"]">
            <button class="button" type="button" aria-pressed="@(draft.Wrap ? "true" : "false")" disabled="@Disabled" @onclick="() => SetWrap(true)">@L["Wrap"]</button>
            <button class="button" type="button" aria-pressed="@(!draft.Wrap ? "true" : "false")" disabled="@Disabled" @onclick="() => SetWrap(false)">@L["Overflow"]</button>
        </div>
        <label>@L["Text box width"]<input type="number" aria-label="@L["Text box width"]" min="32" max="1000" @bind="draft.MaxWidth" @bind:after="Changed" disabled="@Disabled" /></label>
        <div class="text-segmented-control text-alignment-control" role="group" aria-label="@L["Text alignment"]">
            @foreach (var alignment in new[] { "left", "center", "right" })
            {
                <button class="button" type="button" aria-pressed="@(draft.Align == alignment ? "true" : "false")" disabled="@Disabled" @onclick="() => SetAlignment(alignment)">@L[alignment == "left" ? "Left" : alignment == "right" ? "Right" : "Center"]</button>
            }
        </div>
        <p class="helper">@L["Wrap starts a new line at the text box width. Overflow keeps each paragraph on one line."]</p>
    </div>
    <div class="text-placement-tools" role="group" aria-label="@L["Text placement"]">
        @foreach (var place in new[] { "top", "center", "bottom" })
        {
            <button type="button" class="button" @onclick="() => Place(place)" disabled="@Disabled">@L[place]</button>
        }
        <small class="helper">@L["Drag the text on the canvas for free placement."]</small>
    </div>
    </ChildContent></AppDisclosure>
    <AppDisclosure><Header>@L["Font & formatting"]</Header><ChildContent>
    <label>@L["Font"]<select aria-label="@L["Text font"]" @bind="draft.Font" @bind:after="Changed">
        <option value="meme">@L["Meme · Anton"]</option><option value="sans">@L["Sans serif"]</option><option value="serif">@L["Serif"]</option><option value="mono">@L["Monospace"]</option>
        @if (draft.Font.StartsWith("custom-") && !Fonts.Any(font => font.Id == draft.Font)) { <option value="@draft.Font">@L["Embedded custom font"]</option> }
        @foreach (var font in Fonts) { <option value="@font.Id">@font.Name</option> }
    </select></label>
    <label class="button file-button"><Icon Name="plus" /><span>@L["Upload font"]</span>
        <InputFile OnChange="OnImportFont" accept=".ttf,.otf,.woff,.woff2" disabled="@Disabled" aria-label="@L["Upload custom font"]" />
    </label>
    <div class="text-format-grid">
        <label>@L["Font size"]<input type="number" aria-label="@L["Text font size"]" min="8" max="256" @bind="draft.FontSize" @bind:after="Changed" /></label>
        <label>@L["Line spacing"]<input type="number" min="0.8" max="3" step="0.05" @bind="draft.LineHeight" @bind:after="Changed" /></label>
    </div>
    <div class="text-style-toggles">
        <label><input type="checkbox" @bind="draft.Bold" @bind:after="Changed" />@L["Bold"]</label>
        <label><input type="checkbox" @bind="draft.Italic" @bind:after="Changed" />@L["Italic"]</label>
        <label><input type="checkbox" @bind="draft.Underline" @bind:after="Changed" />@L["Underline"]</label>
        <label><input type="checkbox" @bind="draft.Strike" @bind:after="Changed" />@L["Strikethrough"]</label>
        <label><input type="checkbox" @bind="draft.Uppercase" @bind:after="Changed" />@L["UPPERCASE"]</label>
    </div>
    </ChildContent></AppDisclosure>
    <AppDisclosure><Header>@L["Color & gradient"]</Header><ChildContent>
        <div class="text-format-grid">
            <label>@L["Text color"]<input type="color" aria-label="@L["Text color"]" @bind="draft.Color" @bind:after="Changed" /></label>
            <label><input type="checkbox" @bind="draft.Gradient" @bind:after="Changed" />@L["Gradient"]</label>
            @if (draft.Gradient)
            {
                <label>@L["Second color"]<input type="color" aria-label="@L["Second text color"]" @bind="draft.GradientColor" @bind:after="Changed" /></label>
                <label>@L["Gradient angle"]<input type="range" aria-label="@L["Text gradient angle"]" min="-180" max="180" @bind="draft.GradientAngle" @bind:event="oninput" @bind:after="Changed" /></label>
            }
        </div>
    </ChildContent></AppDisclosure>
    <AppDisclosure><Header>@L["Outline, shadow & background"]</Header><ChildContent>
        <div class="text-format-grid">
            <label>@L["Outline width"]<input type="number" min="0" max="16" @bind="draft.OutlineWidth" @bind:after="Changed" /></label>
            <label>@L["Outline color"]<input type="color" @bind="draft.OutlineColor" @bind:after="Changed" /></label>
            <label><input type="checkbox" @bind="draft.Shadow" @bind:after="Changed" />@L["Shadow"]</label>
            <label>@L["Shadow color"]<input type="color" @bind="draft.ShadowColor" @bind:after="Changed" /></label>
            <label><input type="checkbox" @bind="draft.Background" @bind:after="Changed" />@L["Background"]</label>
            <label>@L["Background color"]<input type="color" @bind="draft.BackgroundColor" @bind:after="Changed" /></label>
        </div>
    </ChildContent></AppDisclosure>
    <p class="helper">@L["Use the canvas handles to resize and rotate. Emoji appearance follows your device."]</p>
</section>

@code {
    [Parameter, EditorRequired] public TextLayerOptions Value { get; set; } = new();
    [Parameter] public IReadOnlyList<CustomFont> Fonts { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<TextLayerOptions> OnChanged { get; set; }
    [Parameter] public EventCallback<string> OnPlace { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnImportFont { get; set; }
    private TextLayerOptions draft = new();
    private TextLayerOptions? previous;
    private CancellationTokenSource? debounce;
    private bool dirty, disposed;
    private static TextLayerOptions Copy(TextLayerOptions value) => System.Text.Json.JsonSerializer.Deserialize<TextLayerOptions>(System.Text.Json.JsonSerializer.Serialize(value))!;
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(previous, Value) && !dirty) draft = Copy(Value);
        previous = Value;
    }
    private async Task SetWrap(bool wrap) { draft.Wrap = wrap; await Changed(); }
    private async Task SetAlignment(string alignment) { draft.Align = alignment; await Changed(); }
    private async Task Changed()
    {
        dirty = true; debounce?.Cancel(); var current = debounce = new();
        try { await Task.Delay(250, current.Token); if (disposed) return; await OnChanged.InvokeAsync(Copy(draft)); if (debounce == current) dirty = false; }
        catch (OperationCanceledException) { }
        finally { if (debounce == current) debounce = null; current.Dispose(); }
    }
    public async Task FlushAsync()
    {
        if (!dirty || disposed) return;
        debounce?.Cancel(); dirty = false;
        await OnChanged.InvokeAsync(Copy(draft));
    }
    private async Task Place(string placement) { await FlushAsync(); await OnPlace.InvokeAsync(placement); }
    public void Dispose() { disposed = true; debounce?.Cancel(); }
}
