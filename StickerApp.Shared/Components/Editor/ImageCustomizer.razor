@inject AppLog Log
@inherits StickerApp.Shared.Components.Infrastructure.InteropComponentBase
@inject IJSRuntime JS

<div class="image-customizer live-editor live-tools-@(layout.ToolsPosition) live-controls-@(layout.ControlsPosition) live-size-@(layout.ButtonSize) @(Animated ? "animated-customizer" : "")" data-editor-labels="@L.EditorLabels()" aria-busy="@working">
    <div class="live-history-row" role="group" aria-label="@L["Edit history"]">
        <button class="button icon-button" type="button" @onclick='() => Run("undo")' disabled="@(working || tool != "")" aria-label="@L["Undo"]" title="@L["Undo"]"><Icon Name="undo" /></button>
        <button class="button icon-button" type="button" @onclick='() => Run("redo")' disabled="@(working || tool != "")" aria-label="@L["Redo"]" title="@L["Redo"]"><Icon Name="redo" /></button>
        <button class="button artwork-maximize" type="button" @onclick='() => Run("maximize")' disabled="@(working || tool != "")" aria-label="@L["Fit artwork to maximum"]" title="@L["Fit artwork to maximum"]"><Icon Name="resize" /><span>@L["Fit artwork to maximum"]</span></button>
        <EditorViewControls />
        <EditorHelp Animated="Animated" />
        <EditorPopup Disabled="@(working || tool != "")">
            @Options
            <button class="button" type="button" @onclick='() => Run("reset")' disabled="@(working || tool != "")"><Icon Name="reset" />@L["Reset image"]</button>
        </EditorPopup>
    </div>
    <div class="customizer-preview-dock">
        <div class="customizer-preview-stage @(tool == "adjust" && adjustmentTool == "transform" ? "transform-tool-stage" : "") @(tool == "adjust" && adjustmentTool == "opacity" ? "opacity-tool-stage" : "")">
            <div class="editor-viewport"><div class="customizer-canvas-wrap"><canvas @ref="canvas" aria-label="@L["Image editing canvas. Draw with your finger or pointer."]" /></div></div>
            @if (tool != "")
            {
                <EditorToolDock Title="@ToolTitle" Disabled="@working" ActionsOnly="@(tool is "crop" or "lasso")" OnApply="ApplyTool" OnCancel="RequestCancelTool">
                    @if (tool == "draw")
                    {
                        <div class="drawing-controls">
                            <label class="live-brush-size">@L["Size"]<input type="number" inputmode="decimal" aria-label="@L["Drawing brush size"]" min="0.5" max="256" step="0.5" @bind="drawBrush" @bind:after="UpdateSettings" disabled="@working" /></label>
                            <label class="brush-tip"><Icon Name="edit" /><select aria-label="@L["Drawing pencil type"]" @bind="brushType" @bind:after="UpdateSettings"><option value="pen">✒</option><option value="pencil">✎</option><option value="brush">🖌</option><option value="marker">▰</option></select></label>
                            <ColorPicker @bind-Value="brushColor" @bind-Value:after="UpdateSettings" Label="Brush color" Disabled="@working" />
                        </div>
                    }
                    else if (tool == "border")
                    {
                        <div class="border-controls">
                            <label>@L["Width"]<input type="number" aria-label="@L["Border thickness"]" min="0" max="80" @bind="borderWidth" @bind:event="oninput" @bind:after="UpdateBorder" /></label>
                            <ColorPicker @bind-Value="borderColor" @bind-Value:after="UpdateBorder" Label="Border color" />
                            <label>@L["Round"]<input type="number" aria-label="@L["Border corner radius"]" min="0" max="256" @bind="borderRadius" @bind:event="oninput" @bind:after="UpdateBorder" /></label>
                        </div>
                    }
                    else if (tool == "erase")
                    {
                        <label class="live-brush-size">@L["Size"]<input type="number" inputmode="decimal" aria-label="@L["Brush size"]" min="0.5" max="256" step="0.5" @bind="brush" @bind:after="UpdateSettings" disabled="@working" /></label>
                    }
                    else if (tool == "wand")
                    {
                        <label class="vertical-tool-setting"><input type="number" aria-label="@L["Color tolerance value"]" min="0" max="150" @bind="tolerance" @bind:event="oninput" @bind:after="UpdateSettings" disabled="@working" /><input aria-label="@L["Color tolerance"]" type="range" min="0" max="150" @bind="tolerance" @bind:event="oninput" @bind:after="UpdateSettings" disabled="@working" /></label>
                    }
                    else if (tool == "adjust")
                    {
                        <fieldset class="layer-adjustments" disabled="@working">
                            @if (adjustmentTool == "transform") { <TransformControls Image="true" Width="@width" Height="@height" @bind-KeepRatio="keepRatio" /> }
                            else {

                            <EditorAdjustments Tool="@adjustmentTool" Scope="image" Value="@adjustment" ShowPosition="false" MaxSize="@MaxDimension"
                                               Disabled="@working" @bind-KeepRatio="keepRatio" OnRotateBy="RotateBy" OnRotation="SetRotation" OnOpacity="SetOpacity" OnTint="SetTint" OnHue="SetHue" OnColorStrength="SetColorStrength" />
                            }
                        </fieldset>
                    }
                    else
                    {
                        <Icon Name="@(tool == "crop" ? "crop" : "lasso")" />
                    }
                </EditorToolDock>
            }
        </div>
        @if (Timeline is not null) { @Timeline(new PlaybackControlState(() => Run("preview", TrimStart, TrimEnd), previewing, working || adjustmentTool == "transform")) }
        @if (Animated && Timeline is null)
        {
            <button class="button animation-preview-button" @onclick='() => Run("preview", TrimStart, TrimEnd)' disabled="@(working || adjustmentTool == "transform")"><Icon Name="@(previewing ? "pause" : "play")" />@L[previewing ? "Stop preview" : "Preview animation"]</button>
        }
    </div>
    <EditorToolBrowser Preferences="layout" @bind-Category="category" Active="@(tool != "")" Disabled="@working">
        @switch (category)
        {
            case "cutout":
                <button class="button @(tool == "crop" ? "selected-tool" : "")" @onclick='() => SelectTool("crop")' disabled="@working"><Icon Name="crop" /><span>@L["Crop"]</span></button>
                <button class="button @(tool == "lasso" ? "selected-tool" : "")" @onclick='() => SelectTool("lasso")' disabled="@working"><Icon Name="lasso" /><span>@L["Trace cutout"]</span></button>
                <button class="button @(tool == "erase" ? "selected-tool" : "")" @onclick='() => SelectTool("erase")' disabled="@working"><Icon Name="eraser" /><span>@L["Eraser"]</span></button>
                <button class="button @(tool == "wand" ? "selected-tool" : "")" @onclick='() => SelectTool("wand")' disabled="@working"><Icon Name="wand" /><span>@L["Magic wand"]</span></button>
                break;
            case "draw":
                <button class="button @(tool == "draw" ? "selected-tool" : "")" type="button" @onclick='() => SelectTool("draw")' disabled="@working"><Icon Name="edit" /><span>@L["Draw"]</span></button>
                <button class="button @(tool == "erase" ? "selected-tool" : "")" @onclick='() => SelectTool("erase")' disabled="@working"><Icon Name="eraser" /><span>@L["Eraser"]</span></button>
                <button class="button @(tool == "border" ? "selected-tool" : "")" type="button" @onclick='() => SelectTool("border")' disabled="@working"><Icon Name="image" /><span>@L["Border"]</span></button>
                break;
            case "text":
                @if (OnAddText.HasDelegate) { <button class="button" type="button" @onclick="OnAddText" disabled="@working"><Icon Name="text" /><span>@L["Add text"]</span></button> }
                break;
            case "adjust":
                <button class="button @(adjustmentTool == "opacity" ? "selected-tool" : "")" @onclick='() => SelectAdjustment("opacity")' disabled="@working"><Icon Name="opacity" /><span>@L["Opacity"]</span></button>
                <button class="button @(adjustmentTool == "tint" ? "selected-tool" : "")" @onclick='() => SelectAdjustment("tint")' disabled="@working"><Icon Name="palette" /><span>@L["Color"]</span></button>
                <button class="button @(adjustmentTool == "transform" ? "selected-tool" : "")" @onclick='() => SelectAdjustment("transform")' disabled="@working"><Icon Name="crop" /><span>@L["Transform"]</span></button>
                <button class="button" @onclick='() => Transform("flip")' disabled="@working"><Icon Name="flip" /><span>@L["Flip"]</span></button>
                break;
            case "layers":
                @if(OnAddMeme.HasDelegate){
                    <AppDisclosure Popup="true" SummaryClass="button" Label="@L["Meme text position"]"><Header><Icon Name="text" />@L["Add white meme template"]</Header><ChildContent>
                        <div class="meme-placement-options" role="group" aria-label="@L["Meme text position"]">
                        @foreach (var placement in new[] { "top", "bottom", "both" })
                        {
                            <button class="button" type="button" @onclick="() => OnAddMeme.InvokeAsync(placement)" disabled="@working"><span class="meme-placement-preview meme-placement-@placement" aria-hidden="true"></span>@L[placement == "top" ? "Above image" : placement == "bottom" ? "Below image" : "Above and below"]</button>
                        }
                        </div>
                    </ChildContent></AppDisclosure>
                }
                @if(OnAddShape.HasDelegate){<button class="button" type="button" @onclick="OnAddShape" disabled="@working"><Icon Name="shapes" /><span>@L["Add shape"]</span></button>}
                @if (OnMakeLayered.HasDelegate) { <button class="button" type="button" @onclick="OnMakeLayered" disabled="@working"><Icon Name="layers" /><span>@L["Make layered"]</span></button> }
                break;
        }
    </EditorToolBrowser>
    <div class="customizer-controls">
        @if (error is not null) { <p class="error" role="alert">@L.Error(error)</p> }
    </div>
</div>

@if (confirmToolCancel)
{
    <ConfirmToolCancel OnKeep="() => confirmToolCancel = false" OnDiscard="CancelTool" />
}

@code {
    [Parameter, EditorRequired] public string Source { get; set; } = "";
    [Parameter] public EventCallback OnReady { get; set; }
    [Parameter] public EventCallback OnAddText { get; set; }
    [Parameter] public EventCallback OnAddShape { get; set; }
    [Parameter] public EventCallback<string> OnAddMeme { get; set; }
    [Parameter] public EventCallback OnMakeLayered { get; set; }
    [Parameter] public RenderFragment? Options { get; set; }
    [Parameter] public RenderFragment<PlaybackControlState>? Timeline { get; set; }
    public sealed record PlaybackControlState(Func<Task> Toggle, bool Playing, bool Disabled);
    [Parameter] public bool Animated { get; set; }
    [Parameter] public string InitialTool { get; set; } = "";
    [Parameter] public EventCallback<bool> OnToolActiveChanged { get; set; }
    [Parameter] public double TrimStart { get; set; }
    [Parameter] public double? TrimEnd { get; set; }
    [Parameter] public EventCallback<System.Text.Json.JsonElement> OnEditsChanged { get; set; }
    [Parameter] public int MaxDimension { get; set; } = 4096;
    [Parameter] public EventCallback<string> OnChanged { get; set; }
    [Parameter] public EventCallback<bool> OnBusyChanged { get; set; }
    private EditorAdjustmentValues adjustment = new();
    private string adjustmentTool = "";
    private ElementReference canvas;
    private IJSObjectReference? module, controller;
    private DotNetObjectReference<ImageCustomizer>? reference;
    private string? loadedSource, error;
    private double previewStart = -1;
    private double? previewEnd;
    private string tool = "";
    private string category = "cutout";
    private EditorLayoutPreferences layout = new();
    private IJSObjectReference? layoutModule;
    private bool confirmToolCancel;
    private bool working = true, keepRatio = true, previewing, isDisposed;
    private int width = 512, height = 512, tolerance = 36;
    private double brush = 40, drawBrush = 12;
    private string brushType = "pen";
    private string brushColor = "#ff4d6d";
    private string ToolTitle => tool switch { "draw" => "Draw", "border" => "Border", "crop" => "Crop", "lasso" => "Trace cutout", "erase" => "Eraser", "wand" => "Tolerance", "adjust" => adjustmentTool switch { "rotate" => "Rotation", "opacity" => "Opacity", "tint" => "Color", _ => "Transform" }, _ => "Edit" };
    private string ToolHint => tool switch {
        "draw" => "Draw on the artwork with the selected color and brush size. Strokes stay in the same position on every GIF frame. Apply keeps them; Cancel restores this tool's changes.",
        "lasso" => "Trace around the part you want to keep, then use the checkmark to apply. Everything outside becomes transparent.",
        "erase" => "Brush over unwanted parts to erase them. Use Undo to restore the last stroke.",
        "adjust" when adjustmentTool == "transform" => "Drag the artwork to move it. Drag the edge handles to resize, or the arrow handle to rotate. Apply keeps all three changes together.",
        "adjust" => "Adjust the image beside the preview. Apply keeps the changes; Cancel restores the image from before this tool.",
        "wand" => "Tap a background color to remove its connected area. Increase tolerance to include more similar colors.",
        _ => "Drag a rectangle over the image, then use the checkmark to apply." };
    protected override async Task OnAfterRenderInteropAsync(bool firstRender)
    {
        if (isDisposed) return;
        if (firstRender)
        {
            layoutModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/editor-layout.js");
            if (IsDisposed) return;
            layout = await layoutModule.InvokeAsync<EditorLayoutPreferences>("read");
            if (IsDisposed) return;
        }
        if (loadedSource == Source)
        {
            if (previewing && controller is not null && (previewStart != TrimStart || previewEnd != TrimEnd))
            {
                previewStart = TrimStart; previewEnd = TrimEnd;
                await controller.InvokeVoidAsync("setPreviewRange", TrimStart, TrimEnd);
                if (IsDisposed) return;
            }
            return;
        }
        loadedSource = Source;
        try {
            await OnBusyChanged.InvokeAsync(true);
            if (IsDisposed) return;
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/media/image/image-customizer.js");
            if (IsDisposed) return;
            reference ??= DotNetObjectReference.Create(this);
            controller ??= await module.InvokeAsync<IJSObjectReference>("create", canvas, reference);
            if (IsDisposed) return;
            var size = await controller.InvokeAsync<ImageSize>("open", Source, Math.Min(2048, MaxDimension), MaxDimension, Animated);
            if (IsDisposed) return;
            if (isDisposed) return;
            width = size.Width; height = size.Height;
            tool = InitialTool;
            category = tool is "draw" or "border" ? "draw" : "cutout";
            await controller.InvokeVoidAsync("beginTool", tool);
            if (IsDisposed) return;
            await OnToolActiveChanged.InvokeAsync(tool != "");
            if (IsDisposed) return;
            adjustment.Width = width; adjustment.Height = height;
            await OnEditsChanged.InvokeAsync(size.Recipe);
            if (IsDisposed) return;
        }
        catch (JSException exception) { if (isDisposed) return; Log.Error("Open image editor", exception); error = "Could not open this image for editing."; }
        finally { if (!isDisposed) { working = false; await OnReady.InvokeAsync(); await OnBusyChanged.InvokeAsync(false); StateHasChanged(); } }
    }
    private sealed class ImageSize { public int Width { get; set; } public int Height { get; set; } public System.Text.Json.JsonElement Recipe { get; set; } }
    [JSInvokable] public async Task ImageChanged(string png, int newWidth, int newHeight, System.Text.Json.JsonElement recipe)
    {
        width = newWidth; height = newHeight;
        adjustment.Width = width; adjustment.Height = height;
        await OnEditsChanged.InvokeAsync(recipe);
        await OnChanged.InvokeAsync(png);
        StateHasChanged();
    }
    [JSInvokable] public void ResizeChanged(int newWidth, int newHeight) { width = newWidth; height = newHeight; StateHasChanged(); }
    [JSInvokable] public void PreviewFailed(string message) { error = message; previewing = false; StateHasChanged(); }
    [JSInvokable] public void PreviewChanged(bool playing) { previewing = playing; StateHasChanged(); }
    [JSInvokable] public void AdjustmentsChanged(double rotation, double opacity, string? tint, double hue, double colorStrength)
    {
        adjustment.Rotation = rotation; adjustment.Opacity = opacity; adjustment.Tint = tint; adjustment.Hue = hue; adjustment.ColorStrength = colorStrength;
        StateHasChanged();
    }
    private async Task SelectAdjustment(string value)
    {
        if (working || controller is null) return;
        if (tool == "adjust" && adjustmentTool == value) { await RequestCancelTool(); return; }
        await controller.InvokeVoidAsync("beginTool", value == "transform" ? "resize" : "adjust");
        await controller.InvokeVoidAsync(value == "transform" ? "beginTransform" : "beginAdjustments");
        adjustmentTool = value; tool = "adjust";
        await OnToolActiveChanged.InvokeAsync(true);
    }
    private Task RotateBy(int degrees) => Run("adjustBy", degrees);
    private Task SetRotation(double degrees) => Run("adjust", "rotation", degrees);
    private Task SetOpacity(int percent) => Run("adjust", "opacity", percent / 100d);
    private Task SetHue(double hue) => Run("adjust", "hue", hue);
    private Task SetColorStrength(int strength) => Run("adjust", "colorStrength", strength / 100d);
    private Task SetTint(string? color) => Run("adjust", "tint", color);
    private async Task SelectTool(string value) { if (controller is null || working) return; if (tool == value) { await RequestCancelTool(); return; } adjustmentTool = ""; tool = value; error = null; await controller.InvokeVoidAsync("beginTool", tool); await UpdateSettings(); if(tool == "border") await UpdateBorder(); await OnToolActiveChanged.InvokeAsync(true); }
    private async Task ApplyTool()
    {
        await Run("applyTool", adjustmentTool == "transform");
        if (error is null) { tool = ""; adjustmentTool = ""; await OnToolActiveChanged.InvokeAsync(false); }
    }
    private async Task RequestCancelTool()
    {
        if (controller is null || working || isDisposed) return;
        try
        {
            if (await controller.InvokeAsync<bool>("hasToolChanges")) confirmToolCancel = true;
            else await CancelTool();
        }
        catch (JSException exception) { Log.Error("Check active tool changes", exception); error = exception.Message.Split('\n')[0]; }
    }
    private async Task CancelTool()
    {
        confirmToolCancel = false;
        await Run("cancelTool");
        if (error is null) { tool = ""; adjustmentTool = ""; await OnToolActiveChanged.InvokeAsync(false); }
    }
    private int borderWidth = 8, borderRadius;
    private string borderColor = "#ffffff";
    private Task UpdateBorder() => Run("border", borderWidth, borderColor, borderRadius);
    private Task UpdateSettings() => RunInteropAsync(async () =>
    { if (controller is not null) await controller.InvokeVoidAsync("settings", tool == "draw" ? drawBrush : brush, tolerance, brushColor, brushType); });
    private Task Transform(string action) => Run("transform", action, width, height);
    private Task Run(string method, params object?[] args) => RunInteropAsync(async () =>
    {
        if (working || controller is null) return;
        working = true; error = null;
        await OnBusyChanged.InvokeAsync(true);
        try { await controller.InvokeVoidAsync(method, args); }
        catch (JSException exception) { Log.Error("Image customization", exception); error = exception.Message.Split('\n')[0]; }
        finally { working = false; await OnBusyChanged.InvokeAsync(false); }
    });
    protected override void OnRemoving() => isDisposed = true;
    protected override async ValueTask StopInteropAsync()
    {
        if (controller is not null) await controller.InvokeVoidAsync("dispose");
    }
    protected override async ValueTask DisposeInteropAsync()
    {
        isDisposed = true;
        try {
            if (controller is not null) { await controller.InvokeVoidAsync("dispose"); await controller.DisposeAsync(); }
            if (module is not null) await module.DisposeAsync();
            if (layoutModule is not null) await layoutModule.DisposeAsync();
        } catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
