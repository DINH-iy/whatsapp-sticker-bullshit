@inject AppLog Log
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="image-customizer" aria-busy="@working">
    <div class="customizer-tools" role="group" aria-label="Image selection tools">
        <button class="button @(tool == "crop" ? "selected-tool" : "")" @onclick='() => SelectTool("crop")' disabled="@working">Crop</button>
        <button class="button @(tool == "lasso" ? "selected-tool" : "")" @onclick='() => SelectTool("lasso")' disabled="@working">Trace cutout</button>
        <button class="button @(tool == "erase" ? "selected-tool" : "")" @onclick='() => SelectTool("erase")' disabled="@working">Eraser</button>
        <button class="button @(tool == "wand" ? "selected-tool" : "")" @onclick='() => SelectTool("wand")' disabled="@working">Magic wand</button>
    </div>
    <p class="helper">@ToolHint</p>
    <div class="customizer-canvas-wrap"><canvas @ref="canvas" aria-label="Image editing canvas. Draw with your finger or pointer." /></div>
    @if (tool is "crop" or "lasso")
    {
        <button class="button" @onclick='() => Run("applySelection")' disabled="@working">@(tool == "crop" ? "Apply crop" : "Keep traced area")</button>
    }
    else if (tool == "erase")
    {
        <label>Brush size <input type="range" min="5" max="100" @bind="brush" @bind:after="UpdateSettings" disabled="@working" /></label>
    }
    else
    {
        <label>Color tolerance <input type="range" min="0" max="150" @bind="tolerance" @bind:after="UpdateSettings" disabled="@working" /></label>
    }
    <div class="customizer-tools" role="group" aria-label="Image adjustments">
        <button class="button" @onclick='() => Transform("rotate")' disabled="@working"><Icon Name="rotate" /> Rotate 90°</button>
        <button class="button" @onclick='() => Transform("flip")' disabled="@working">Flip</button>
        <button class="button" @onclick='() => Run("undo")' disabled="@working">Undo</button>
        <button class="button" @onclick='() => Run("reset")' disabled="@working">Reset image</button>
    </div>
    <details class="customizer-resize">
        <summary>Resize or stretch</summary>
        <div class="customizer-dimensions">
            <label>Width (px)<input type="number" min="1" max="4096" @bind="width" @bind:event="oninput" @bind:after="WidthChanged" disabled="@working" /></label>
            <label>Height (px)<input type="number" min="1" max="4096" @bind="height" @bind:event="oninput" @bind:after="HeightChanged" disabled="@working" /></label>
        </div>
        <label class="customizer-ratio"><input type="checkbox" @bind="keepRatio" /> Keep proportions</label>
        <p class="helper">Turn off Keep proportions to stretch. WhatsApp sizing is handled automatically after saving.</p>
        <button class="button" @onclick='() => Transform("resize")' disabled="@working">Apply size</button>
    </details>
    <p class="helper">Checkerboard areas are transparent. Cutouts are saved as PNG before automatic sticker preparation. Large images are edited at up to 2048 pixels on the longest side.</p>
    @if (error is not null) { <p class="error" role="alert">@error</p> }
</div>

@code {
    [Parameter, EditorRequired] public string Source { get; set; } = "";
    [Parameter] public EventCallback<string> OnChanged { get; set; }
    [Parameter] public EventCallback<bool> OnBusyChanged { get; set; }
    private ElementReference canvas;
    private IJSObjectReference? module, controller;
    private DotNetObjectReference<ImageCustomizer>? reference;
    private string? loadedSource, error;
    private string tool = "crop";
    private bool working = true, keepRatio = true;
    private int width = 512, height = 512, brush = 30, tolerance = 36;
    private double ratio = 1;
    private string ToolHint => tool switch {
        "lasso" => "Trace around the part you want to keep, then press Keep traced area. Everything outside becomes transparent.",
        "erase" => "Brush over unwanted parts to erase them. Use Undo to restore the last stroke.",
        "wand" => "Tap a background color to remove its connected area. Increase tolerance to include more similar colors.",
        _ => "Drag a rectangle over the image, then press Apply crop." };
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loadedSource == Source) return;
        loadedSource = Source;
        try {
            await OnBusyChanged.InvokeAsync(true);
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/media/image-customizer.js");
            reference ??= DotNetObjectReference.Create(this);
            controller ??= await module.InvokeAsync<IJSObjectReference>("create", canvas, reference);
            var size = await controller.InvokeAsync<ImageSize>("open", Source);
            width = size.Width; height = size.Height; ratio = width / (double)height;
        }
        catch (JSException exception) { Log.Error("Open image editor", exception); error = "Could not open this image for editing."; }
        finally { working = false; await OnBusyChanged.InvokeAsync(false); StateHasChanged(); }
    }
    private sealed class ImageSize { public int Width { get; set; } public int Height { get; set; } }
    [JSInvokable] public async Task ImageChanged(string png, int newWidth, int newHeight)
    {
        width = newWidth; height = newHeight; ratio = width / (double)height;
        await OnChanged.InvokeAsync(png);
        StateHasChanged();
    }
    private void WidthChanged() { if (keepRatio) height = Math.Max(1, (int)Math.Round(width / ratio)); }
    private void HeightChanged() { if (keepRatio) width = Math.Max(1, (int)Math.Round(height * ratio)); }
    private async Task SelectTool(string value) { if (controller is null) return; tool = value; error = null; await controller.InvokeVoidAsync("setTool", tool); }
    private async Task UpdateSettings() { if (controller is not null) await controller.InvokeVoidAsync("settings", brush, tolerance); }
    private Task Transform(string action) => Run("transform", action, width, height);
    private async Task Run(string method, params object[] args)
    {
        if (working || controller is null) return;
        working = true; error = null;
        await OnBusyChanged.InvokeAsync(true);
        try { await controller.InvokeVoidAsync(method, args); }
        catch (JSException exception) { Log.Error("Image customization", exception); error = exception.Message.Split('\n')[0]; }
        finally { working = false; await OnBusyChanged.InvokeAsync(false); }
    }
    public async ValueTask DisposeAsync()
    {
        try {
            if (controller is not null) { await controller.InvokeVoidAsync("dispose"); await controller.DisposeAsync(); }
            if (module is not null) await module.DisposeAsync();
        } catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
