@inject AppLog Log
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="image-customizer @(Animated ? "animated-customizer" : "")" aria-busy="@working">
    <div class="customizer-preview-dock">
        <div class="customizer-preview-stage @(tool == "adjust" && adjustmentTool == "opacity" ? "opacity-tool-stage" : "")">
            <div class="customizer-canvas-wrap"><canvas @ref="canvas" aria-label="Image editing canvas. Draw with your finger or pointer." /></div>
            @if (tool != "")
            {
                <EditorToolDock Title="@ToolTitle" Disabled="@working" ActionsOnly="@(tool is "crop" or "lasso")" OnApply="ApplyTool" OnCancel="RequestCancelTool">
                    @if (tool == "erase")
                    {
                        <label class="vertical-tool-setting"><output>@brush</output><input aria-label="Brush size" type="range" min="5" max="256" @bind="brush" @bind:event="oninput" @bind:after="UpdateSettings" disabled="@working" /></label>
                    }
                    else if (tool == "wand")
                    {
                        <label class="vertical-tool-setting"><output>@tolerance</output><input aria-label="Color tolerance" type="range" min="0" max="150" @bind="tolerance" @bind:event="oninput" @bind:after="UpdateSettings" disabled="@working" /></label>
                    }
                    else if (tool == "adjust" && adjustmentTool == "transform")
                    {
                        <div class="resize-handle-options">
                            <output data-image-resize-size>@width × @height</output>
                            <output data-image-transform-angle>0°</output>
                            <label class="layer-check"><input type="checkbox" data-image-resize-ratio @bind="keepRatio" />Keep proportions</label>
                        </div>
                    }
                    else if (tool == "adjust")
                    {
                        <fieldset class="layer-adjustments" disabled="@working">
                            <EditorAdjustments Tool="@adjustmentTool" Scope="image" Value="@adjustment" ShowPosition="false" MaxSize="@MaxDimension"
                                               Disabled="@working" @bind-KeepRatio="keepRatio" OnRotateBy="RotateBy" OnRotation="SetRotation" OnOpacity="SetOpacity" OnTint="SetTint" OnHue="SetHue" OnColorStrength="SetColorStrength" />
                        </fieldset>
                    }
                    else
                    {
                        <Icon Name="@(tool == "crop" ? "crop" : "lasso")" />
                    }
                </EditorToolDock>
            }
        </div>
        @Timeline
        @if (Animated)
        {
            <button class="button animation-preview-button" @onclick='() => Run("preview", TrimStart, TrimEnd)' disabled="@(working || adjustmentTool == "transform")"><Icon Name="@(previewing ? "pause" : "play")" />@(previewing ? "Stop preview" : "Preview animation")</button>
        }
    </div>
    <div class="customizer-controls">
        <div class="customizer-tools" role="group" aria-label="Image selection tools">
            <button class="button @(tool == "crop" ? "selected-tool" : "")" @onclick='() => SelectTool("crop")' disabled="@working"><Icon Name="crop" /><span>Crop</span></button>
            <button class="button @(tool == "lasso" ? "selected-tool" : "")" @onclick='() => SelectTool("lasso")' disabled="@working"><Icon Name="lasso" /><span>Trace cutout</span></button>
            <button class="button @(tool == "erase" ? "selected-tool" : "")" @onclick='() => SelectTool("erase")' disabled="@working"><Icon Name="eraser" /><span>Eraser</span></button>
            <button class="button @(tool == "wand" ? "selected-tool" : "")" @onclick='() => SelectTool("wand")' disabled="@working"><Icon Name="wand" /><span>Magic wand</span></button>
        </div>
        <div class="customizer-tools" role="group" aria-label="Image adjustments">
            @if (OnAddText.HasDelegate)
            {
                <button class="button" type="button" @onclick="OnAddText" disabled="@working"><Icon Name="text" /><span>Add text</span></button>
            }
            @if (OnMakeLayered.HasDelegate)
            {
                <button class="button" type="button" @onclick="OnMakeLayered" disabled="@working"><Icon Name="layers" /><span>Make layered</span></button>
            }
            <button class="button @(adjustmentTool == "opacity" ? "selected-tool" : "")" @onclick='() => SelectAdjustment("opacity")' disabled="@working"><Icon Name="opacity" /><span>Opacity</span></button>
            <button class="button @(adjustmentTool == "tint" ? "selected-tool" : "")" @onclick='() => SelectAdjustment("tint")' disabled="@working"><Icon Name="palette" /><span>Color</span></button>
            <button class="button @(adjustmentTool == "transform" ? "selected-tool" : "")" @onclick='() => SelectAdjustment("transform")' disabled="@working"><Icon Name="crop" /><span>Transform</span></button>
            <button class="button" @onclick='() => Transform("flip")' disabled="@working"><Icon Name="flip" /><span>Flip</span></button>
            <button class="button" @onclick='() => Run("undo")' disabled="@working"><Icon Name="undo" /><span>Undo</span></button>
            <button class="button" @onclick='() => Run("redo")' disabled="@working"><Icon Name="redo" /><span>Redo</span></button>
            <button class="button" @onclick='() => Run("reset")' disabled="@working"><Icon Name="reset" /><span>Reset image</span></button>
        </div>
        <HelpDisclosure Summary="Editing help">
            <p class="helper">@ToolHint</p>
            @if (Animated)
            {
                <p class="helper">Draw cutouts on this reference frame. Trace and eraser cutouts stay fixed across frames. Magic wand removes the selected connected background color on each frame. Preview to check the animation.</p>
            }
            <p class="helper">Checkerboard areas are transparent. @(Animated ? "Animation edits are saved as animated WebP." : "Cutouts are saved as PNG before automatic sticker preparation.") Images fit the 512 × 512 workspace without enlarging small sources.</p>
        </HelpDisclosure>
        @Options
        @if (error is not null) { <p class="error" role="alert">@error</p> }
    </div>
</div>

@if (confirmToolCancel)
{
    <ConfirmToolCancel OnKeep="() => confirmToolCancel = false" OnDiscard="CancelTool" />
}

@code {
    [Parameter, EditorRequired] public string Source { get; set; } = "";
    [Parameter] public EventCallback OnReady { get; set; }
    [Parameter] public EventCallback OnAddText { get; set; }
    [Parameter] public EventCallback OnMakeLayered { get; set; }
    [Parameter] public RenderFragment? Options { get; set; }
    [Parameter] public RenderFragment? Timeline { get; set; }
    [Parameter] public bool Animated { get; set; }
    [Parameter] public string InitialTool { get; set; } = "crop";
    [Parameter] public double TrimStart { get; set; }
    [Parameter] public double? TrimEnd { get; set; }
    [Parameter] public EventCallback<System.Text.Json.JsonElement> OnEditsChanged { get; set; }
    [Parameter] public int MaxDimension { get; set; } = 4096;
    [Parameter] public EventCallback<string> OnChanged { get; set; }
    [Parameter] public EventCallback<bool> OnBusyChanged { get; set; }
    private EditorAdjustmentValues adjustment = new();
    private string adjustmentTool = "";
    private ElementReference canvas;
    private IJSObjectReference? module, controller;
    private DotNetObjectReference<ImageCustomizer>? reference;
    private string? loadedSource, error;
    private double previewStart = -1;
    private double? previewEnd;
    private string tool = "crop";
    private bool confirmToolCancel;
    private bool working = true, keepRatio = true, previewing, isDisposed;
    private int width = 512, height = 512, brush = 40, tolerance = 36;
    private string ToolTitle => tool switch { "crop" => "Crop", "lasso" => "Trace cutout", "erase" => "Brush size", "wand" => "Tolerance", "adjust" => adjustmentTool switch { "rotate" => "Rotation", "opacity" => "Opacity", "tint" => "Color", _ => "Transform" }, _ => "Edit" };
    private string ToolHint => tool switch {
        "lasso" => "Trace around the part you want to keep, then use the checkmark to apply. Everything outside becomes transparent.",
        "erase" => "Brush over unwanted parts to erase them. Use Undo to restore the last stroke.",
        "adjust" when adjustmentTool == "transform" => "Drag the artwork to move it. Drag the edge handles to resize, or the arrow handle to rotate. Apply keeps all three changes together.",
        "adjust" => "Adjust the image beside the preview. Apply keeps the changes; Cancel restores the image from before this tool.",
        "wand" => "Tap a background color to remove its connected area. Increase tolerance to include more similar colors.",
        _ => "Drag a rectangle over the image, then use the checkmark to apply." };
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isDisposed) return;
        if (loadedSource == Source)
        {
            if (previewing && controller is not null && (previewStart != TrimStart || previewEnd != TrimEnd))
            {
                previewStart = TrimStart; previewEnd = TrimEnd;
                await controller.InvokeVoidAsync("setPreviewRange", TrimStart, TrimEnd);
            }
            return;
        }
        loadedSource = Source;
        try {
            await OnBusyChanged.InvokeAsync(true);
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/media/image-customizer.js");
            reference ??= DotNetObjectReference.Create(this);
            controller ??= await module.InvokeAsync<IJSObjectReference>("create", canvas, reference);
            var size = await controller.InvokeAsync<ImageSize>("open", Source, Math.Min(2048, MaxDimension), MaxDimension, Animated);
            if (isDisposed) return;
            width = size.Width; height = size.Height;
            tool = InitialTool; await controller.InvokeVoidAsync("beginTool", tool);
            adjustment.Width = width; adjustment.Height = height;
            await OnEditsChanged.InvokeAsync(size.Recipe);
        }
        catch (JSException exception) { if (isDisposed) return; Log.Error("Open image editor", exception); error = "Could not open this image for editing."; }
        finally { if (!isDisposed) { working = false; await OnReady.InvokeAsync(); await OnBusyChanged.InvokeAsync(false); StateHasChanged(); } }
    }
    private sealed class ImageSize { public int Width { get; set; } public int Height { get; set; } public System.Text.Json.JsonElement Recipe { get; set; } }
    [JSInvokable] public async Task ImageChanged(string png, int newWidth, int newHeight, System.Text.Json.JsonElement recipe)
    {
        width = newWidth; height = newHeight;
        adjustment.Width = width; adjustment.Height = height;
        await OnEditsChanged.InvokeAsync(recipe);
        await OnChanged.InvokeAsync(png);
        StateHasChanged();
    }
    [JSInvokable] public void ResizeChanged(int newWidth, int newHeight) { width = newWidth; height = newHeight; StateHasChanged(); }
    [JSInvokable] public void PreviewFailed(string message) { error = message; previewing = false; StateHasChanged(); }
    [JSInvokable] public void PreviewChanged(bool playing) { previewing = playing; StateHasChanged(); }
    [JSInvokable] public void AdjustmentsChanged(double rotation, double opacity, string? tint, double hue, double colorStrength)
    {
        adjustment.Rotation = rotation; adjustment.Opacity = opacity; adjustment.Tint = tint; adjustment.Hue = hue; adjustment.ColorStrength = colorStrength;
        StateHasChanged();
    }
    private async Task SelectAdjustment(string value)
    {
        if (working || controller is null) return;
        if (tool == "adjust" && adjustmentTool == value) { RequestCancelTool(); return; }
        await controller.InvokeVoidAsync("beginTool", value == "transform" ? "resize" : "adjust");
        await controller.InvokeVoidAsync(value == "transform" ? "beginTransform" : "beginAdjustments");
        adjustmentTool = value; tool = "adjust";
    }
    private Task RotateBy(int degrees) => Run("adjustBy", degrees);
    private Task SetRotation(double degrees) => Run("adjust", "rotation", degrees);
    private Task SetOpacity(int percent) => Run("adjust", "opacity", percent / 100d);
    private Task SetHue(double hue) => Run("adjust", "hue", hue);
    private Task SetColorStrength(int strength) => Run("adjust", "colorStrength", strength / 100d);
    private Task SetTint(string? color) => Run("adjust", "tint", color);
    private async Task SelectTool(string value) { if (controller is null || working) return; if (tool == value) { RequestCancelTool(); return; } adjustmentTool = ""; tool = value; error = null; await controller.InvokeVoidAsync("beginTool", tool); }
    private async Task ApplyTool()
    {
        await Run("applyTool", adjustmentTool == "transform");
        if (error is null) { tool = ""; adjustmentTool = ""; }
    }
    private void RequestCancelTool() => confirmToolCancel = true;
    private async Task CancelTool()
    {
        confirmToolCancel = false;
        await Run("cancelTool");
        if (error is null) { tool = ""; adjustmentTool = ""; }
    }
    private async Task UpdateSettings() { if (controller is not null) await controller.InvokeVoidAsync("settings", brush, tolerance); }
    private Task Transform(string action) => Run("transform", action, width, height);
    private async Task Run(string method, params object?[] args)
    {
        if (working || controller is null) return;
        working = true; error = null;
        await OnBusyChanged.InvokeAsync(true);
        try { await controller.InvokeVoidAsync(method, args); }
        catch (JSException exception) { Log.Error("Image customization", exception); error = exception.Message.Split('\n')[0]; }
        finally { working = false; await OnBusyChanged.InvokeAsync(false); }
    }
    public async ValueTask DisposeAsync()
    {
        isDisposed = true;
        try {
            if (controller is not null) { await controller.InvokeVoidAsync("dispose"); await controller.DisposeAsync(); }
            if (module is not null) await module.DisposeAsync();
        } catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
