<div class="live-editor-toolbar" aria-label="Editor tools">
    @if (!Active)
    {
        <div class="live-tool-choices" role="group" aria-label="@($"{Label(Category)} tools")">@ChildContent</div>
    }
    <div class="live-category-tabs" role="group" aria-label="@L["Editing categories"]">
        @foreach (var category in Preferences.Categories)
        {
            <button class="button @(Category == category ? "live-category-active" : "")" type="button" aria-pressed="@(Category == category)" disabled="@(Disabled || Active)" @onclick="() => CategoryChanged.InvokeAsync(category)"><Icon Name="@IconFor(category)" /><span>@L[Label(category)]</span></button>
        }
    </div>
</div>
@code {
    [Parameter] public EditorLayoutPreferences Preferences { get; set; } = new();
    [Parameter] public string Category { get; set; } = "cutout";
    [Parameter] public EventCallback<string> CategoryChanged { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private static string Label(string id) => id switch { "cutout" => "Cutout", "draw" => "Draw", "text" => "Text", "adjust" => "Adjust", _ => "Layers" };
    private static string IconFor(string id) => id switch { "cutout" => "lasso", "draw" => "edit", "text" => "text", "adjust" => "opacity", _ => "layers" };
}
