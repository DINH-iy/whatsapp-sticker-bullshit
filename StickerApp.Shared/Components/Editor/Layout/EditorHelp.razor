<EditorPopup Title="@L["Editing help"]" IconName="help" IconOnly="true">
    <section class="editor-help-section"><h3>@L["Canvas & history"]</h3><dl>
        <dt>@L["Workspace"]</dt><dd>@L["The canvas is always 512 × 512 units. Small images keep their size; checkerboard areas are transparent."]</dd>
        <dt>@L["Zoom & pan"]</dt><dd>@L["Open the percentage menu to zoom, type a percentage or enable Pan. Fit resets the view. Zooming does not change exported pixels."]</dd>
        <dt>@L["Undo & redo"]</dt><dd>@L["Step back or forward through applied changes. Apply or cancel the current tool first."]</dd>
    </dl></section>
    <section class="editor-help-section"><h3>@L["Cutout tools"]</h3><dl>
        <dt>@L["Crop"]</dt><dd>@L["Drag a rectangle around the area to keep, then Apply."]</dd>
        <dt>@L["Trace cutout"]</dt><dd>@L["Draw around the object to keep, then Apply. The magnified preview helps you see under your finger."]</dd>
        <dt>@L["Eraser"]</dt><dd>@L["Choose a brush size and drag across areas to remove."]</dd>
        <dt>@L["Magic wand"]</dt><dd>@L["Tap a connected background to remove it. Tolerance controls how similar nearby colors must be."]</dd>
    </dl></section>
    <section class="editor-help-section"><h3>@L["Draw, text & adjustments"]</h3><dl>
        <dt>@L["Draw"]</dt><dd>@L["Choose Size and a color, then draw on the image."]</dd>
        <dt>@L["Text"]</dt><dd>@L["Add text as an editable layer. Choose a font, size, style, color or gradient; emoji and uploaded fonts are supported."]</dd>
        <dt>@L["Transform"]</dt><dd>@L["Drag to move, drag edges/corners to resize, or use the rotation handle. Keep proportions prevents stretching. Number fields allow exact values."]</dd>
        <dt>@L["Opacity"]</dt><dd>@L["Set how transparent the image or layer is."]</dd>
        <dt>@L["Color"]</dt><dd>@L["Hue shifts colors around the color wheel. Strength blends the adjustment with the original."]</dd>
        <dt>@L["Border & flip"]</dt><dd>@L["Border adds an outline/frame with thickness and color. Layer object borders follow transparency. Flip mirrors the artwork."]</dd>
    </dl></section>
    @if (Animated)
    {
        <section class="editor-help-section"><h3>@L["Animation"]</h3><dl>
            <dt>@L["Trim & frame selection"]</dt><dd>@L["Drag the end handles to select a clip. Slide the frame handle above the strip to inspect a particular frame."]</dd>
            <dt>@L["Playback"]</dt><dd>@L["Play or pause the preview and choose a slower preview speed for precise editing. Preview speed does not change the saved animation speed."]</dd>
            <dt>@L["Timeline"]</dt><dd>@L["The timeline button shows or hides the frame strip. Set its default visibility in Settings."]</dd>
            <dt>@L["Edits across frames"]</dt><dd>@L["Drawing, trace and eraser marks stay fixed across frames. Magic wand removes the selected connected color on each frame. Preview the animation before saving."]</dd>
        </dl></section>
    }
    @if (Layers)
    {
        <section class="editor-help-section"><h3>@L["Layers"]</h3><dl>
            <dt>@L["Add & select"]</dt><dd>@L["Add images or text with Add. Open the layer list to select a layer; the top of the list is the front."]</dd>
            <dt>@L["Arrange"]</dt><dd>@L["Duplicate, bring forward, send backward, center, flip or remove the selected layer. Drag the list handles to reorder layers."]</dd>
            <dt>@L["Group"]</dt><dd>@L["Groups move, resize and rotate as one layer. Select layer checkboxes to group them; ungroup to edit their images, text or animation timing. Groups remain editable in backups."]</dd>
            <dt>@L["Pixel tools"]</dt><dd>@L["Crop, cutout, eraser and drawing open the selected image/GIF in its own editor. Apply to layer returns the result to the composition."]</dd>
        </dl></section>
    }
    <section class="editor-help-section"><h3>@L["Keep or discard changes"]</h3><dl>
        <dt>@L["Apply / Cancel"]</dt><dd>@L["Apply keeps the active tool’s changes in this editing session. Cancel restores the state from before that tool."]</dd>
        <dt>@L["Save / Options"]</dt><dd>@L["Save commits the sticker. Options contains its name, spoiler and file choices; resetting an image restores its starting artwork for this session."]</dd>
        <dt>@L["Layout"]</dt><dd>@L["Change tool/control placement, button size and category order in Settings → Editor layout. Those choices apply when an editor opens."]</dd>
    </dl></section>
</EditorPopup>
@code {
    [Parameter] public bool Animated { get; set; }
    [Parameter] public bool Layers { get; set; }
}
