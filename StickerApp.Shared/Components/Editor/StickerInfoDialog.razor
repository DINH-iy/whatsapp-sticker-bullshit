@implements IAsyncDisposable
@inject IJSRuntime JS
@inject StickerApp.Shared.Services.StickerPreparationService Preparation

<dialog @ref="dialog" class="folder-dialog sticker-info-dialog" aria-labelledby="sticker-info-title" @onkeydown="HandleKey">
    <div class="folder-dialog-heading">
        <h2 id="sticker-info-title">Sticker details</h2>
        <button class="button icon-button" type="button" @onclick="Close" aria-label="Close sticker details"><Icon Name="close" /></button>
    </div>
    <h3>@Image.Name</h3>
    <p class="@(State?.Error is not null ? "error" : "helper")" role="status">@StatusText</p>
    @if (State?.Error is { } error)
    {
        <p class="helper">@error</p>
    }
    <dl class="sticker-detail-list">
        <dt>Dimensions</dt><dd>@Image.Width × @Image.Height pixels</dd>
        <dt>File size</dt><dd>@(Math.Ceiling(Image.Bytes / 1024d)) KB</dd>
        <dt>Format</dt><dd>@Image.MimeType.Replace("image/", "").ToUpperInvariant()</dd>
        <dt>@L["Appearance"]</dt><dd>@(Image.Animated ? "Animated" : "Still image")</dd>
        @if (Image.Animated && Image.DurationMs > 0)
        {
            <dt>Duration</dt><dd>@(Image.DurationMs / 1000d) seconds</dd>
        }
        <dt>Original</dt><dd>@(Image.OriginalFileName is not null ? "Original file kept" : Image.OriginalDiscarded ? "Not kept — edits use the current sticker" : "Current image is the original")</dd>
    </dl>
    <p class="helper">Images are fitted into 512 × 512 WebP automatically without cropping or stretching. Still pictures stay visually still when exported in an animated pack.</p>
    @if (Image.Animated && Image.MimeType == "image/webp")
    {
        <p class="helper">WebP animation previews loop here, including packs whose files play only once. Saved files and exported frames stay unchanged. GIF and animated WebP stickers both support trimming, cutouts, and adjustments in Edit.</p>
    }
    <div class="dialog-actions">
        @if (State?.Error is not null)
        {
            <button class="button" type="button" @onclick="() => Preparation.Retry(Image.Id)">@L["Try again"]</button>
        }
        <button class="button" type="button" @onclick="() => OnEdit.InvokeAsync()">@L["Edit image"]</button>
        <button class="button primary" type="button" @onclick="Close">@L["Done"]</button>
    </div>
</dialog>

@code {
    [Parameter, EditorRequired] public Sticker Image { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    private ElementReference dialog;
    private IJSObjectReference? helper;
    private StickerApp.Shared.Services.StickerPreparationService.Status? State => Preparation.GetStatus(Image);
    private string StatusText => !StickerApp.Shared.Services.StickerPreparationService.NeedsPreparation(Image)
        ? "Ready for WhatsApp."
        : State?.Working == true ? "Preparing in the background…" : State?.Error is not null ? "Needs attention. Your image is kept." : "Queued for automatic preparation…";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        helper = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/dialog.js");
        await helper.InvokeVoidAsync("open", dialog);
    }
    private Task Close() => OnClose.InvokeAsync();
    private Task HandleKey(KeyboardEventArgs args) => args.Key == "Escape" ? Close() : Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        if (helper is null) return;
        try { await helper.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
