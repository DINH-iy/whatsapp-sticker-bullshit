@implements IAsyncDisposable
@inject IJSRuntime JS
@inject StickerApp.Shared.Services.StickerPreparationService Preparation

<dialog @ref="dialog" class="folder-dialog sticker-info-dialog" aria-labelledby="sticker-info-title" @onkeydown="HandleKey">
    <div class="folder-dialog-heading">
        <h2 id="sticker-info-title">@L["Sticker details"]</h2>
        <button class="button icon-button" type="button" @onclick="Close" aria-label="@L["Close sticker details"]"><Icon Name="close" /></button>
    </div>
    <h3>@Image.Name</h3>
    @if (State?.Error is { } error)
    {
        var problem = StickerApp.Shared.Services.PreparationProblem.Describe(Image, error);
        <section class="sticker-problem-panel" role="alert" aria-label="@L["Problem and fixes"]">
            <div class="problem-heading"><span class="problem-mark" aria-hidden="true">!</span><strong>@L[problem.Summary]</strong></div>
            <p>@L[problem.Recovery]</p>
            <div class="problem-actions">
                <button class="button primary" type="button" @onclick="() => OnEdit.InvokeAsync()">@L[problem.EditLabel]</button>
                <button class="button" type="button" @onclick="() => Preparation.Retry(Image.Id)">@L["Try again"]</button>
            </div>
            <small>@L["Your source file is kept. The limit applies to the finished sticker."]</small>
        </section>
        <HelpDisclosure Summary="@L["Technical details and reference"]"><p class="technical-error" lang="en">@error</p></HelpDisclosure>
    }
    else { <p class="helper" role="status">@L.Message(StatusText)</p> }
    <dl class="sticker-detail-list">
        <dt>@L["Dimensions"]</dt><dd>@Image.Width × @Image.Height @L["pixels"]</dd>
        <dt>@L["File size"]</dt><dd>@(Math.Ceiling(Image.Bytes / 1024d)) KB</dd>
        <dt>@L["Format"]</dt><dd>@Image.MimeType.Replace("image/", "").ToUpperInvariant()</dd>
        <dt>@L["Appearance"]</dt><dd>@L[Image.Animated ? "Animated" : "Still image"]</dd>
        @if (Image.Animated && Image.DurationMs > 0)
        {
            <dt>@L["Duration"]</dt><dd>@(Image.DurationMs / 1000d) @L["seconds"]</dd>
        }
        <dt>@L["Original"]</dt><dd>@L[Image.OriginalFileName is not null ? "Original file kept" : Image.OriginalDiscarded ? "Not kept — edits use the current sticker" : "Current image is the original"]</dd>
    </dl>
    <HelpDisclosure Summary="@L["About sticker preparation"]"><p class="helper">@L["Images are fitted into 512 × 512 WebP automatically without cropping or stretching. Still pictures stay visually still when exported in an animated pack."]</p></HelpDisclosure>
    @if (State?.Error is null) {
        <div class="dialog-actions">
            <button class="button" type="button" @onclick="() => OnEdit.InvokeAsync()" disabled="@(State?.Working == true || StickerApp.Shared.Services.StickerPreparationService.NeedsPreparation(Image))">@L["Edit image"]</button>
            <button class="button primary" type="button" @onclick="Close">@L["Done"]</button>
        </div>
    }

</dialog>

@code {
    [Parameter, EditorRequired] public Sticker Image { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    protected override void OnInitialized() => Preparation.Changed += PreparationChanged;
    private void PreparationChanged(bool mediaChanged) => _ = InvokeAsync(StateHasChanged);
    private ElementReference dialog;
    private IJSObjectReference? helper;
    private StickerApp.Shared.Services.StickerPreparationService.Status? State => Preparation.GetStatus(Image);
    private string StatusText => !StickerApp.Shared.Services.StickerPreparationService.NeedsPreparation(Image)
        ? "Ready for WhatsApp."
        : State?.Working == true ? "Preparing in the background…" : State?.Error is not null ? "Needs attention. Your image is kept." : "Queued for automatic preparation…";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        helper = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/dialog.js");
        await helper.InvokeVoidAsync("open", dialog);
    }
    private Task Close() => OnClose.InvokeAsync();
    private Task HandleKey(KeyboardEventArgs args) => args.Key == "Escape" ? Close() : Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        Preparation.Changed -= PreparationChanged;
        if (helper is null) return;
        try { await helper.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
