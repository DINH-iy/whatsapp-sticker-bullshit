@implements IAsyncDisposable
@inject IJSRuntime JS
@inject LibraryStore Store
@inject AppLog Log
@inject StickerApp.Shared.Services.ForegroundActivity Activity

<dialog @ref="dialog" class="folder-dialog video-import-dialog" aria-labelledby="video-import-title" @onkeydown="HandleKey" @onkeydown:stopPropagation>
    <div class="folder-dialog-heading">
        <h2 id="video-import-title">@L[ClipReview ? $"Trim {ImportSource} video" : "Video to sticker"]</h2>
        <button class="button icon-button" type="button" aria-label="@L["Close video import"]" @onclick="Close" disabled="@saving"><Icon Name="close" /></button>
    </div>
    <div hidden="@(InitialVideo is not null)">
    <label class="button file-button"><Icon Name="animation" />@L["Choose video"]
        <input @ref="fileInput" type="file" accept="video/*,.mp4,.mov,.webm,.m4v" aria-label="@L["Choose video file"]" disabled="@converting" />
    </label>
    </div>
    <div @ref="editorRoot" class="video-import-editor" aria-busy="@(converting || loading || estimating ? "true" : "false")">
        @if (error is not null) { <div class="video-problem-panel" role="alert"><div class="problem-heading"><span class="problem-mark" aria-hidden="true">!</span><strong>@L["Video could not be processed"]</strong></div><p>@L[error]</p></div> }
        @if (loading) {
            <div class="media-loading-state" role="status">
                <span class="media-loading-ring" aria-hidden="true"><Icon Name="film" /></span>
                <strong>@L["Loading video…"]</strong><span>@L["Reading the clip and preparing its preview."]</span>
                <small>@L["Videos up to 20 MB are supported."]</small>
            </div>
        }
        @if (ready) {
            <section class="video-size-estimate @(sizeEstimate?.TooLarge == true ? "estimate-too-large" : "")" aria-live="polite" aria-busy="@estimating">
                @if (!validClip) {
                    <div class="problem-heading"><span class="problem-mark" aria-hidden="true">!</span><strong>@L[validationMessage]</strong></div>
                    <div class="estimate-actions"><button class="button" type="button" @onclick="FitVideoLimits">@L["Fit video limits"]</button></div>
                }
                else if (estimating) { <div class="estimate-loading"><span class="feedback-spinner" aria-hidden="true"></span><span>@L["Checking sticker size…"]</span></div> }
                else if (sizeEstimate is { } estimate) {
                    <div class="estimate-heading"><span class="estimate-status">@L[estimate.TooLarge ? "Clip needs shortening" : estimate.NearLimit ? "Size may be too large" : "Ready to create"]</span><span class="estimate-limit">500 KB @L["maximum"]</span></div>
                    <div class="estimate-primary"><strong>@EstimateSize(estimate.StickerLow)–@EstimateSize(estimate.StickerHigh)</strong><span>@L["Estimated WhatsApp sticker"]</span></div>
                    <div class="estimate-budget-track" role="img" aria-label="@L.Format("Estimated sticker size {0}; maximum 500 KB", EstimateSize(estimate.StickerLow))"><span style="width:@BudgetPercent(estimate.StickerLow)%"></span></div>
                    @if (estimate.TooLarge) {
                        <p class="estimate-guidance">@L["Choose a shorter clip or fewer frames before converting."]</p>
                        <div class="estimate-actions">
                            <button class="button primary" type="button" @onclick="ShortenToEstimate">@L["Shorten to"] @estimate.SuggestedSeconds.ToString("0.0") s</button>
                            @if (fps != 8) { <button class="button" type="button" @onclick="UseSmallerFrameRate">@L["Use 8 fps"]</button> }
                        </div>
                    }
                    <small class="estimate-secondary">@L["Animated WebP · ready for WhatsApp after creation"]</small>
                }
                else { <button class="button" type="button" @onclick="Validate">@L["Estimate size again"]</button> }
            </section>
        }
        <video @ref="video" class="video-import-preview" controls="@(!converting && !estimating)" playsinline muted preload="auto" aria-label="@L["Video clip preview"]" hidden="@(!ready)" />
        @if (ready) {
            <AnimationTimeline Duration="@duration" Start="@start" End="@end" Thumbnails="@thumbnails" StartChanged="ChangeStart" EndChanged="ChangeEnd" Disabled="@converting">
                <PlaybackControl><button class="button animation-preview-button" type="button" @onclick="Preview" disabled="@(converting || estimating)" aria-label="@L[playing ? "Pause clip" : "Preview clip"]"><Icon Name="@(playing ? "pause" : "play")" />@L[playing ? "Pause" : "Preview"]</button></PlaybackControl>
            </AnimationTimeline>
            <div class="video-import-options">
                @if (!ClipReview) { <label>@L["Sticker name"]<input @bind="name" maxlength="128" disabled="@converting" /></label> }
                <label>@L["Frames per second"]<select @bind="fps" @bind:after="Validate" disabled="@converting"><option value="0" disabled="@(nativeFps <= 0)">@L["Follow source"] @(nativeFps > 0 ? $"({nativeFps:0.##} fps)" : L["· unavailable"])</option><option value="30">@L["30 · smoother"]</option><option value="8">@L["8 · smaller file"]</option><option value="12">12</option><option value="20">20</option></select></label>
            </div>
            <small class="video-limits-summary">@L["Video limits: 20 MB input · 5 seconds · 100 frames · 500 KB sticker"]</small>
            <HelpDisclosure Summary="@L["Video import help"]">
                <p class="helper">@L["Size estimates use a few sampled frames and can differ from the finished file. Video frames are encoded directly into an animated WebP sticker. Creation checks the exact 500 KB limit before saving. Conversion is local and has no sound."]</p>
                <p class="helper">@L["Follow source preserves frame timing for supported MP4/MOV files up to 125 fps. Sticker frames must last at least 8 milliseconds. Shorten high-frame-rate clips to stay within 100 frames."]</p>
                @if (ClipReview) { <p class="helper">@L.Format("Cancel stops the whole {0} import; nothing has been saved yet.", ImportSource)</p> }
            </HelpDisclosure>
        }
    </div>
    <div class="dialog-actions">
        <button class="button" type="button" @onclick="Close" disabled="@saving">@L["Cancel"]</button>
        <button class="button primary" type="button" @onclick="Convert" disabled="@(!ready || !validClip || estimating || sizeEstimate is null || sizeEstimate.TooLarge || converting || string.IsNullOrWhiteSpace(name))"><Icon Name="check" />@L[ClipReview ? "Use clip" : "Create sticker"]</button>
    </div>
</dialog>
@if (converting)
{
    <OperationProgressDialog Title="@L[saving && !ClipReview ? "Adding sticker…" : "Creating sticker…"]" Progress="@progress" ProgressLabel="@L["Sticker conversion progress"]" CanCancel="@(!saving)" OnCancel="Close" />
}

@code {
    [Parameter] public bool LoadPicked { get; set; }
    [Parameter] public string ImportSource { get; set; } = "Pinterest";
    [Parameter] public Guid? PackId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Guid> OnImported { get; set; }
    [Parameter] public Stream? InitialVideo { get; set; }
    [Parameter] public string? InitialName { get; set; }
    [Parameter] public EventCallback<byte[]> OnConverted { get; set; }
    private bool ClipReview => OnConverted.HasDelegate;
    private ElementReference dialog, video, fileInput, editorRoot;
    private IJSObjectReference? helper, module, controller;
    private DotNetObjectReference<VideoImportDialog>? reference;
    private bool ready, loading, converting, saving, playing, disposed;
    private double duration, start, end;
    private string name = "Video clip";
    private string? error;
    private int fps = 12, progress, frameCount;
    private double nativeFps;
    private bool validClip, estimating;
    private int validationVersion;
    private CancellationTokenSource? estimateDelay;
    private VideoSizeEstimate? sizeEstimate;
    public sealed class VideoSizeEstimate {
        public long StickerLow { get; set; } public long StickerHigh { get; set; }
        public bool TooLarge { get; set; } public bool NearLimit { get; set; }
        public double SuggestedSeconds { get; set; }
    }
    private static string BudgetPercent(long bytes) => Math.Min(100, bytes / 512000d * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    private Task FitVideoLimits() => ChangeEnd(Math.Min(duration, start + Math.Min(5, Math.Floor(100 / Math.Max(1, fps == 0 ? nativeFps : fps) * 10) / 10)));
    private static string EstimateSize(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / (1024d * 1024):0.0} MB" : $"{Math.Ceiling(bytes / 1024d)} KB";
    private async Task ShortenToEstimate() { if (sizeEstimate is { } estimate) await ChangeEnd(Math.Min(end, start + estimate.SuggestedSeconds)); }
    private async Task UseSmallerFrameRate() { fps = 8; await Validate(); }
    private string validationMessage = "Checking clip…";
    public sealed class ClipValidation { public bool Valid { get; set; } public int Frames { get; set; } public string Message { get; set; } = ""; }
    private async Task Validate() {
        if (controller is null || !ready || disposed) return;
        var version = ++validationVersion;
        estimateDelay?.Cancel();
        using var delay = new CancellationTokenSource(); estimateDelay = delay;
        sizeEstimate = null; error = null; estimating = false;
        try {
            await controller.InvokeVoidAsync("cancelEstimate");
            var result = await controller.InvokeAsync<ClipValidation>("validate", start, end, fps);
            if (version != validationVersion || disposed) return;
            validClip = result.Valid; frameCount = result.Frames; validationMessage = result.Message;
            if (!validClip) return;
            estimating = true; StateHasChanged();
            await Task.Delay(450, delay.Token);
            var estimate = await controller.InvokeAsync<VideoSizeEstimate>("estimate", TimeSpan.FromMinutes(2), start, end, fps);
            if (version == validationVersion && !disposed) sizeEstimate = estimate;
        }
        catch (OperationCanceledException) { }
        catch (JSException exception) {
            if (version == validationVersion && !disposed) {
                Log.Error("Video size estimate", exception);
                error = "Size estimation stopped or failed. Keep the app open and try estimating again, or choose a shorter clip.";
            }
        }
        finally {
            if (ReferenceEquals(estimateDelay, delay)) estimateDelay = null;
            if (version == validationVersion && !disposed) { estimating = false; StateHasChanged(); }
        }
    }
    private string[] thumbnails = [];
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        helper = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/dialog.js");
        await helper.InvokeVoidAsync("open", dialog);
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/media/video/video-import.js");
        reference = DotNetObjectReference.Create(this);
        controller = await module.InvokeAsync<IJSObjectReference>("create", video, fileInput, editorRoot, reference);
        if (LoadPicked) await controller.InvokeVoidAsync("loadPicked");
        if (InitialVideo is not null)
        {
            if (InitialVideo.CanSeek && InitialVideo.Length > LibraryStore.MaxVideoImportBytes) { error = "This video exceeds the 20 MB limit. Choose a smaller video or trim it in your gallery first."; StateHasChanged(); return; }
            try
            {
                using var stream = new DotNetStreamReference(InitialVideo, leaveOpen: true);
                await controller.InvokeVoidAsync("loadStream", TimeSpan.FromMinutes(3), stream, (InitialName ?? "Pinterest video") + ".mp4");
            }
            catch (JSException exception) { if (!disposed) { error = exception.Message.Split('\n')[0]; loading = false; StateHasChanged(); } }
        }
    }
    public sealed class VideoInfo { public string Name { get; set; } = "Video clip"; public double Duration { get; set; } public double NativeFps { get; set; } public int Width { get; set; } public int Height { get; set; } public string[] Thumbnails { get; set; } = []; }
    [JSInvokable] public void VideoLoading() { ++validationVersion; estimateDelay?.Cancel(); sizeEstimate = null; estimating = false; ready = false; loading = true; error = null; StateHasChanged(); }
    [JSInvokable] public async Task VideoReady(VideoInfo info) { name = info.Name.Length > 128 ? info.Name[..128] : info.Name; duration = info.Duration; start = 0; end = Math.Min(5, duration); thumbnails = info.Thumbnails; nativeFps = info.NativeFps; fps = nativeFps > 0 && nativeFps <= 125 ? 0 : 12; end = Math.Min(end, Math.Floor(100 / (fps == 0 ? nativeFps : fps) * 10) / 10); ready = true; loading = false; StateHasChanged(); await Validate(); StateHasChanged(); }
    [JSInvokable] public void VideoFailed(string message) { error = message; loading = false; StateHasChanged(); }
    [JSInvokable] public void VideoPlayback(bool value) { playing = value; StateHasChanged(); }
    [JSInvokable] public void VideoProgress(int value) { progress = value; StateHasChanged(); }
    private async Task ChangeStart(double value) { start = Math.Clamp(value, 0, Math.Max(0, duration - 0.1)); end = Math.Clamp(end, start + 0.1, Math.Min(duration, start + 5)); await controller!.InvokeVoidAsync("setRange", start, end); await Validate(); }
    private async Task ChangeEnd(double value) { end = Math.Clamp(value, 0.1, duration); start = Math.Clamp(start, Math.Max(0, end - 5), end - 0.1); await controller!.InvokeVoidAsync("setRange", start, end); await Validate(); }
    private async Task Preview() { try { await controller!.InvokeVoidAsync("preview", start, end); } catch (JSException) { error = "Could not play this video on this device."; } }
    private async Task Convert()
    {
        if (controller is null || converting || !ready || !validClip || estimating || sizeEstimate is null || sizeEstimate.TooLarge) return;
        converting = true; error = null; progress = 0;
        using var operation = Activity.BeginOperation(TimeSpan.FromMinutes(5));
        var token = operation.Token;
        try
        {
            await using var result = await controller.InvokeAsync<IJSStreamReference>("convert", token, start, end, fps);
            if (disposed) return;
            await using var stream = await result.OpenReadStreamAsync(500 * 1024, token);
            using var memory = new MemoryStream(); await stream.CopyToAsync(memory, token);
            if (disposed) return;
            token.ThrowIfCancellationRequested();
            var bytes = memory.ToArray();
            var info = MediaInspector.Inspect(bytes);
            if (info.MimeType != "image/webp" || !info.Animated || info.Width != 512 || info.Height != 512 ||
                bytes.Length > 500 * 1024 || info.DurationMs is <= 0 or > 5000 || info.MinimumFrameMs < 8)
                throw new InvalidDataException("This video did not produce a valid animated sticker. Choose a shorter clip and try again.");
            saving = true; StateHasChanged();
            if (ClipReview) await OnConverted.InvokeAsync(bytes);
            else
            {
                var stickerId = await Store.ImportAsync(name.Trim() + ".webp", bytes, PackId, cancellationToken: token);
                await OnImported.InvokeAsync(stickerId);
            }
        }
        catch (Exception ex) when (ex is JSException or IOException or InvalidOperationException or NotSupportedException or OperationCanceledException)
        {
            if (!disposed) { Log.Error("Video import", ex); error = ex is JSException ? ex.Message.Split('\n')[0] : ex.Message; }
        }
        finally { converting = saving = false; }
    }
    private async Task Close() { if (saving) return; ++validationVersion; estimateDelay?.Cancel(); if (controller is not null) await controller.InvokeVoidAsync("cancel"); await OnClose.InvokeAsync(); }
    private Task HandleKey(KeyboardEventArgs args) => args.Key == "Escape" ? Close() : Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        disposed = true; ++validationVersion; estimateDelay?.Cancel();
        try { if (controller is not null) { await controller.InvokeVoidAsync("dispose"); await controller.DisposeAsync(); } if (module is not null) await module.DisposeAsync(); if (helper is not null) await helper.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
