@inject IJSRuntime JS

<div class="history-controls" role="group" aria-label="Navigation history">
    <button class="button icon-button" type="button" @onclick="Back" title="Go back" aria-label="Go back"><Icon Name="left" /></button>
    <button class="button icon-button" type="button" @onclick="Forward" title="Go forward" aria-label="Go forward"><Icon Name="right" /></button>
</div>

@code {
    private Task Back() => JS.InvokeVoidAsync("stickerNavigation.back").AsTask();
    private Task Forward() => JS.InvokeVoidAsync("history.forward").AsTask();
}
