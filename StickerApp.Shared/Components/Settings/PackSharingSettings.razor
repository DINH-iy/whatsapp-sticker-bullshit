@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="settings-card" id="pack-sharing" aria-labelledby="pack-sharing-settings-title">
    <h2 id="pack-sharing-settings-title">@L["Pack sharing"]</h2>
    <p class="helper">@L["File import/export works without a server. To create download links, connect your own sharing server."]</p>
    <form @onsubmit="SaveSettings" @onsubmit:preventDefault>
        <label for="sharing-server">@L["Sharing server URL"]</label>
        <input id="sharing-server" type="url" class="folder-input" @ref="serverInput" value="@serverUrl"
               placeholder="@L["https://stickers.example.com"]" disabled="@(!isReady)" autocomplete="off" />
        <label for="sharing-token" class="settings-field-label">@L["Publishing token"]</label>
        <input id="sharing-token" type="password" class="folder-input" @ref="tokenInput" autocomplete="off"
               placeholder="@L[hasToken ? "Leave blank to keep the saved token" : "Token configured on your server"]" disabled="@(!isReady)" />
        <p class="helper">@L["The token is saved in this device’s local storage, outside pack files. It is not encrypted. Anyone with a generated pack link can download that pack."]</p>
        <div class="settings-actions">
            <button class="button primary" type="submit" disabled="@(!isReady)">@L["Save sharing settings"]</button>
            @if (hasToken)
            {
                <button class="button" type="button" @onclick="Disconnect">@L["Disconnect"]</button>
            }
        </div>
    </form>
    @if (notice is not null)
    {
        <p class="settings-success" role="status">@L.Message(notice)</p>
    }
    @if (error is not null)
    {
        <p class="error" role="alert">@L.Error(error)</p>
    }
</section>
