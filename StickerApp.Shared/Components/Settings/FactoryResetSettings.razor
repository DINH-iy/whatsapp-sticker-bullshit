@inherits StickerApp.Shared.Components.Infrastructure.InteropComponentBase
@inject LibraryStore Store
@inject AppLog Log
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject StickerApp.Shared.Services.IFormFactor FormFactor
<section class="settings-card factory-reset-settings" aria-labelledby="factory-reset-title">
    <h2 id="factory-reset-title">@L["Factory reset"]</h2>
    <p>@L["Erase your profile, packs, stickers, original files, editable layers, uploaded fonts, saved app settings and local diagnostics. The app will start with first-launch setup again."]</p>
    <p class="error"><strong>@L["This cannot be undone."]</strong> @L["Files you exported or backed up outside app storage are not erased. Shared packs on a friends server stay there; leave the group first to remove them."]</p>
    @if (FormFactor.GetFormFactor() == "Web") { <p class="helper">@L["This browser host uses a shared library. Reset erases that library for every browser connected to this host."]</p> }
    <button class="button danger" @onclick="Begin"><Icon Name="trash" />@L["Factory reset…"]</button>
</section>
@if (stage > 0)
{
    <dialog @ref="dialog" class="folder-dialog factory-reset-dialog" aria-labelledby="reset-confirm-title" @oncancel="Cancel" @oncancel:preventDefault>
        <h2 id="reset-confirm-title">@L[working ? "Resetting the app…" : stage == 1 ? "Erase all app data?" : "Final confirmation"]</h2>
        @if(working)
        {
            <FactoryResetProgressView Progress="@resetProgress" Step="@resetStep" />
        }
        else if (stage == 1)
        {
            <p>@L["This permanently deletes your profile, packs, stickers, originals, layers, fonts and settings."]</p>
            <p class="error"><strong>@L["This cannot be undone."]</strong> @L["Export any packs you want to keep before continuing."]</p>
            <div class="dialog-actions"><button class="button" @onclick="Cancel">@L["Cancel"]</button><button class="button danger" @onclick="() => stage = 2">@L["Continue to final confirmation"]</button></div>
        }
        else
        {
            <p>@L["Everything listed will be erased."] <strong>@L["There is no undo or recovery inside the app."]</strong></p>
            <label for="factory-reset-confirm">@L["Type RESET to confirm"]</label><input id="factory-reset-confirm" autocomplete="off" spellcheck="false" @bind="confirmation" @bind:event="oninput" disabled="@working" />
            @if (error is not null) { <p class="error" role="alert">@L.Error(error)</p><p class="helper">@L.Format("Reset stopped during: {0}", L[resetProgress.Stage])</p><p class="helper">@L.Error(errorDetail)</p> }
            <div class="dialog-actions"><button class="button" @onclick="Cancel" disabled="@working">@L["Cancel"]</button><button class="button danger" @onclick="Reset" disabled="@(working || confirmation != "RESET")"><Icon Name="trash" />@L[working ? "Erasing…" : "Erase everything permanently"]</button></div>
        }
    </dialog>
}
@code {
    private int stage;
    private string confirmation = "";
    private string? error, errorDetail;
    private bool working, openDialog, disposed;
    private FactoryResetProgress resetProgress=new("Waiting for library operations…");
    private int resetStep=1;
    private ElementReference dialog;
    private IJSObjectReference? dialogHelper;
    private void Begin() { stage = 1; confirmation = ""; error = errorDetail = null; openDialog = true; }
    protected override async Task OnAfterRenderInteropAsync(bool firstRender)
    {
        if (!openDialog) return;
        openDialog = false;
        dialogHelper ??= await JS.InvokeAsync<IJSObjectReference>("import","./_content/StickerApp.Shared/js/ui/dialog.js");
        if (IsDisposed) return;
        await dialogHelper.InvokeVoidAsync("open",dialog);
        if (IsDisposed) return;
    }
    private void Cancel() { if(!working) { stage = 0; confirmation = ""; } }
    private async Task Reset()
    {
        if(working || stage != 2 || confirmation != "RESET") return;
        working = true; error = errorDetail = null;resetStep=1;resetProgress=new("Waiting for library operations…");
        await InvokeAsync(StateHasChanged);
        var erased = false;
        IJSObjectReference? module=null;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import","./_content/StickerApp.Shared/js/ui/factory-reset.js");
            var progress=new Progress<FactoryResetProgress>(value => {
                if(!disposed && working && resetStep==1){resetProgress=value;StateHasChanged();}
            });
            await Store.FactoryResetAsync(progress); erased = true;
            resetStep=2;resetProgress=new("Clearing saved preferences…");await InvokeAsync(StateHasChanged);
            await module.InvokeVoidAsync("clearPreferences");
            (Services.GetService(typeof(StickerApp.Shared.Services.ITapFeedback)) as StickerApp.Shared.Services.ITapFeedback)?.Configure(true,25);
            Log.Clear();
            resetStep=3;resetProgress=new("Restarting the app…");await InvokeAsync(StateHasChanged);
            if(Services.GetService(typeof(StickerApp.Shared.Services.IAppRestart)) is StickerApp.Shared.Services.IAppRestart nativeRestart)
            {
                // Release JS references while the old native renderer is still alive.
                await module.DisposeAsync();module=null;
                await nativeRestart.RestartAsync();
            }
            else await module.InvokeVoidAsync("restart");
        }
        catch(Exception ex) when(ex is IOException or UnauthorizedAccessException or InvalidOperationException or JSException or System.Text.Json.JsonException)
        {
            Log.Error("Factory reset failed",ex);
            errorDetail=ex.Message;
            error = erased ? "Library data was erased, but resetting preferences did not finish. Close other app tabs, then try again. " : "Reset did not finish. Some files may already have been erased. ";
            working = false;
        }
        finally
        {
            if(module is not null)try{await module.DisposeAsync();}catch(JSDisconnectedException){}
        }
    }
    protected override async ValueTask DisposeInteropAsync() { disposed=true; if(dialogHelper is not null) { try { await dialogHelper.DisposeAsync(); } catch(JSDisconnectedException) { } } }
}
