@if (Entries.Count > 0)
{
    var groups = Entries.GroupBy(entry => entry.Operation).Select(group => new Timing(group.Key, group.Average(entry => entry.Milliseconds), group.Max(entry => entry.Milliseconds), group.Count())).OrderByDescending(item => item.Average).ToList();
    var maximum = Math.Max(1000, groups.Max(item => item.Average));
    <section class="performance-chart" aria-label="@L["Slowest operations"]">
        <div class="performance-chart-heading"><h3>@L["Where time is spent"]</h3><span>@Entries.Count @L["recorded steps"]</span></div>
        <div class="performance-legend"><span class="timing-fast">● @L["Under 1 s"]</span><span class="timing-medium">● @L["1–3 s"]</span><span class="timing-slow">● @L["Over 3 s"]</span></div>
        @foreach (var item in groups.Take(12))
        {
            var level = item.Average < 1000 ? "fast" : item.Average <= 3000 ? "medium" : "slow";
            <div class="performance-bar-row timing-@level">
                <div class="performance-bar-label"><strong>@Label(item.Name)</strong><span>@Seconds(item.Average) s · @L[level == "fast" ? "Fast" : level == "medium" ? "Noticeable" : "Slow"]</span></div>
                <div class="performance-bar-track" role="img" aria-label="@($"{Label(item.Name)}: {Seconds(item.Average)} s")"><span style="width:@Percent(item.Average / maximum)%"></span></div>
                <small>@L["Average"] · @item.Count @L["samples"] · @L["Slowest"] @Seconds(item.Maximum) s</small>
            </div>
        }
        <p class="helper">@L["Bars compare average elapsed time. Totals include their smaller steps; do not add the bars together. Colors indicate waiting time, not CPU or battery use."]</p>
    </section>
}
else { <p class="helper">@L["No timings yet. Enable recording, open a slow GIF or editor, then refresh."]</p> }
@code {
    [Parameter] public IReadOnlyList<AppLog.PerformanceEntry> Entries { get; set; } = [];
    private sealed record Timing(string Name, double Average, double Maximum, int Count);
    private static string Seconds(double value) => (value / 1000).ToString("0.00");
    private static string Percent(double value) => Math.Max(1, value * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private string Label(string name) => L[name switch {
        "Video: full GIF encoding" => "Creating GIF (previous pipeline)",
        "Video: direct WebP encoding" => "Creating animated sticker",
        "Video: parallel WebP frames" => "Compressing video frames",
        "Video: estimate compressed size" => "Checking video size",
        "Sticker preparation: total" => "Preparing sticker",
        "Editor: open image" => "Opening image editor",
        "Editor: inspect animation and timeline" => "Loading animation timeline",
        "Animation worker: inspect" => "Reading animation frames",
        "Animation worker: edit" => "Saving animation edits",
        "Layer editor: total opening" => "Opening layer editor",
        "Animation: decode source" => "Decoding animation",
        "Layer animation: timeline thumbnails" => "Creating timeline previews",
        _ => name
    }];
}
