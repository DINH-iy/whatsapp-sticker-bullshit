@inject LibraryStore Store
@inject AppLog Log
@inject IJSRuntime JS
@inherits StickerApp.Shared.Components.Infrastructure.InteropComponentBase

<section @ref="statisticsElement" class="settings-card library-statistics-card @(customizingStats ? "quick-stats-editing" : "")" aria-labelledby="library-statistics-title" aria-busy="@(busy || layoutSaving ? "true" : "false")">
    <h2 id="library-statistics-title" class="visually-hidden">@L["Library statistics & storage"]</h2>
    <div class="quick-stats-toolbar statistics-action-row">
        <button type="button" class="button icon-button" disabled="@busy" @onclick="Refresh" title="@L["Refresh statistics"]" aria-label="@L["Refresh statistics"]"><Icon Name="rotate" /></button>
        <button class="button" type="button" disabled="@(!layoutReady || busy || layoutSaving)" aria-pressed="@(customizingStats ? "true" : "false")" @onclick="() => customizingStats = !customizingStats">@L[customizingStats ? "Done customizing" : "Customize stats"]</button>
        <EditorPopup Title="@L["Library statistics & storage"]" IconName="info" IconOnly="true" CloseLabel="Close"><p>@L["Library space on this device or host computer."]</p></EditorPopup>
        @if (customizingStats) { <button class="text-button" type="button" disabled="@(busy || layoutSaving)" @onclick="ResetQuickStats">@L["Reset defaults"]</button> }
    </div>
    @if (layoutNotice is not null) { <p class="helper quick-stats-notice" role="status">@L.Message(layoutNotice)</p> }
    @if (customizingStats) { <p class="helper">@L["Drag cards between Quick overview and Library details to choose what stays visible. Drag to reorder, or use the pin and arrow buttons."]</p> }
    @if (statistics is { } stats)
    {
        @if (customizingStats) { <h3 class="settings-subheading">@L["Quick overview"]</h3> }
        <dl class="library-statistics-grid library-quick-statistics" data-stat-zone="quick">
            @foreach (var stat in QuickStats)
            {
                <StatisticTile @key="stat.Id" Stat="@stat" Quick="true" Editing="@customizingStats" Pinned="true" Disabled="@(busy || layoutSaving)"
                               First="@(quickStats.IndexOf(stat.Id) == 0)" Last="@(quickStats.IndexOf(stat.Id) == quickStats.Count - 1)"
                               OnToggle="ToggleQuickStat" OnMove="direction => MoveQuickStat(stat.Id, direction)" />
            }
        </dl>
        @if (quickStats.Count == 0) { <p class="helper">@L["No quick stats selected. Use Customize stats to choose them."]</p> }
        <AppDisclosure Class="storage-section" Open="@customizingStats"><Header>@L["Library details"] <small>@L["Images, originals & layers"]</small></Header><ChildContent>
        <div class="storage-section-body">
        <dl class="library-statistics-grid" data-stat-zone="library">
            @foreach (var stat in AllStats)
            {
                <StatisticTile @key="stat.Id" Stat="@stat" Editing="@customizingStats" Pinned="@quickStats.Contains(stat.Id)" Disabled="@(busy || layoutSaving)" OnToggle="ToggleQuickStat" />
            }
        </dl>
        <dl class="storage-location"><dt>@L["Library folder"]</dt><dd>@stats.Root</dd></dl>
        <p class="helper">@L["Totals count each file once, even when an image belongs to several packs. Logs, exported downloads, and previous library folders are excluded. Originals and layers can be much larger than prepared stickers."]</p>
        </div>
        </ChildContent></AppDisclosure>
        <div class="total-storage-summary">
            <div class="pack-storage-heading"><strong>@L["Total used"]</strong><span>@Size(stats.MediaBytes + stats.IndexBytes)</span></div>
            <div class="storage-view-controls" role="group" aria-label="@L["Storage chart style"]">
                <button type="button" disabled="@busy" aria-pressed="@(!donutChart ? "true" : "false")" @onclick="() => ChangeChart(false)"><Icon Name="chart-bar" />@L["Bar"]</button>
                <button type="button" disabled="@busy" aria-pressed="@(donutChart ? "true" : "false")" @onclick="() => ChangeChart(true)"><Icon Name="chart-donut" />@L["Donut"]</button>
            </div>
            <div class="storage-chart-layout @(donutChart ? "storage-chart-layout-donut" : "")">
                @if (donutChart)
                {
                    <div class="storage-donut" role="img" aria-label="@L.Format("Total used: {0}. See storage breakdown below.", Size(stats.MediaBytes + stats.IndexBytes))">
                        <svg viewBox="0 0 112 112" aria-hidden="true" focusable="false">
                            <circle class="storage-donut-track" cx="56" cy="56" r="44" />
                            @foreach (var slice in DonutSlices())
                            {
                                <circle class="storage-donut-slice @slice.Segment.ColorClass" cx="56" cy="56" r="44" pathLength="100"
                                        stroke-dasharray="@slice.Dash" stroke-dashoffset="@slice.Offset" transform="rotate(-90 56 56)">
                                    <title>@SegmentLabel(slice.Segment): @Size(slice.Segment.Bytes)</title>
                                </circle>
                            }
                        </svg>
                        <div class="storage-donut-label" aria-hidden="true"><span>@L["Used"]</span><strong>@Size(stats.MediaBytes + stats.IndexBytes)</strong></div>
                    </div>
                }
                else
                {
                    <div class="total-storage-track" role="img" aria-label="@L.Format("Total used: {0}. See storage breakdown below.", Size(stats.MediaBytes + stats.IndexBytes))">
                        @foreach (var segment in stats.StorageSegments)
                        {
                            <span class="storage-slice @segment.ColorClass" style="width: @StorageWidth(segment.Bytes)" title="@SegmentLabel(segment): @Size(segment.Bytes)"></span>
                        }
                    </div>
                }
            <div class="storage-breakdown">
            <ul class="storage-legend" aria-label="@L["Total storage breakdown"]">
                @foreach (var segment in stats.StorageSegments)
                {
                    <li class="@segment.ColorClass"><span class="pack-storage-dot" aria-hidden="true"></span><span>@SegmentLabel(segment)</span><strong>@Size(segment.Bytes)</strong></li>
                }
                @if (Store.StorageLimitBytes is { } totalBudget && totalBudget > stats.MediaBytes + stats.IndexBytes)
                {
                    <li class="storage-color-free"><span class="pack-storage-dot" aria-hidden="true"></span><span>@L["Remaining within limit"]</span><strong>@Size(totalBudget - stats.MediaBytes - stats.IndexBytes)</strong></li>
                }
            </ul>
            <p class="helper">@L["Each file counts once here. Pack colors include their images and retained sources; files used by several packs are grouped as shared. With a storage limit, the unfilled part shows remaining library budget. Your chart style is remembered."]</p>
            </div>
            </div>
        </div>
        @if (stats.Fonts.Count > 0)
        {
            <AppDisclosure><Header>@L.Format("Custom fonts · {0}", Size(stats.FontBytes))</Header><ChildContent>
                @foreach (var font in stats.Fonts) { <p class="font-storage-row"><span>@font.Name</span><span>@Size(font.Bytes)</span></p> }
            </ChildContent></AppDisclosure>
        }
        @if (stats.PackStorage.Count == 0)
        {
            <p class="helper">@L["Create a pack to see its storage here."]</p>
        }
        else
        {
            <AppDisclosure Class="pack-storage-details"><Header>@L["Pack details"] <small>@L.Format("({0} packs)", stats.PackStorage.Count)</small></Header><ChildContent>
                <div class="pack-storage-list">
                    @for (var packIndex = 0; packIndex < stats.PackStorage.Count; packIndex++)
                    {
                        var pack = stats.PackStorage[packIndex];
                        <div class="pack-storage-item pack-color-@(packIndex % 10)">
                            <div class="pack-storage-heading">
                                <strong><span class="pack-storage-dot" aria-hidden="true"></span>@pack.Name</strong>
                                <span>@Size(pack.StickerBytes + pack.SourceBytes)</span>
                            </div>
                            <div class="pack-storage-track" aria-hidden="true"><div style="width: @PackWidth(pack, stats.PackStorage)"></div></div>
                            <p class="helper">@L.Format("{0} stickers · {1} image files · {2} originals & layers", pack.Images, Size(pack.StickerBytes), Size(pack.SourceBytes))</p>
                        </div>
                    }
                </div>
                <p class="helper">@L["Bars compare each pack with the largest pack. Shared images appear in each pack's size, so pack sizes can add up to more than the library total. Covers and pack metadata are included in the library index above."]</p>
            </ChildContent></AppDisclosure>
        }
    }
    <div class="storage-options-grid">
    <AppDisclosure Class="storage-section"><Header>@L["Display units"] <small>@LimitUnit</small></Header><ChildContent>
        <div class="storage-section-body">
            <label for="storage-display-units">@L["Storage units"]</label>
            <select id="storage-display-units" value="@(decimalUnits ? "decimal" : "binary")" @onchange="ChangeUnits" disabled="@busy">
                <option value="binary">@L["MiB — binary (1,048,576 bytes)"]</option>
                <option value="decimal">@L["MB — decimal (1,000,000 bytes)"]</option>
            </select>
            <p class="helper">@L["Applies to totals, pack sizes, cleanup estimates, and the limit input. Switching units keeps your actual storage limit unchanged. This preference is remembered."]</p>
        </div>
    </ChildContent></AppDisclosure>
    <AppDisclosure Class="storage-section"><Header>@L["Storage limit"] <small>@L[Store.StorageLimitBytes is { } cap ? Size(cap) : "No limit"]</small></Header><ChildContent>
    <div class="storage-section-body">
    @if (statistics is { } usage && Store.StorageLimitBytes is { } budget)
    {
        var used = usage.MediaBytes + usage.IndexBytes;
        <label for="library-storage-meter">@L.Format("{0} of {1} used", Size(used), Size(budget))</label>
        <progress id="library-storage-meter" class="library-storage-meter" max="@budget" value="@Math.Min(used, budget)"></progress>
        <p class="helper">@L[used > budget ? "The library is above its limit. Existing files are kept; clean up or raise the limit to add more." : $"{Size(Math.Max(0, budget - used))} remaining within your library budget."]</p>
    }
    <label class="toggle-row"><input type="checkbox" @bind="limitEnabled" disabled="@busy" /> @L["Limit library storage"]</label>
    <label for="library-limit">@L["Maximum library size"] (@LimitUnit)</label>
    <input id="library-limit" type="number" min="@InputNumber(MinimumLimit)" max="@InputNumber(MaximumLimit)" step="any" @bind="limitAmount" disabled="@(busy || !limitEnabled)" />
    <button type="button" class="button" @onclick="SaveStorageLimit" disabled="@busy">@L["Save storage limit"]</button>
    <p class="helper">@(decimalUnits ? "1,000 MB = 1 GB." : "1,024 MiB = 1 GiB.") @L["This limits the saved library, including sources, layers, unused media, and its index. It does not reserve device space or guarantee that much free space. Temporary imports and conversions need extra room. Logs, exported packs, and other apps are outside this budget. Cleanup and saves that reduce usage are allowed even above the limit."]</p>
    </div>
    </ChildContent></AppDisclosure>
    <AppDisclosure Class="storage-section"><Header>@L["Original file defaults"] <small>@L[askOnImport ? "Ask per file" : "Use defaults"]</small></Header><ChildContent>
    <div class="storage-section-body">
    <label class="toggle-row"><input type="checkbox" checked="@(!askOnImport)" @onchange="ChangeImportPrompts" disabled="@busy" /> @L["Always use these defaults; skip per-file import choices"]</label>
    <label class="toggle-row"><input type="checkbox" checked="@keepStills" @onchange="ChangeStillRetention" disabled="@busy" /> @L["Keep originals for new still images"]</label>
    <label class="toggle-row"><input type="checkbox" checked="@keepAnimations" @onchange="ChangeAnimationRetention" disabled="@busy" /> @L["Keep source GIFs / animations for future trimming"]</label>
    <p class="helper">@L["Choose for each image or GIF when adding files. These defaults preselect the choices, or apply automatically if you skip them. Saved per-file choices stay with that image. You can also change the choice when saving an edit. Original GIF sources are on by default to keep trimming available."]</p>
    @if (!keepStills || !keepAnimations)
    {
        <p class="status-info" role="note">@L["When originals are off, only the smaller prepared sticker remains after conversion succeeds. You cannot return to the previous image or uncut GIF without reimporting a copy you saved yourself. Prepared animated WebP stickers can still be trimmed and edited. Editable layer projects still keep their embedded sources."]</p>
    }
    </div>
    </ChildContent></AppDisclosure>
    @if (busy) { <p class="helper" role="status">@L.Message(progress)</p> }
    @if (error is not null) { <p class="error" role="alert">@L.Error(error)</p> }
    @if (notice is not null) { <p class="settings-success" role="status">@L.Message(notice)</p> }
    <AppDisclosure Class="storage-section storage-cleanup"><Header>@L["Cleanup & duplicates"] <small>@L[statistics is { UnusedFiles: > 0 } measured ? $"{measured.UnusedFiles} unused files" : "Review before removing"]</small></Header><ChildContent>
    <div class="storage-section-body">
    <p class="helper">@L["Scan first, then review what to remove. Originals and editable layers are kept unless you explicitly choose to remove originals."]</p>
    <button type="button" class="button" disabled="@busy" @onclick="Scan">@L["Find duplicates & unused files"]</button>
    @if (scan is not null)
    {
        <h3 class="settings-subheading">@L["Review cleanup"]</h3>
        <p class="helper">@L["Only exact file duplicates are matched. Different originals or editable layers stay separate. Similar-looking pictures with different encodings are not matched."]</p>
        @if (scan.Duplicates.Count == 0)
        {
            <p>@L["No exact duplicate images or GIFs found."]</p>
        }
        @for (var index = 0; index < scan.Duplicates.Count; index++)
        {
            var group = scan.Duplicates[index];
            var groupIndex = index;
            <fieldset class="duplicate-review" disabled="@busy">
                <legend>@L.Format("Duplicate group {0} · {1} copies", index + 1, group.Images.Count)</legend>
                @if (duplicatePreviews.TryGetValue(group.Fingerprint, out var preview))
                {
                    <img class="duplicate-preview" src="@preview" alt="@L["Preview shared by these duplicate copies"]" loading="lazy" />
                }
                <label for="duplicate-keep-@index">@L["Keep this image and its name"]</label>
                <select id="duplicate-keep-@index" @bind="keepers[groupIndex]">
                    @foreach (var image in group.Images)
                    {
                        <option value="@image.Id">@image.Name · @L[image.Animated ? "Animated" : "Still"] · @Size(image.Bytes) · Copy @(group.Images.ToList().IndexOf(image) + 1)</option>
                    }
                </select>
                <p class="helper">@L["Other copies"]: @string.Join(", ", group.Images.Where(image => image.Id != keepers[groupIndex]).Select(image => image.Name))</p>
            </fieldset>
        }
        @if (scan.Duplicates.Count > 0)
        {
            <p class="helper">@L["Removing copies merges their pack memberships, favorites, and tags into the chosen images. Pack order is retained where possible. Copy names are discarded. This cannot be undone."]</p>
            <label class="toggle-row"><input type="checkbox" @bind="confirmDuplicates" disabled="@busy" /> @L["I reviewed the copies and want to remove them."]</label>
            <button type="button" class="button danger" disabled="@(busy || !confirmDuplicates)" @onclick="RemoveDuplicates">@L.Format("Remove {0} duplicate copies", DuplicateCount)</button>
        }
        <h3 class="settings-subheading">@L["Remove retained originals"]</h3>
        <p>@L.Format("{0} source files · {1} reclaimable", scan.Statistics.RemovableOriginals, Size(scan.Statistics.RemovableOriginalBytes))</p>
        <p class="helper">@L["Keeps prepared stickers. Removes the saved source images and GIFs for stickers that are ready. Editable layer sources stay. You cannot restore previous images or uncut GIFs; trimmed-away frames require reimporting your own saved file. This cannot be undone."]</p>
        @if (scan.Statistics.RemovableOriginals > 0)
        {
            <label class="toggle-row"><input type="checkbox" @bind="confirmOriginals" disabled="@busy" /> @L["I have saved any originals I need and accept losing the previous versions."]</label>
            <button type="button" class="button danger" disabled="@(busy || !confirmOriginals)" @onclick="RemoveOriginals">@L["Remove retained originals"]</button>
        }
        <h3 class="settings-subheading">@L["Unused edit files"]</h3>
        <p>@L.Format("{0} unused files · {1}", scan.Statistics.UnusedFiles, Size(scan.Statistics.UnusedBytes))</p>
        <p class="helper">@L["These app-generated files are no longer referenced by any image, original, or editable composition. Cleanup keeps all referenced originals and layers."]</p>
        @if (scan.UnusedFiles.Count > 0)
        {
            <label class="toggle-row"><input type="checkbox" @bind="confirmUnused" disabled="@busy" /> @L["Permanently delete these unused files."]</label>
            <button type="button" class="button danger" disabled="@(busy || !confirmUnused)" @onclick="RemoveUnused">@L["Remove unused files"]</button>
        }
    }
    </div>
    </ChildContent></AppDisclosure>
    </div>
</section>
