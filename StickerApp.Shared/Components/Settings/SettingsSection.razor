@inject NavigationManager Navigation
<AppDisclosure Class="settings-accordion" @bind-Open="expanded" BodyClass="settings-accordion-body"><Header><h2>@L[Title]</h2></Header><ChildContent>
    @ChildContent
</ChildContent></AppDisclosure>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Anchor { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] public SettingsExpansion? Expansion { get; set; }
    private bool expanded;
    private int revision = -1;
    private string? previousFragment;
    protected override void OnParametersSet()
    {
        if (Expansion is not null && revision != Expansion.Revision)
        {
            revision = Expansion.Revision;
            expanded = Expansion.Expanded;
        }
        var fragment = new Uri(Navigation.Uri).Fragment;
        if (fragment != previousFragment && fragment == "#" + Anchor) expanded = true;
        previousFragment = fragment;
    }
}
