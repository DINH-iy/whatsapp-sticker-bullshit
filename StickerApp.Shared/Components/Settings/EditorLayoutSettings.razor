@using StickerApp.Shared.Components.Editor.DesignPreview
@implements IAsyncDisposable
@inject IJSRuntime JS
<section class="settings-card" id="editor-layout" aria-labelledby="editor-layout-title">
    <h2 id="editor-layout-title">@L["Editor layout"]</h2>
    <p class="helper">Customize the image, GIF and layer editors. Changes apply the next time you open an editor and are remembered on this device.</p>
    <div class="editor-layout-setting-fields">
        <label>Tool categories<select @bind="preferences.ToolsPosition" @bind:after="Save" disabled="@(!ready)"><option value="bottom">Below the image</option><option value="top">Above the image</option></select></label>
        <label>Active tool controls<select @bind="preferences.ControlsPosition" @bind:after="Save" disabled="@(!ready)"><option value="bottom">Below the image</option><option value="right">Right of the image</option><option value="left">Left of the image</option></select></label>
        <label>Button size<select @bind="preferences.ButtonSize" @bind:after="Save" disabled="@(!ready)"><option value="comfortable">Comfortable</option><option value="compact">Compact</option></select></label>
        <label class="toggle-row"><input type="checkbox" @bind="preferences.ShowTimeline" @bind:after="Save" disabled="@(!ready)" />Show GIF timeline by default</label>
    </div>
    <AppDisclosure Class="editor-details"><Header>Category order</Header><ChildContent>
        <ol class="editor-layout-order">
            @for (var i = 0; i < preferences.Categories.Length; i++)
            {
                var index = i; var id = preferences.Categories[i];
                <li><span>@EditorDesignPreview.Label(id)</span>
                    <button class="button icon-button" aria-label="Move @EditorDesignPreview.Label(id) earlier" @onclick="() => Move(index,-1)" disabled="@(!ready || index == 0)"><Icon Name="up" /></button>
                    <button class="button icon-button" aria-label="Move @EditorDesignPreview.Label(id) later" @onclick="() => Move(index,1)" disabled="@(!ready || index == preferences.Categories.Length-1)"><Icon Name="down" /></button>
                </li>
            }
        </ol>
    </ChildContent></AppDisclosure>
    <div class="settings-actions"><a class="button primary" href="editor-preview"><Icon Name="image" />Open editor example</a><button class="button" @onclick="Reset" disabled="@(!ready)">Reset editor layout</button></div>
    @if (error is not null) { <p class="error" role="alert">@error</p> }
    @if (saved) { <p class="helper" role="status">Editor layout saved on this device.</p> }
    <AppDisclosure Class="editor-details"><Header>Try the layout with sample artwork</Header><ChildContent><div class="editor-layout-live-preview"><EditorDesignPreview Preferences="preferences" /></div></ChildContent></AppDisclosure>
</section>
@code {
    private EditorLayoutPreferences preferences = new();
    private IJSObjectReference? module;
    private bool ready, saved;
    private string? error;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/editor-layout.js"); preferences = await module.InvokeAsync<EditorLayoutPreferences>("read"); ready = true; }
        catch (JSException) { error = "Could not load editor layout preferences."; }
        StateHasChanged();
    }
    private async Task Save()
    {
        if (module is null) return;
        try { preferences = await module.InvokeAsync<EditorLayoutPreferences>("save", preferences); saved = true; error = null; }
        catch (JSException) { saved = false; error = "Could not save this layout. Device storage may be unavailable."; }
    }
    private async Task Move(int index, int delta)
    {
        var next = index + delta;
        if (next < 0 || next >= preferences.Categories.Length) return;
        (preferences.Categories[index],preferences.Categories[next]) = (preferences.Categories[next],preferences.Categories[index]);
        await Save();
    }
    private async Task Reset()
    {
        if (module is null) return;
        try { preferences = await module.InvokeAsync<EditorLayoutPreferences>("reset"); saved = true; error = null; }
        catch (JSException) { error = "Could not reset editor layout."; }
    }
    public async ValueTask DisposeAsync() { if(module is not null) { try { await module.DisposeAsync(); } catch(JSDisconnectedException) { } } }
}
