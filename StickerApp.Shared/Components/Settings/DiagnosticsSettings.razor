@inject AppLog Log
@inject StickerApp.Shared.Services.IPackFileSaver FileSaver

<section class="settings-card" id="diagnostics" aria-labelledby="diagnostics-title">
    <h2 id="diagnostics-title">@L["Diagnostics & error logs"]</h2>
    <p class="helper">@L["Errors are saved locally with timestamps, reference IDs, and technical details. Recent logs are kept across restarts, up to about 1 MB. Nothing is uploaded automatically."]</p>
    <p class="helper">@L["Log entries and technical diagnostics always remain in English."]</p>
    <div class="settings-actions">
        <button class="button" @onclick="Show" disabled="@working" aria-expanded="@(expanded ? "true" : "false")" aria-controls="diagnostic-log-preview">@L[expanded ? "Refresh log" : "View log"]</button>
        @if (expanded)
        {
            <button class="button" type="button" @onclick="Close">@L["Close log"]</button>
        }
        <button class="button" @onclick="Export" disabled="@working"><Icon Name="download" /> @L["Export log (.txt)"]</button>
    </div>
    <p class="helper">@L["Export opens your phone’s share sheet or downloads a text file in the browser. Review the file before sharing it. Common credentials, URLs, and image data are redacted."]</p>
    @if (Log.StorageError is { } storageError) { <p class="error" role="alert">@L.Error(storageError)</p> }
    @if (error is not null) { <p class="error" role="alert">@L.Error(error)</p> }
    @if (notice is not null) { <p class="helper" role="status">@L.Message(notice)</p> }
    @if (expanded)
    {
        <pre lang="en" id="diagnostic-log-preview" class="diagnostic-log" aria-label="@L["Recent diagnostic log"]">@preview</pre>
    }
</section>

@code {
    private bool expanded, working;
    private string preview = "";
    private string? error, notice;
    private void Close()
    {
        expanded = false;
        preview = "";
    }
    private void Show()
    {
        expanded = true;
        var lines = Log.Read().Split('\n', StringSplitOptions.RemoveEmptyEntries);
        preview = lines.Length == 0 ? "No log entries yet." : string.Join('\n', lines.TakeLast(100));
    }
    private async Task Export()
    {
        if (working) return;
        working = true; error = notice = null;
        try {
            Log.Info("Diagnostics export", "User requested a local diagnostic report.");
            await using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(Log.Report()));
            await FileSaver.SaveAsync($"Stik-er-in-log-{DateTime.UtcNow:yyyyMMdd-HHmmss}.txt", stream, "text/plain");
            notice = "Log file prepared. Check your downloads or share sheet.";
        } catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or InvalidOperationException or JSException or OperationCanceledException) {
            var id = Log.Error("Diagnostics export", exception);
            error = $"Could not export the log. Reference: {id}.";
        } finally { working = false; }
    }
}
