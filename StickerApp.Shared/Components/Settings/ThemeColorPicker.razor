@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="theme-custom-picker">
    <div class="theme-color-wheel" @ref="wheel" role="slider" aria-label="@L["Custom theme color wheel. Left/right changes hue; up/down changes saturation."]" aria-valuemin="0" aria-valuemax="359" aria-valuenow="0" tabindex="0"><span class="theme-color-knob"></span></div>
    <div class="theme-color-format" role="group" aria-label="@L["Color input format"]">
        <button class="button" type="button" aria-pressed="@(!hexMode)" @onclick="() => SetFormat(false)">@L["RGBA"]</button>
        <button class="button" type="button" aria-pressed="@hexMode" @onclick="() => SetFormat(true)">@L["HEX"]</button>
    </div>
    @if (hexMode)
    {
        <label class="theme-hex-field">@L["HEX color"]<input type="text" aria-label="@L["Highlight hex color"]" value="@hexDraft" @oninput="e => hexDraft = e.Value?.ToString() ?? string.Empty" @onblur="ApplyHex" @onkeydown="HexKey" maxlength="9" spellcheck="false" autocapitalize="off" autocomplete="off" aria-invalid="@(hexError is not null)" aria-describedby="theme-hex-help" /></label>
        <p id="theme-hex-help" class="helper">@L["Use #RRGGBB or #RRGGBBAA. The last two digits set opacity; six digits keep the current opacity."]</p>
        @if (hexError is not null) { <p class="error" role="alert">@L.Error(hexError)</p> }
    }
    else
    {
    <div class="theme-rgba-fields" role="group" aria-label="@L["Highlight RGBA values"]">
        <label>@L["R"]<input type="number" min="0" max="255" value="@Channel(0)" @oninput="e => ChangeChannel(0, e)" aria-label="@L["Highlight red"]" /></label>
        <label>@L["G"]<input type="number" min="0" max="255" value="@Channel(1)" @oninput="e => ChangeChannel(1, e)" aria-label="@L["Highlight green"]" /></label>
        <label>@L["B"]<input type="number" min="0" max="255" value="@Channel(2)" @oninput="e => ChangeChannel(2, e)" aria-label="@L["Highlight blue"]" /></label>
        <label>@L["A · %"]<input type="number" min="0" max="100" value="@Math.Round(Channel(3) / 2.55)" @oninput="e => ChangeChannel(3, e)" aria-label="@L["Highlight alpha percent"]" /></label>
    </div>
    }
    <p class="helper">Choose a color on the wheel or enter @L[hexMode ? "HEX" : "RGBA"] values. Shades adapt for readable text.</p>
</div>
@code {
    [Parameter] public string Value { get; set; } = "#32875f";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    private ElementReference wheel;
    private IJSObjectReference? module, controller;
    private DotNetObjectReference<ThemeColorPicker>? reference;
    private bool hexMode;
    private string hexDraft = "", previousValue = "";
    private string? hexError;
    protected override void OnParametersSet()
    {
        if (Value == previousValue) return;
        previousValue = hexDraft = Value;
        hexError = null;
    }
    private void SetFormat(bool useHex) { hexMode = useHex; hexDraft = Value; hexError = null; }
    private Task HexKey(KeyboardEventArgs args)=>args.Key=="Enter"?ApplyHex():Task.CompletedTask;
    private async Task ApplyHex()
    {
        var input = hexDraft.Trim();
        if (!input.StartsWith('#')) input = "#" + input;
        if (!System.Text.RegularExpressions.Regex.IsMatch(input, "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"))
        {
            hexError = "Enter 6 hex digits, or 8 including opacity.";
            return;
        }
        if (input.Length == 7) input += Channel(3).ToString("x2");
        hexError = null;
        hexDraft = input.ToLowerInvariant();
        await ValueChanged.InvokeAsync(hexDraft);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender) { module = await JS.InvokeAsync<IJSObjectReference>("import","./_content/StickerApp.Shared/js/ui/theme-color-wheel.js"); reference = DotNetObjectReference.Create(this); controller = await module.InvokeAsync<IJSObjectReference>("create",wheel,reference); }
        if(controller is not null) await controller.InvokeVoidAsync("set",Value);
    }
    private int Channel(int index) => index == 3 && Value.Length == 7 ? 255 : Convert.ToInt32(Value.Substring(1 + index * 2, 2), 16);
    [JSInvokable] public Task WheelColorChanged(string value) => ValueChanged.InvokeAsync(value + Channel(3).ToString("x2"));
    private Task ChangeChannel(int index, ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var number)) return Task.CompletedTask;
        var channels = Enumerable.Range(0, 4).Select(Channel).ToArray();
        channels[index] = index == 3 ? (int)Math.Round(Math.Clamp(number, 0, 100) * 255.0 / 100) : Math.Clamp(number, 0, 255);
        return ValueChanged.InvokeAsync("#" + string.Concat(channels.Select(value => value.ToString("x2"))));
    }
    public async ValueTask DisposeAsync() { try { if(controller is not null) {await controller.InvokeVoidAsync("dispose");await controller.DisposeAsync();} if(module is not null)await module.DisposeAsync();}catch(JSDisconnectedException){} reference?.Dispose(); }
}
