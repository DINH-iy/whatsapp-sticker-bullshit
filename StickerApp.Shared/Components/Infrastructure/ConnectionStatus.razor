@inherits StickerApp.Shared.Components.Infrastructure.InteropComponentBase
@inject StickerApp.Shared.Services.ConnectionState Connection
@inject IServiceProvider Services
@inject IJSRuntime JS
@if(!Connection.Online){<div class="notice offline-notice" role="alert"><strong>@L["No internet connection"]</strong><span>@L["Saved stickers, editing, device imports and file exports still work in the installed app. GIF search, online imports and publishing download links are unavailable until you reconnect."]</span></div>}
@code {
    private StickerApp.Shared.Services.IInternetStatus? native;
    private IJSObjectReference? module, watcher;
    private DotNetObjectReference<ConnectionStatus>? reference;
    protected override async Task OnAfterRenderInteropAsync(bool firstRender){
        if(!firstRender)return;
        native=Services.GetService(typeof(StickerApp.Shared.Services.IInternetStatus)) as StickerApp.Shared.Services.IInternetStatus;
        if(native is not null){native.Changed+=NativeChanged;NativeChanged();}
        else
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/connectivity.js");
            if (IsDisposed) return;
            reference = DotNetObjectReference.Create(this);
            watcher = await module.InvokeAsync<IJSObjectReference>("watch", reference);
        }
    }
    private void NativeChanged()=>_=InvokeAsync(()=>{if(IsDisposed)return;Connection.Update(native!.Online);StateHasChanged();});
    [JSInvokable] public void SetOnline(bool online){if(IsDisposed)return;Connection.Update(online);StateHasChanged();}
    protected override async ValueTask DisposeInteropAsync(){if(native is not null)native.Changed-=NativeChanged;try{if(watcher is not null){await watcher.InvokeVoidAsync("dispose");await watcher.DisposeAsync();}if(module is not null)await module.DisposeAsync();}catch(JSDisconnectedException){}reference?.Dispose();}
}
