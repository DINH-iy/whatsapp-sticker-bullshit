@inherits StickerApp.Shared.Components.Infrastructure.InteropComponentBase
@inject AppLog Log
@inject IJSRuntime JS

@if (errorReference is not null) {
    <div class="notice notice-error" role="alert">
        <p>@L["Something went wrong. Please contact the developer and send your logs from Settings → Diagnostics."] @errorReference</p>
        <a class="button" href="settings#diagnostics">@L["Open diagnostics"]</a>
        <button class="button" type="button" @onclick="() => errorReference = null">@L["Close"]</button>
    </div>
}
@code {
    private string? errorReference;
    private IJSObjectReference? module, subscription, performanceModule, performanceSubscription;
    private DotNetObjectReference<DiagnosticsHost>? reference;
    protected override async Task OnAfterRenderInteropAsync(bool firstRender)
    {
        if (!firstRender) return;
        reference = DotNetObjectReference.Create(this);
        try {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/diagnostics.js");
            if (IsDisposed) return;
            subscription = await module.InvokeAsync<IJSObjectReference>("watch", reference);
            if (IsDisposed) return;
            performanceModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/performance.js");
            if (IsDisposed) return;
            performanceSubscription = await performanceModule.InvokeAsync<IJSObjectReference>("watch", reference, Log.PerformanceEnabled);
            if (IsDisposed) return;
        } catch (JSException exception) { Log.Error("Start JavaScript diagnostics", exception); }
    }
    [JSInvokable] public Task ReportError(string message, string? stack) => InvokeAsync(() => {
        errorReference = Log.Write("Error", "WebView JavaScript", message + "\n" + stack);
        StateHasChanged();
    });
    [JSInvokable] public void ReportTiming(string operation, double milliseconds, string details) => Log.RecordPerformance(operation, milliseconds, details);
    protected override async ValueTask DisposeInteropAsync()
    {
        try {
            if (subscription is not null) { await subscription.InvokeVoidAsync("dispose"); await subscription.DisposeAsync(); }
            if (performanceSubscription is not null) { await performanceSubscription.InvokeVoidAsync("dispose"); await performanceSubscription.DisposeAsync(); }
            if (performanceModule is not null) await performanceModule.DisposeAsync();
            if (module is not null) await module.DisposeAsync();
        } catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
