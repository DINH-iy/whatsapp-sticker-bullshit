@inherits StickerApp.Shared.Components.Infrastructure.InteropComponentBase
@inject IJSRuntime JS
@if (jobs.Length > 0)
{
<details class="processing-menu">
    <summary class="button icon-button" aria-label="@L.Format("App processing · {0} stickers", jobs.Length)" title="@L["App processing"]"><Icon Name="processing" /></summary>
    <div class="processing-menu-content" role="status">
        <strong>@L["App processing"]</strong>
        @foreach (var job in jobs) { <p @key="job.Id">@if (job.Done) { <Icon Name="check" /> } else { <span class="feedback-spinner" aria-hidden="true"></span> } @L[job.Name]
            @if (job.Percent is { } percent) { <span>@(new StickerApp.Shared.Services.StickerPreparationService.Progress(percent, job.Completed, job.Total, job.Attempt, job.Attempts, job.Stage).Detail)</span><progress max="100" value="@(job.Stage == "sampling" ? null : (int?)percent)" aria-label="@L["Processing progress"]"></progress> }
        </p> }
        <p class="helper">@L["Processing stops when you leave the app. Interrupted edits can be retried when you return."]</p>
    </div>
</details>
}
@code {
    public sealed class Job { public string? Stage { get; set; } public bool Done { get; set; } public int Id { get; set; } public string Name { get; set; } = ""; public int? Percent { get; set; } public int Completed { get; set; } public int Total { get; set; } public int Attempt { get; set; } public int Attempts { get; set; } }
    private Job[] jobs = [];
    private IJSObjectReference? module, subscription;
    private DotNetObjectReference<ProcessingMenu>? reference;
    protected override async Task OnAfterRenderInteropAsync(bool firstRender) {
        if (!firstRender) return;
        reference = DotNetObjectReference.Create(this);
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/foreground.js");
        if (IsDisposed) return;
        subscription = await module.InvokeAsync<IJSObjectReference>("watchJobs", reference);
        if (IsDisposed) return;
    }
    [JSInvokable] public Task JobsChanged(Job[] value) => InvokeAsync(() => { if (IsDisposed) return; jobs = value; StateHasChanged(); });
    protected override async ValueTask DisposeInteropAsync() {
        try {
            if (subscription is not null) { await subscription.InvokeVoidAsync("dispose"); await subscription.DisposeAsync(); }
            if (module is not null) await module.DisposeAsync();
        } catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
