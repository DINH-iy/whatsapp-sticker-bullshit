@implements IAsyncDisposable
@inject StickerApp.Shared.Services.StickerPreparationService Preparation
@inject IJSRuntime JS
@inject StickerApp.Shared.Services.ForegroundActivity Activity

@code {
    private IJSObjectReference? module, subscription;
    private DotNetObjectReference<StickerPreparationHost>? reference;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Preparation.Start();
        reference = DotNetObjectReference.Create(this);
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/foreground.js");
        subscription = await module.InvokeAsync<IJSObjectReference>("watch", reference);
    }
    [JSInvokable] public Task SetForeground(bool active) { Activity.SetActive(active); return Preparation.SetForegroundAsync(active); }
    public async ValueTask DisposeAsync()
    {
        try {
            await Preparation.SetForegroundAsync(false);
            if (subscription is not null) { await subscription.InvokeVoidAsync("dispose"); await subscription.DisposeAsync(); }
            if (module is not null) await module.DisposeAsync();
        } catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
