@inherits StickerApp.Shared.Components.Infrastructure.InteropComponentBase
@inject IServiceProvider Services
@inject IJSRuntime JS

@code {
    private StickerApp.Shared.Services.ITapFeedback? feedback;
    private IJSObjectReference? module, subscription;
    private DotNetObjectReference<TapFeedbackHost>? reference;

    protected override async Task OnAfterRenderInteropAsync(bool firstRender)
    {
        if (!firstRender) return;
        feedback = Services.GetService(typeof(StickerApp.Shared.Services.ITapFeedback)) as StickerApp.Shared.Services.ITapFeedback;
        if (feedback is null) return;
        reference = DotNetObjectReference.Create(this);
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/StickerApp.Shared/js/ui/tap-feedback.js");
        if (IsDisposed) return;
        subscription = await module.InvokeAsync<IJSObjectReference>("watch", reference);
        if (IsDisposed) return;
    }

    [JSInvokable] public Task Tap() => feedback?.TapAsync() ?? Task.CompletedTask;

    protected override async ValueTask DisposeInteropAsync()
    {
        try
        {
            if (subscription is not null) { await subscription.InvokeVoidAsync("dispose"); await subscription.DisposeAsync(); }
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
