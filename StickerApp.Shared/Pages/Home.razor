@page "/"
@implements IAsyncDisposable
@inject LibraryStore Store
@inject IWhatsAppExporter Exporter
@inject IJSRuntime JS

<PageTitle>Stickers</PageTitle>

<header class="page-header">
    <h1>Stickers</h1>
    <div class="header-actions">
        <a class="button icon-button" href="gifs" title="Find GIFs" aria-label="Find GIFs">
            <Icon Name="search" />
        </a>
        <label class="button file-button icon-button" title="Import pack">
            <Icon Name="upload" />
            <InputFile OnChange="ImportPack" accept=".zip" disabled="@busy" aria-label="Import pack" />
        </label>
        <label class="button primary file-button icon-button" title="Add images">
            <Icon Name="image" />
            <InputFile OnChange="Import" accept=".jpg,.jpeg,.png,.gif,.webp" multiple disabled="@busy" aria-label="Add images" />
        </label>
    </div>
</header>

@if (notice is not null)
{
    <div class="notice" role="status">
        @notice
        <button class="button icon-button" title="Close message" @onclick="() => notice = null" aria-label="Close message">
            <Icon Name="close" />
        </button>
    </div>
}
@if (busy)
{
    <p role="status">@busyText</p>
}

<div class="toolbar">
    <input class="search" aria-label="Search images" placeholder="Search" @bind="search" @bind:event="oninput" />
    <select aria-label="Pack" value="@activePack" @onchange="SelectPack">
        <option value="">All images</option>
        @foreach (var pack in library.Packs)
        {
            <option value="@pack.Id">@pack.Name</option>
        }
    </select>
    <button class="button icon-button" @onclick="() => showNewPack = !showNewPack" title="New pack" aria-label="New pack">
        <Icon Name="folder-plus" />
    </button>
</div>

@if (showNewPack)
{
    <form class="inline-form" @onsubmit="CreatePack" @onsubmit:preventDefault>
        <input aria-label="New pack name" @bind="newPackName" @bind:event="oninput" maxlength="128" placeholder="Pack name" required />
        <select aria-label="Pack type" @bind="newPackType">
            <option value="animated">Animated</option>
            <option value="static">Static</option>
        </select>
        <button class="button primary" disabled="@busy">Create</button>
        <button type="button" class="button" @onclick="() => showNewPack = false">Cancel</button>
    </form>
}

@if (CurrentPack is not null)
{
    <div class="pack-tools">
        <button class="button icon-button" type="button" @onclick="() => packToShare = CurrentPack"
                title="Share or export pack" aria-label="Share or export pack" disabled="@busy">
            <Icon Name="share" />
        </button>
        <input aria-label="Pack name" @bind="packName" @bind:event="oninput" maxlength="128" />
        <button class="button icon-button" @onclick="RenamePack" disabled="@busy" title="Rename" aria-label="Rename">
            <Icon Name="edit" />
        </button>
        <button class="button icon-button danger" @onclick="() => deletePack = true" title="Delete pack" aria-label="Delete pack">
            <Icon Name="trash" />
        </button>
        <button class="button primary icon-button" title="Add to WhatsApp" aria-label="Add to WhatsApp" @onclick="Export" disabled="@(busy || !Exporter.IsAvailable || Validation.Count > 0)">
            <Icon Name="send" />
        </button>
    </div>
    @if (!Exporter.IsAvailable)
    {
        <p class="helper">WhatsApp export requires the Android or iPhone app.</p>
    }
    @if (Validation.Count > 0)
    {
        <details class="validation">
            <summary>Export requirements</summary>
            <ul>
                @foreach (var validationError in Validation)
                {
                    <li>@validationError</li>
                }
            </ul>
        </details>
    }
}

@if (selected.Count > 0)
{
    <div class="selection-bar">
        <strong>@selected.Count selected</strong>
        <select aria-label="Destination pack" @bind="destination">
            <option value="">Choose pack</option>
            @foreach (var pack in library.Packs)
            {
                <option value="@pack.Id">@pack.Name</option>
            }
        </select>
        <button class="button icon-button" @onclick="CopySelection" disabled="@(busy || destination == "")" title="Copy to pack" aria-label="Copy to pack">
            <Icon Name="copy" />
        </button>
        @if (CurrentPack is not null)
        {
            <button class="button icon-button" @onclick="RemoveSelection" disabled="@busy" title="Remove from pack" aria-label="Remove from pack">
                <Icon Name="remove" />
            </button>
        }
        <button class="button icon-button" title="Clear selection" aria-label="Clear selection" @onclick="() => selected.Clear()">
            <Icon Name="close" />
        </button>
    </div>
}

@if (!Visible.Any())
{
    <p class="empty-state">No images.</p>
}
else
{
    <div class="image-grid">
        @foreach (var image in Visible)
        {
            <article class="image-card" @key="image.Id">
                <input type="checkbox" class="image-select" aria-label="Select @image.Name"
                       checked="@selected.Contains(image.Id)" @onchange="() => Toggle(image.Id)" />
                <button class="image-preview" aria-label="Edit @image.Name" @onclick="() => Edit(image)">
                    <img src="@previews[image.Id]" alt="@image.Name" loading="lazy" />
                </button>
                <strong>@image.Name</strong>
                <small>@image.Width × @image.Height @(image.Animated ? "· Animated" : "")</small>
                <div class="card-actions">
                    <button class="button icon-button" type="button" @onclick="() => imageToAdd = image"
                            disabled="@busy" title="Add to pack" aria-label="Add @image.Name to pack">
                        <Icon Name="folder-plus" />
                    </button>
                    <button class="button icon-button" @onclick="() => Edit(image)" title="Edit image" aria-label="Edit @image.Name">
                        <Icon Name="edit" />
                    </button>
                    <button class="button icon-button danger" @onclick="() => pendingRemoval = image" title="Remove image" aria-label="Remove @image.Name">
                        <Icon Name="trash" />
                    </button>
                    @if (CurrentPack is not null)
                    {
                        <button class="button icon-button" title="Move earlier" aria-label="Move @image.Name earlier" @onclick="() => Reorder(image.Id, -1)">
                            <Icon Name="left" />
                        </button>
                        <button class="button icon-button" title="Move later" aria-label="Move @image.Name later" @onclick="() => Reorder(image.Id, 1)">
                            <Icon Name="right" />
                        </button>
                    }
                </div>
            </article>
        }
    </div>
}

@if (editing is not null)
{
    <div class="modal-backdrop">
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="edit-title">
            <h2 id="edit-title">Edit image</h2>
            <img class="edit-preview" src="@editPreview" alt="@editing.Name" />
            <label>
                Name
                <input @bind="editName" @bind:event="oninput" maxlength="128" />
            </label>
            <div class="edit-tools">
                @if (!editing.Animated && !replacementAnimated)
                {
                    <button class="button icon-button" @onclick="Rotate" disabled="@busy" title="Rotate" aria-label="Rotate">
                        <Icon Name="rotate" />
                    </button>
                    <button class="button icon-button" @onclick="Crop" disabled="@busy" title="Crop square" aria-label="Crop square">
                        <Icon Name="crop" />
                    </button>
                    <button class="button icon-button" @onclick="ResetImage" disabled="@busy" title="Reset" aria-label="Reset">
                        <Icon Name="reset" />
                    </button>
                }
                <label class="button file-button icon-button" title="Replace image">
                    <Icon Name="image" />
                    <InputFile OnChange="Replace" accept=".jpg,.jpeg,.png,.gif,.webp" disabled="@busy" aria-label="Replace image" />
                </label>
            </div>

            @if (IsGif && gifDuration > 0)
            {
                <div class="gif-trim">
                    <div class="trim-timeline">
                        <div class="timeline-frames" aria-hidden="true">
                            @foreach (var frame in gifThumbnails)
                            {
                                <img src="@frame" alt="" />
                            }
                        </div>
                        <div class="timeline-mask left" style="width:@TrimLeft%"></div>
                        <div class="timeline-mask right" style="width:@TrimRight%"></div>
                        <div class="timeline-selection" style="left:@TrimLeft%;right:@TrimRight%"></div>
                        <input class="trim-handle start" type="range" aria-label="Trim start" min="0" max="@GifMax" step="0.01"
                               @bind="trimStart" @bind:event="oninput" @bind:after="TrimStartChanged"
                               @onchange="PreviewTrim" disabled="@busy" />
                        <input class="trim-handle end" type="range" aria-label="Trim end" min="0" max="@GifMax" step="0.01"
                               @bind="trimEnd" @bind:event="oninput" @bind:after="TrimEndChanged"
                               @onchange="PreviewTrim" disabled="@busy" />
                    </div>
                    <div class="edit-tools">
                        <button class="button icon-button" @onclick="ResetTrim" disabled="@busy" title="Reset trim" aria-label="Reset trim">
                            <Icon Name="reset" />
                        </button>
                        <span class="helper">@Math.Max(0, trimEnd - trimStart).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) s</span>
                    </div>
                </div>
            }
            else if (!IsGif && (editing.Animated || replacementAnimated))
            {
                <p class="helper">Trimming is available for GIF files.</p>
            }

            @if (editError is not null)
            {
                <p class="error" role="alert">@editError</p>
            }
            <div class="dialog-actions">
                <button class="button" @onclick="() => editing = null" disabled="@busy">Cancel</button>
                <button class="button primary" @onclick="Save" disabled="@busy">Save</button>
            </div>
        </section>
    </div>
}

@if (pendingRemoval is not null || deletePack)
{
    <div class="modal-backdrop">
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="remove-title">
            <h2 id="remove-title">@(deletePack ? "Delete pack?" : "Remove image?")</h2>
            <p>@(deletePack ? "Images remain in the library." : pendingRemoval!.Name)</p>
            <div class="dialog-actions">
                <button class="button" @onclick="CancelRemoval">Cancel</button>
                <button class="button danger" @onclick="ConfirmRemoval" disabled="@busy"><Icon Name="trash" /> Remove</button>
            </div>
        </section>
    </div>
}

@if (imageToAdd is not null)
{
    <AddToPackDialog Image="@imageToAdd" OnAdded="FinishQuickAdd" OnCancel="() => imageToAdd = null" />
}

@if (packToShare is not null)
{
    <SharePackDialog Pack="@packToShare" OnClose="() => packToShare = null" />
}
