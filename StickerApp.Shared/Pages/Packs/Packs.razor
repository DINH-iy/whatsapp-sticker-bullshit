@inject AppLog Log
@page "/"
@inject LibraryStore Store
@inject NavigationManager Navigation

<PageTitle>@L["My Packs · Stik-er-in"]</PageTitle>
<header class="page-header">
    <h1>@L["My Packs"]</h1>
    <div class="header-actions">
        <label class="button file-button" title="@L["Open a .wastickers pack or an editable ZIP backup"]">
            <Icon Name="folder-import" /> @L["Import pack"]
            <InputFile OnChange="ImportPack" accept=".zip,.wastickers" disabled="@busy" aria-label="@L["Import pack file"]" />
        </label>
    </div>
</header>
@if (error is not null)
{
    <p class="error" role="alert">@L.Error(error)</p>
}
@if (showCreate)
{
    <NewPackDialog OnCreated="PackCreated" OnCancel="() => showCreate = false" />
}
@if (editingPack is not null)
{
    <NewPackDialog Pack="@editingPack" OnSaved="PackDetailsSaved" OnCancel="() => editingPack = null" />
}
@{ var visiblePacks = VisiblePacks; }
<div class="toolbar browse-toolbar">
    <label class="browse-search">@L["Search"]<input type="search" class="search" aria-label="@L["Search packs"]" placeholder="@L["Search packs or publishers"]" @bind="search" @bind:event="oninput" /></label>
    <div class="browse-actions">
        <button class="button @(sort != "default" ? "browse-action-active" : "")" type="button" aria-label="@L["Sort packs"]" aria-haspopup="dialog" @onclick='() => browsePanel = "sort"'>@L["Sort"]</button>
        <button class="button @(FilterCount > 0 ? "browse-action-active" : "")" type="button" aria-label="@L["Filter packs"]" aria-haspopup="dialog" @onclick='() => browsePanel = "filters"'>Filters @if (FilterCount > 0) { <small class="filter-count">@FilterCount</small> }</button>
    </div>
</div>
@if (browsePanel is not null)
{
<BrowseOptionsPopup Title="@L[browsePanel == "sort" ? "Sort packs" : "Filter packs"]" OnClose="() => browsePanel = null">
    @if (browsePanel == "sort")
    {
    <label>@L["Sort by"]<select aria-label="@L["Sort packs"]" @bind="sort">
        <option value="default">@L["Oldest added"]</option><option value="newest">@L["Recently added"]</option>
        <option value="name-asc">@L["Name: A–Z"]</option><option value="name-desc">@L["Name: Z–A"]</option><option value="publisher">@L["Publisher: A–Z"]</option>
        <option value="group-first">@L["Group packs first"]</option><option value="solo-first">@L["Solo packs first"]</option>
        <option value="count-desc">@L["Most stickers"]</option><option value="count-asc">@L["Fewest stickers"]</option>
        <option value="file-desc">@L["Image files: largest first"]</option><option value="file-asc">@L["Image files: smallest first"]</option>
        <option value="storage-desc">@L["Stored size: largest first"]</option><option value="storage-asc">@L["Stored size: smallest first"]</option>
    </select></label>
    }
    else
    {
    <div class="browse-filter-fields">
        <label>@L["Ownership"]<select aria-label="@L["Filter group or solo packs"]" @bind="ownershipFilter"><option value="all">@L["All packs"]</option><option value="group">@L["Group packs"]</option><option value="solo">@L["Solo packs"]</option></select></label>
        <label>@L["Type"]<select aria-label="@L["Filter pack type"]" @bind="typeFilter"><option value="all">@L["All types"]</option><option value="still">@L["Still images only"]</option><option value="animated">@L["GIFs / animations only"]</option><option value="mixed">@L["Mixed still & animated"]</option><option value="empty">@L["Empty packs"]</option></select></label>
        <label>@L["Sticker count"]<select aria-label="@L["Filter pack count"]" @bind="countFilter"><option value="all">@L["Any count"]</option><option value="empty">@L["Empty"]</option><option value="few">@L["1–2 stickers"]</option><option value="ready">@L["3–30 stickers"]</option><option value="full">@L["Full (30 stickers)"]</option></select></label>
        <label>@L["Total stored size"]<select aria-label="@L["Filter pack storage"]" @bind="storageFilter"><option value="all">@L["Any size"]</option><option value="small">Under 1 @SizeUnit</option><option value="medium">1–5 @SizeUnit</option><option value="large">5–20 @SizeUnit</option><option value="huge">20 @SizeUnit or more</option></select></label>
    </div>
    <p class="helper">@L["Stored size includes images, retained originals, and editable layers. An image shared by several packs appears in each pack's size; the library total counts it once."]</p>
    <button class="button" type="button" @onclick="ResetFilters">@L["Reset filters"]</button>
    }
</BrowseOptionsPopup>
}
<p class="helper browse-result" role="status">@L.Format("Showing {0} of {1} packs", visiblePacks.Count, library.Packs.Count)</p>
@if (visiblePacks.Count > 0 || library.Packs.Count == 0)
{
<div class="image-grid pack-grid">
    <AddTile Title="@L["New pack"]" Hint="@L["Start a sticker collection"]" Disabled="@(busy || library.Packs.Count >= 10)" OnClick="() => showCreate = true" />
    @foreach (var pack in visiblePacks)
    {
        <article class="image-card pack-card" @key="pack.Id">
            <SpoilerPreview IsSpoiler="@library.IsNsfw(pack)" Name="@pack.Name">
            <a class="pack-card-link" href="@($"packs/{pack.Id}")" aria-label="@L[$"Open {pack.Name}"]">
                <div class="pack-cover">
                    @if (covers.TryGetValue(pack.Id, out var cover))
                    {
                        <img class="spoiler-artwork" src="@cover" alt="" loading="lazy" />
                    }
                    else
                    {
                        <Icon Name="image" />
                    }
                    @if(pack.Collection is not null){<span class="pack-group-badge" role="img" aria-label="@L["Group pack"]" title="@L["Group pack"]"><Icon Name="users" /></span>}
                </div>
            </a>
            </SpoilerPreview>
            <a class="pack-card-link" href="@($"packs/{pack.Id}")">
                <strong>@pack.Name @if(pack.Nsfw){<span class="nsfw-name-tag">@L["[NSFW]"]</span>}</strong>
                <small class="pack-card-publisher" title="@pack.Publisher">@L.Format("By {0}", pack.Publisher)</small>
                <small>@pack.StickerIds.Count @L[pack.StickerIds.Count == 1 ? "sticker" : "stickers"] · @L[PackTypeLabel(pack)]</small>
                <small class="image-file-summary">@L.Format("{0} stored", PackSize(pack)) · @L[pack.Public ? "Public" : "Private"]</small>
            </a>
            <div class="pack-card-actions">
                <button class="button icon-button" type="button" disabled="@busy" @onclick="() => editingPack = pack" title="@L["Edit pack details"]" aria-label="Edit details for @pack.Name"><Icon Name="edit" /><span>@L["Edit details"]</span></button>
            </div>
        </article>
    }
</div>
}
@if (visiblePacks.Count == 0 && library.Packs.Count > 0)
{
    <div class="browse-empty" role="status">
        <div><strong>@L["No packs match your search or filters."]</strong><p class="helper">@L["Try another type or size, or clear the filters."]</p></div>
        <div class="settings-actions">
            <button class="button" type="button" @onclick="ResetFilters">@L["Clear filters"]</button>
            <button class="button" type="button" disabled="@(busy || library.Packs.Count >= 10)" @onclick="() => showCreate = true">@L["New pack"]</button>
        </div>
    </div>
}
@if (library.Packs.Count >= 10)
{
    <p class="helper">@L["This build supports up to 10 packs."]</p>
}
