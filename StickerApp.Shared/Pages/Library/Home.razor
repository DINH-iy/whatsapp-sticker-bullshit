@inject AppLog Log
@page "/library"
@page "/packs/{PackId:guid}"
@implements IAsyncDisposable
@inject LibraryStore Store
@inject IWhatsAppExporter Exporter
@inject StickerApp.Shared.Services.IBulkImageImporter BulkImporter
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject StickerApp.Shared.Services.StickerPreparationService Preparation

<PageTitle>@(CurrentPack?.Name ?? "Packs") · Stick it</PageTitle>

<header class="page-header">
    <div class="page-title">
        @if (PackHeaderCover is { } cover)
        {
            <img class="pack-title-cover" src="@cover" alt="Pack cover" />
        }
        else if (CurrentPack is not null)
        {
            <span class="pack-title-cover pack-title-placeholder"><Icon Name="image" /></span>
        }
        <h1>@(CurrentPack?.Name ?? "All images")</h1>
    </div>
    <div class="header-actions sticker-toolbar">
        <ActionMenu Label="Add stickers" IconName="plus" Primary="true" Disabled="@busy">
            <p class="toolbar-menu-heading">@(CurrentPack is null ? "Add to your library" : $"Add to {CurrentPack.Name}")</p>
            <label class="toolbar-menu-option file-button">
                <Icon Name="image-plus" />
                <span>Images or GIFs from device<small>Choose saved files to add here.</small></span>
                <InputFile OnChange="Import" accept="image/*" multiple disabled="@(busy || CurrentPack?.StickerIds.Count >= 30)" aria-label="Choose images or GIFs from device" />
            </label>
            <button class="toolbar-menu-option" type="button" @onclick="NewComposition" disabled="@(busy || CurrentPack?.StickerIds.Count >= 30)">
                <Icon Name="edit" /><span>Create with layers<small>Combine images into a custom sticker.</small></span>
            </button>
            <button class="toolbar-menu-option" type="button" @onclick="() => showGifSearch = true" disabled="@busy">
                <Icon Name="search" /><span>Find a GIF<small>Search and preview GIFs in a popup.</small></span>
            </button>
            <a class="toolbar-menu-option" href="@(CurrentPack is { } pinterestPack ? $"pinterest?pack={pinterestPack.Id}" : "pinterest")">
                <Icon Name="link" /><span>Import a Pinterest selection<small>Paste a shared link and choose its images.</small></span>
            </a>
            @if (BulkImporter.IsAvailable)
            {
                <button class="toolbar-menu-option" type="button" @onclick="ImportFolder" disabled="@busy">
                    <Icon Name="folder-import" /><span>@BulkImporter.ActionLabel<small>Add supported images from a device folder.</small></span>
                </button>
            }
            <div class="toolbar-menu-divider"></div>
            <label class="toolbar-menu-option file-button">
                <Icon Name="folder-import" /><span>Import a pack file<small>Open a .wastickers or ZIP file as a new pack.</small></span>
                <InputFile OnChange="ImportPack" accept=".zip,.wastickers" disabled="@busy" aria-label="Import pack file" />
            </label>
        </ActionMenu>
        @if (CurrentPack is not null)
        {
            <ActionMenu Label="Pack options" Disabled="@busy">
                <button class="toolbar-menu-option" type="button" @onclick="BeginRenamePack" disabled="@busy">
                    <Icon Name="edit" /><span>Rename pack<small>Change the name of this collection.</small></span>
                </button>
                <PackCoverPicker Pack="@CurrentPack" OnChanged="Reload" MenuStyle="true" />
                <button class="toolbar-menu-option" type="button" @onclick="() => packToShare = CurrentPack" disabled="@busy">
                    <Icon Name="share" /><span>Share or export<small>Save a pack file or create a sharing link.</small></span>
                </button>
                <div class="toolbar-menu-divider"></div>
                <button class="toolbar-menu-option danger" type="button" @onclick="() => deletePack = true" disabled="@busy">
                    <Icon Name="trash" /><span>Delete pack<small>Images stay in your library.</small></span>
                </button>
            </ActionMenu>
        }
    </div>
</header>

@if (notice is not null)
{
    <div class="notice @(noticeIsError ? "notice-error" : "notice-success")" role="@(noticeIsError ? "alert" : "status")">
        <Icon Name="@(noticeIsError ? "alert" : "check")" />
        <span class="notice-message">
        @notice
        </span>
        <button class="button icon-button" title="Close message" @onclick="() => notice = null" aria-label="Close message">
            <Icon Name="close" />
        </button>
    </div>
}
@if (busy)
{
    <p class="status-info" role="status">@busyText</p>
}

<div class="toolbar">
    <input class="search" aria-label="Search images" placeholder="Search" @bind="search" @bind:event="oninput" />
</div>
@if (PendingPreparationCount > 0)
{
    <p class="helper" role="status">Preparing @PendingPreparationCount stickers automatically… You can keep using the app.</p>
}
@if (AttentionCount > 0)
{
    <p class="helper">@AttentionCount stickers need attention. Open their ⓘ details to see what needs adjusting.</p>
}

@if (CurrentPack is not null)
{
    @if (Exporter.IsAvailable)
    {
        <button class="button primary floating-whatsapp" title="Add this pack to WhatsApp" @onclick="Export" disabled="@(busy || Validation.Count > 0)">
            <Icon Name="whatsapp" /> Add to WhatsApp
        </button>
    }
    else
    {
        <button class="button primary floating-whatsapp" title="Export a sticker pack file. Direct WhatsApp handoff needs a native app." @onclick="() => packToShare = CurrentPack" disabled="@busy">
            <Icon Name="download" /> Export pack
        </button>
    }
    @if (Issues.Any(issue => issue.StickerId is null))
    {
        <details class="validation" open>
            <summary>Fix before adding to WhatsApp</summary>
            <ul>
                @foreach (var issue in Issues.Where(issue => issue.StickerId is null))
                {
                    <li>
                        @issue.Message
                    </li>
                }
            </ul>
            <a href="settings#faq">View requirements &amp; FAQ</a>
        </details>
    }
}

@if (selected.Count > 0)
{
    <div class="selection-bar">
        <strong>@selected.Count selected</strong>
        <select aria-label="Destination pack" @bind="destination">
            <option value="">Choose pack</option>
            @foreach (var pack in library.Packs)
            {
                <option value="@pack.Id">@pack.Name</option>
            }
        </select>
        <button class="button icon-button" @onclick="CopySelection" disabled="@(busy || destination == "")" title="Copy to pack" aria-label="Copy to pack">
            <Icon Name="copy" />
        </button>
        @if (CurrentPack is not null)
        {
            <button class="button icon-button" @onclick="RemoveSelection" disabled="@busy" title="Remove from pack" aria-label="Remove from pack">
                <Icon Name="remove" />
            </button>
        }
        <button class="button icon-button" title="Clear selection" aria-label="Clear selection" @onclick="() => selected.Clear()">
            <Icon Name="close" />
        </button>
    </div>
}

@if (!Visible.Any() && CurrentPack is null)
{
    <p class="empty-state">No images.</p>
}
else
{
    <div class="image-grid @(CurrentPack is not null ? "pack-stickers" : "")">
        @if (CurrentPack is { } currentPack)
        {
            <AddTile Title="Add sticker" Hint="@(currentPack.StickerIds.Count >= 30 ? "Pack full · 30/30 stickers" : "Choose images or GIFs")">
                <InputFile OnChange="Import" accept="image/*" multiple
                           disabled="@(busy || currentPack.StickerIds.Count >= 30)" aria-label="@($"Add stickers to {currentPack.Name}")" />
            </AddTile>
        }
        @foreach (var image in Visible)
        {
            <article class="image-card" @key="image.Id">
                <input type="checkbox" class="image-select" aria-label="Select @image.Name"
                       checked="@selected.Contains(image.Id)" @onchange="() => Toggle(image.Id)" />
                <button class="image-preview" aria-label="Edit @image.Name" @onclick="() => Edit(image)">
                    <img src="@previews[image.Id]" alt="@image.Name" loading="lazy" />
                </button>
                <strong>@image.Name</strong>
                @if (StickerApp.Shared.Services.StickerPreparationService.NeedsPreparation(image))
                {
                    <small class="sticker-preparation-status">@(Preparation.GetStatus(image)?.Error is not null ? "Needs attention · see ⓘ" : "Preparing…")</small>
                }
                <div class="card-actions">
                    <div class="sticker-actions">
                        <button class="button icon-button" type="button" @onclick="() => infoImageId = image.Id" title="Sticker details" aria-label="Details for @image.Name"><Icon Name="info" /></button>
                        <button class="button icon-button" type="button" @onclick="() => imageToAdd = image"
                                disabled="@busy" title="Add to pack" aria-label="Add @image.Name to pack">
                            <Icon Name="folder-plus" />
                        </button>
                        <button class="button icon-button" @onclick="() => Edit(image)" title="Edit image" aria-label="Edit @image.Name">
                            <Icon Name="edit" />
                        </button>
                        <button class="button icon-button danger" @onclick="() => pendingRemoval = image" title="Remove image" aria-label="Remove @image.Name">
                            <Icon Name="trash" />
                        </button>
                    </div>
                </div>
            </article>
        }
    </div>
}

@if (InfoImage is { } infoImage)
{
    <StickerInfoDialog Image="infoImage" OnClose="() => infoImageId = null" OnEdit="EditFromInfo" />
}

@if (showLayerEditor)
{
    <LayerEditorDialog StickerId="@compositionStickerId" PackId="@activePack" Images="@library.Stickers" Previews="@previews"
                       OnCancel="() => showLayerEditor = false" OnSaved="CompositionSaved" />
}

@if (editing is not null)
{
    <dialog @ref="editDialog" class="folder-dialog image-edit-dialog" aria-labelledby="edit-title" aria-busy="@(busy ? "true" : "false")" @onkeydown="EditorKeyDown">
            <h2 id="edit-title">@(IsGif ? "Edit GIF" : editing.Animated || replacementAnimated ? "Edit animated image" : "Edit image")</h2>
            @if (editorLoading)
            {
                <div class="editor-loading" role="status" aria-live="polite">
                    <span class="feedback-spinner" aria-hidden="true"></span>
                    <strong>@busyText</strong>
                    <span class="helper">Getting the preview and editing tools ready.</span>
                </div>
            }
            else if (EditingStill)
            {
                <ImageCustomizer Source="@editSource" OnChanged="CustomizeImage" OnBusyChanged="value => customizing = value" />
            }
            else
            {
                <img class="edit-preview" src="@editPreview" alt="@editing.Name" />
            }
            <label>
                Name
                <input @bind="editName" @bind:event="oninput" maxlength="128" disabled="@busy" />
            </label>
            <div class="edit-tools">
                <label class="button file-button icon-button" title="Replace image">
                    <Icon Name="image" />
                    <InputFile OnChange="Replace" accept="image/*" disabled="@busy" aria-label="Replace image" />
                </label>
            </div>

            @if (!editorLoading && IsGif && gifDuration > 0)
            {
                <div class="gif-trim">
                    <div class="trim-timeline">
                        <div class="timeline-frames" aria-hidden="true">
                            @foreach (var frame in gifThumbnails)
                            {
                                <img src="@frame" alt="" />
                            }
                        </div>
                        <div class="timeline-mask left" style="width:@TrimLeft%"></div>
                        <div class="timeline-mask right" style="width:@TrimRight%"></div>
                        <div class="timeline-selection" style="left:@TrimLeft%;right:@TrimRight%"></div>
                        <input class="trim-handle start" type="range" aria-label="Trim start" min="0" max="@GifMax" step="0.01"
                               @bind="trimStart" @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:event="oninput" @bind:after="TrimStartChanged"
                               @onchange="PreviewTrim" disabled="@busy" />
                        <input class="trim-handle end" type="range" aria-label="Trim end" min="0" max="@GifMax" step="0.01"
                               @bind="trimEnd" @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:event="oninput" @bind:after="TrimEndChanged"
                               @onchange="PreviewTrim" disabled="@busy" />
                    </div>
                    <div class="trim-fields">
                        <label>Start (seconds)
                            <input type="number" min="0" max="@GifMax" step="0.01" @bind="trimStart"
                                   @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:event="oninput" @bind:after="TrimStartChanged" disabled="@busy" />
                        </label>
                        <label>End (seconds)
                            <input type="number" min="0" max="@GifMax" step="0.01" @bind="trimEnd"
                                   @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:event="oninput" @bind:after="TrimEndChanged" disabled="@busy" />
                        </label>
                    </div>
                    <div class="edit-tools">
                        <button class="button" @onclick="PreviewTrim" disabled="@(busy || !HasTrim)">Preview trim</button>
                        <button class="button icon-button" @onclick="ResetTrim" disabled="@busy" title="Reset trim" aria-label="Reset trim">
                            <Icon Name="reset" />
                        </button>
                        <span class="helper">@Math.Max(0, trimEnd - trimStart).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) s</span>
                    </div>
                </div>
            }
            else if (!editorLoading && !IsGif && (editing.Animated || replacementAnimated))
            {
                <p class="helper">Trimming is available for GIF files.</p>
            }

            @if (editError is not null)
            {
                <p class="error" role="alert">@editError</p>
            }
            <div class="dialog-actions">
                <button class="button" @onclick="() => editing = null" disabled="@busy">Cancel</button>
                <button class="button primary" @onclick="Save" disabled="@(busy || customizing)">Save</button>
            </div>
    </dialog>
}

@if (pendingRemoval is not null || deletePack)
{
    <div class="modal-backdrop">
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="remove-title">
            <h2 id="remove-title">@(deletePack ? "Delete pack?" : "Remove image?")</h2>
            <p>@(deletePack ? "Images remain in the library." : pendingRemoval!.Name)</p>
            <div class="dialog-actions">
                <button class="button" @onclick="CancelRemoval">Cancel</button>
                <button class="button danger" @onclick="ConfirmRemoval" disabled="@busy"><Icon Name="trash" /> Remove</button>
            </div>
        </section>
    </div>
}

@if (imageToAdd is not null)
{
    <AddToPackDialog Image="@imageToAdd" OnAdded="FinishQuickAdd" OnCancel="() => imageToAdd = null" />
}

@if (packToShare is not null)
{
    <SharePackDialog Pack="@packToShare" PreparationPending="@PackImages.Any(StickerApp.Shared.Services.StickerPreparationService.NeedsPreparation)" OnClose="() => packToShare = null" />
}

@if (showGifSearch)
{
    <GifSearchDialog OnClose="() => showGifSearch = false" />
}
@if (renamingPack)
{
    <div class="modal-backdrop">
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="rename-pack-title">
            <h2 id="rename-pack-title">Rename pack</h2>
            <form @onsubmit="RenamePack" @onsubmit:preventDefault>
                <label for="rename-pack-name">Pack name</label>
                <input id="rename-pack-name" class="folder-input" @bind="packName" @bind:event="oninput" maxlength="128" required autofocus disabled="@busy" />
                <div class="dialog-actions">
                    <button class="button" type="button" @onclick="() => renamingPack = false" disabled="@busy">Cancel</button>
                    <button class="button primary" type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(packName))">Save name</button>
                </div>
            </form>
        </section>
    </div>
}
