@inject AppLog Log
@page "/library"
@page "/packs/{PackId:guid}"
@implements IAsyncDisposable
@inject LibraryStore Store
@inject IWhatsAppExporter Exporter
@inject StickerApp.Shared.Services.IBulkImageImporter BulkImporter
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject StickerApp.Shared.Services.StickerPreparationService Preparation

<PageTitle>@(CurrentPack?.Name ?? "Packs") · Stik-er-in</PageTitle>

<header class="page-header">
    <div class="page-title">
        @if (PackHeaderCover is { } cover)
        {
            <img class="pack-title-cover" src="@cover" alt="Pack cover" />
        }
        else if (CurrentPack is not null)
        {
            <span class="pack-title-cover pack-title-placeholder"><Icon Name="image" /></span>
        }
        <div class="pack-heading-text">
            <h1>@(CurrentPack?.Name ?? "All images")</h1>
            @if (CurrentPack is { } headingPack) { <p class="helper pack-publisher">By @headingPack.Publisher</p> }
        </div>
    </div>
    <div class="header-actions sticker-toolbar">
        <ActionMenu Label="Add stickers" IconName="plus" Primary="true" Disabled="@busy">
            <p class="toolbar-menu-heading">@(CurrentPack is null ? "Add to your library" : $"Add to {CurrentPack.Name}")</p>
            <AddStickerChoices @key="importPickerVersion" Disabled="@(busy || CurrentPack?.StickerIds.Count >= 30)" OnImport="Import" OnLayers="NewComposition" />
            <button class="toolbar-menu-option" type="button" @onclick="() => showGifSearch = true" disabled="@busy">
                <Icon Name="search" /><span>Find a GIF<small>Search and preview GIFs in a popup.</small></span>
            </button>
            <a class="toolbar-menu-option" href="@(CurrentPack is { } pinterestPack ? $"pinterest?pack={pinterestPack.Id}" : "pinterest")">
                <Icon Name="link" /><span>Import a Pinterest selection<small>Paste a shared link and choose its images.</small></span>
            </a>
            @if (BulkImporter.IsAvailable)
            {
                <button class="toolbar-menu-option" type="button" @onclick="ImportFolder" disabled="@busy">
                    <Icon Name="folder-import" /><span>@BulkImporter.ActionLabel<small>Add supported images from a device folder.</small></span>
                </button>
            }
            <div class="toolbar-menu-divider"></div>
            <label class="toolbar-menu-option file-button">
                <Icon Name="folder-import" /><span>Import a pack file<small>Open a .wastickers or ZIP file as a new pack.</small></span>
                <InputFile OnChange="ImportPack" accept=".zip,.wastickers" disabled="@busy" aria-label="Import pack file" />
            </label>
        </ActionMenu>
        @if (CurrentPack is not null)
        {
            <ActionMenu Label="Pack options" Disabled="@busy">
                <button class="toolbar-menu-option" type="button" @onclick="BeginRenamePack" disabled="@busy">
                    <Icon Name="edit" /><span>Edit pack details<small>Change this pack's name and publisher.</small></span>
                </button>
                <PackCoverPicker Pack="@CurrentPack" OnChanged="Reload" MenuStyle="true" />
                <button class="toolbar-menu-option" type="button" @onclick="() => packToShare = CurrentPack" disabled="@busy">
                    <Icon Name="share" /><span>Share or export<small>Save a pack file or create a sharing link.</small></span>
                </button>
                <div class="toolbar-menu-divider"></div>
                <button class="toolbar-menu-option danger" type="button" @onclick="() => deletePack = true" disabled="@busy">
                    <Icon Name="trash" /><span>Delete pack<small>Images stay in your library.</small></span>
                </button>
            </ActionMenu>
        }
    </div>
</header>

@if (notice is not null)
{
    <div class="notice @(noticeIsError ? "notice-error" : "notice-success")" role="@(noticeIsError ? "alert" : "status")">
        <Icon Name="@(noticeIsError ? "alert" : "check")" />
        <span class="notice-message">
        @notice
        </span>
        <button class="button icon-button" title="Close message" @onclick="() => notice = null" aria-label="Close message">
            <Icon Name="close" />
        </button>
    </div>
}
@if (busy)
{
    <p class="status-info" role="status">@busyText</p>
}

@{ var visibleImages = Visible; }
<div class="toolbar browse-toolbar">
    <label class="browse-search">Search<input type="search" class="search" aria-label="Search images" placeholder="Search images or tags" @bind="search" @bind:event="oninput" /></label>
    <div class="browse-actions">
        <button class="button @(sort != "default" ? "browse-action-active" : "")" type="button" aria-label="Sort images" aria-haspopup="dialog" @onclick='() => browsePanel = "sort"'>Sort</button>
        <button class="button @(FilterCount > 0 ? "browse-action-active" : "")" type="button" aria-label="Filter images" aria-haspopup="dialog" @onclick='() => browsePanel = "filters"'>Filters @if (FilterCount > 0) { <small class="filter-count">@FilterCount</small> }</button>
    </div>
</div>
@if (browsePanel is not null)
{
<BrowseOptionsPopup Title="@(browsePanel == "sort" ? "Sort images" : "Filter images")" OnClose="() => browsePanel = null">
    @if (browsePanel == "sort")
    {
    <label>Sort by<select aria-label="Sort images" @bind="sort">
        <option value="default">@(CurrentPack is null ? "Recently added" : "Saved pack order")</option>
        @if (CurrentPack is null) { <option value="oldest">Oldest added</option> }
        <option value="name-asc">Name: A–Z</option><option value="name-desc">Name: Z–A</option>
        <option value="type">Type</option>
        <option value="file-desc">File size: largest first</option><option value="file-asc">File size: smallest first</option>
        <option value="storage-desc">Stored size: largest first</option><option value="storage-asc">Stored size: smallest first</option>
    </select></label>
    }
    else
    {
    <div class="browse-filter-fields">
        <label>Type<select aria-label="Filter image type" @bind="typeFilter"><option value="all">All types</option><option value="still">Still images</option><option value="animated">GIFs / animations</option><option value="layered">Editable layers</option></select></label>
        <label>Saved format<select aria-label="Filter image format" @bind="formatFilter"><option value="all">All formats</option><option value="webp">WebP</option><option value="png">PNG</option><option value="jpeg">JPEG</option><option value="gif">GIF</option></select></label>
        <label>Total stored size<select aria-label="Filter image storage" @bind="storageFilter"><option value="all">Any size</option><option value="small">Under 100 @SmallSizeUnit</option><option value="medium">100–500 @SmallSizeUnit</option><option value="large">500 @SmallSizeUnit or more</option></select></label>
    </div>
    <p class="helper">File size is the current image; stored size includes originals and layers. Prepared GIFs use WebP but remain under GIFs / animations.</p>
    <button class="button" type="button" @onclick="ResetFilters">Reset filters</button>
    }
</BrowseOptionsPopup>
}
<p class="helper browse-result" role="status">Showing @visibleImages.Count of @(CurrentPack is null ? library.Stickers.Count : PackImages.Count) images.@if (CurrentPack is not null) { <span> Sorting changes this view only; saved sticker order stays the same.</span> }</p>
@if (PendingPreparationCount > 0)
{
    <p class="helper" role="status">Preparing @PendingPreparationCount stickers automatically… You can keep using the app.</p>
}
@if (AttentionCount > 0)
{
    <p class="helper">@AttentionCount stickers need attention. Open their ⓘ details to see what needs adjusting.</p>
}

@if (CurrentPack is not null)
{
    @if (Exporter.IsAvailable)
    {
        <button class="button primary floating-whatsapp" title="Add this pack to WhatsApp" @onclick="Export" disabled="@(busy || Validation.Count > 0)">
            <Icon Name="whatsapp" /> Add to WhatsApp
        </button>
    }
    else
    {
        <button class="button primary floating-whatsapp" title="Export a sticker pack file. Direct WhatsApp handoff needs a native app." @onclick="() => packToShare = CurrentPack" disabled="@busy">
            <Icon Name="download" /> Export pack
        </button>
    }
    @if (Issues.Any(issue => issue.StickerId is null))
    {
        <details class="validation" open>
            <summary>Fix before adding to WhatsApp</summary>
            <ul>
                @foreach (var issue in Issues.Where(issue => issue.StickerId is null))
                {
                    <li>
                        @issue.Message
                    </li>
                }
            </ul>
            <a href="settings#faq">View requirements &amp; FAQ</a>
        </details>
    }
}

@if (selected.Count > 0)
{
    <div class="selection-bar">
        <strong>@selected.Count selected</strong>
        <select aria-label="Destination pack" @bind="destination">
            <option value="">Choose pack</option>
            @foreach (var pack in library.Packs)
            {
                <option value="@pack.Id">@pack.Name</option>
            }
        </select>
        <button class="button icon-button" @onclick="CopySelection" disabled="@(busy || destination == "")" title="Copy to pack" aria-label="Copy to pack">
            <Icon Name="copy" />
        </button>
        @if (CurrentPack is not null)
        {
            <button class="button icon-button" @onclick="RemoveSelection" disabled="@busy" title="Remove from pack" aria-label="Remove from pack">
                <Icon Name="remove" />
            </button>
        }
        <button class="button icon-button" title="Clear selection" aria-label="Clear selection" @onclick="() => selected.Clear()">
            <Icon Name="close" />
        </button>
    </div>
}

@if (visibleImages.Count == 0 && CurrentPack is null)
{
    <p class="empty-state">@(library.Stickers.Count == 0 ? "No images yet. Add images or GIFs to get started." : "No images match your search or filters.")</p>
}
else
{
    <div class="image-grid @(CurrentPack is not null ? "pack-stickers" : "")">
        @if (CurrentPack is { } currentPack)
        {
            <ActionMenu Label="Add sticker" TileStyle="true" Disabled="@(busy || currentPack.StickerIds.Count >= 30)">
                <TriggerContent><AddTileLabel Title="Add sticker" Hint="@(currentPack.StickerIds.Count >= 30 ? "Pack full · 30/30 stickers" : "Image, GIF, or layered image")" /></TriggerContent>
                <ChildContent><AddStickerChoices @key="importPickerVersion" Disabled="@(busy || currentPack.StickerIds.Count >= 30)" OnImport="Import" OnLayers="NewComposition" /></ChildContent>
            </ActionMenu>
        }
        @foreach (var image in visibleImages)
        {
            <article class="image-card" @key="image.Id">
                <input type="checkbox" class="image-select" aria-label="Select @image.Name"
                       checked="@selected.Contains(image.Id)" @onchange="() => Toggle(image.Id)" />
                <button class="image-preview" aria-label="Edit @image.Name" @onclick="() => Edit(image)">
                    <img src="@previews[image.Id]" alt="@image.Name" loading="lazy" />
                </button>
                <strong>@image.Name</strong>
                <small class="image-file-summary">@image.Width × @image.Height · @(image.Animated ? "Animated" : "Still")</small>
                <small class="image-file-summary">File @Size(ImageSize(image).FileBytes) · Stored @Size(ImageSize(image).TotalBytes)</small>
                @if (StickerApp.Shared.Services.StickerPreparationService.NeedsPreparation(image))
                {
                    <small class="sticker-preparation-status">@(Preparation.GetStatus(image)?.Error is not null ? "Needs attention · see ⓘ" : "Preparing…")</small>
                }
                <div class="card-actions">
                    <div class="sticker-actions">
                        <button class="button icon-button" type="button" @onclick="() => infoImageId = image.Id" title="Sticker details" aria-label="Details for @image.Name"><Icon Name="info" /></button>
                        <button class="button icon-button" type="button" @onclick="() => imageToAdd = image"
                                disabled="@busy" title="Add to pack" aria-label="Add @image.Name to pack">
                            <Icon Name="folder-plus" />
                        </button>
                        <button class="button icon-button" @onclick="() => Edit(image)" title="Edit image" aria-label="Edit @image.Name">
                            <Icon Name="edit" />
                        </button>
                        <button class="button icon-button danger" @onclick="() => pendingRemoval = image" title="Remove image" aria-label="Remove @image.Name">
                            <Icon Name="trash" />
                        </button>
                    </div>
                </div>
            </article>
        }
    </div>
}

@if (CurrentPack is not null && PackImages.Count > 0 && visibleImages.Count == 0)
{
    <p class="empty-state">No stickers match your search or filters.</p>
}

@if (InfoImage is { } infoImage)
{
    <StickerInfoDialog Image="infoImage" OnClose="() => infoImageId = null" OnEdit="EditFromInfo" />
}

@if (showLayerEditor)
{
    <LayerEditorDialog StickerId="@compositionStickerId" PackId="@activePack" Images="@library.Stickers" Previews="@previews"
                       OnCancel="() => showLayerEditor = false" OnSaved="CompositionSaved" />
}

@if (pendingImports is not null)
{
    <ImportOriginalChoices Items="@pendingImports.Select(file => file.Choice).ToList()" OnConfirm="ConfirmImageImport" OnCancel="CancelImageImport" />
}

@if (editing is not null)
{
    <dialog @ref="editDialog" class="folder-dialog image-edit-dialog" aria-labelledby="edit-title" aria-busy="@(busy || EditorOpening ? "true" : "false")" @onkeydown="EditorKeyDown">
        <h2 id="edit-title">@(IsGif ? "Edit GIF" : editing.Animated || replacementAnimated ? "Edit animated image" : "Edit image")</h2>
        @if (EditorOpening)
        {
            <div class="editor-loading" role="status" aria-live="polite">
                <span class="feedback-spinner" aria-hidden="true"></span>
                <strong>@busyText</strong>
            </div>
        }
        <div class="editor-dialog-body" hidden="@EditorOpening">
            @if (EditingStill || EditingAnimation)
            {
                <ImageCustomizer @key="editSource" Source="@editSource" OnReady="EditorToolsReady" Animated="@EditingAnimation" TrimStart="@trimStart" TrimEnd="@(gifDuration > 0 ? trimEnd : null)" OnEditsChanged="recipe => editRecipe = recipe" OnChanged="CustomizeImage" OnBusyChanged="value => customizing = value">
                    <Timeline>
                        @if (EditingAnimation && gifDuration > 0)
                        {
                            <AnimationTimeline Thumbnails="@gifThumbnails" Duration="@gifDuration" Start="@trimStart" End="@trimEnd"
                                               StartChanged="ChangeEditorTrimStart" EndChanged="ChangeEditorTrimEnd" Disabled="@(busy || customizing)" />
                        }
                    </Timeline>
                    <Options>
                        @if (EditingAnimation && gifDuration > 0)
                        {
                            <details class="editor-details">
                                <summary>Precise trim times</summary>
                                <div class="trim-fields">
                                    <label>Start (seconds)
                                        <input type="number" min="0" max="@GifMax" step="0.01" @bind="trimStart"
                                               @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:event="oninput" @bind:after="TrimStartChanged" disabled="@busy" />
                                    </label>
                                    <label>End (seconds)
                                        <input type="number" min="0" max="@GifMax" step="0.01" @bind="trimEnd"
                                               @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:event="oninput" @bind:after="TrimEndChanged" disabled="@busy" />
                                    </label>
                                </div>
                                <button class="button" @onclick="ResetTrim" disabled="@busy"><Icon Name="reset" /> Reset trim</button>
                            </details>
                        }
                        <details class="editor-details">
                            <summary>Name &amp; file options</summary>
                            <label>Name <input @bind="editName" @bind:event="oninput" maxlength="128" disabled="@busy" /></label>
                            <div class="edit-tools">
                                <label class="button file-button"><Icon Name="image" /> Replace image
                                    <InputFile OnChange="Replace" accept="image/*" disabled="@(busy || customizing)" aria-label="Replace image" />
                                </label>
                            </div>
                            <label class="toggle-row">
                                <input type="checkbox" @bind="keepEditOriginal" disabled="@(busy || customizing)" />
                                Keep the source image / GIF after saving
                            </label>
                            @if (!keepEditOriginal)
                            {
                                <p class="status-info" role="note">Only the prepared sticker will remain after conversion succeeds. You cannot restore the previous image or uncut animation unless you reimport your saved copy.</p>
                            }
                            <HelpDisclosure Summary="About original files">
                                <p class="helper">Keeping a source uses more storage. This choice applies when saving a trim, replacement, or image edit. Cancel keeps everything unchanged. Prepared animated WebP stickers can still be trimmed and edited; editable layer projects keep their own sources.</p>
                            </HelpDisclosure>
                        </details>
                    </Options>
                </ImageCustomizer>
            }
            else if (!EditorOpening)
            {
                <img class="edit-preview" src="@editPreview" alt="@editing.Name" />
            }
        </div>
        @if (editError is not null) { <p class="error" role="alert">@editError</p> }
        <div class="dialog-actions">
            <button class="button" @onclick="CancelEditing" disabled="@((busy && !editorLoading) || (customizing && !editorToolsLoading))">Cancel</button>
            @if (!EditorOpening)
            {
                <button class="button primary" @onclick="Save" disabled="@(busy || customizing)">Save</button>
            }
        </div>
    </dialog>
}

@if (pendingRemoval is not null || deletePack)
{
    <div class="modal-backdrop">
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="remove-title">
            <h2 id="remove-title">@(deletePack ? "Delete pack?" : "Remove image?")</h2>
            <p>@(deletePack ? "Images remain in the library." : pendingRemoval!.Name)</p>
            <div class="dialog-actions">
                <button class="button" @onclick="CancelRemoval">Cancel</button>
                <button class="button danger" @onclick="ConfirmRemoval" disabled="@busy"><Icon Name="trash" /> Remove</button>
            </div>
        </section>
    </div>
}

@if (imageToAdd is not null)
{
    <AddToPackDialog Image="@imageToAdd" OnAdded="FinishQuickAdd" OnCancel="() => imageToAdd = null" />
}

@if (packToShare is not null)
{
    <SharePackDialog Pack="@packToShare" PreparationPending="@PackImages.Any(StickerApp.Shared.Services.StickerPreparationService.NeedsPreparation)" OnClose="() => packToShare = null" />
}

@if (showGifSearch)
{
    <GifSearchDialog OnClose="() => showGifSearch = false" />
}
@if (renamingPack && CurrentPack is { } detailsPack)
{
    <NewPackDialog Pack="@detailsPack" OnSaved="PackDetailsSaved" OnCancel="() => renamingPack = false" />
}
