@inject AppLog Log
@page "/library"
@page "/packs/{PackId:guid}"
@implements IAsyncDisposable
@inject LibraryStore Store
@inject IWhatsAppExporter Exporter
@inject StickerApp.Shared.Services.IBulkImageImporter BulkImporter
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject StickerApp.Shared.Services.StickerPreparationService Preparation

<PageTitle>@L[CurrentPack?.Name ?? "My Library"] · Stik-er-in</PageTitle>

@if (CurrentPack?.Collection is { } collectionLink)
{
    <div class="status-info group-working-copy"><p>Group working copy · Revision @collectionLink.Revision. Your edits stay private here. Online group updates are under maintenance and will be added later.</p><div class="settings-actions"><OnlineOnly><button class="button" @onclick="UpdateGroupCollection" disabled="@(busy || FriendsFeature.UnderMaintenance)"><Icon Name="upload" />@L["Update group collection"]</button></OnlineOnly><a class="button" href="friends/collections/@collectionLink.CollectionId">@L["View shared collection"]</a></div></div>
}

<header class="page-header">
    <div class="page-title">
        @if (PackHeaderCover is { } cover)
        {
            <SpoilerPreview EyeBeside="true" IsSpoiler="@(CurrentPack is { } coverPack && library.IsNsfw(coverPack))" Name="@(CurrentPack?.Name ?? "Pack cover")"><img class="pack-title-cover spoiler-artwork" src="@cover" alt="@L["Pack cover"]" /></SpoilerPreview>
        }
        else if (CurrentPack is not null)
        {
            <span class="pack-title-cover pack-title-placeholder"><Icon Name="image" /></span>
        }
        <div class="pack-heading-text">
            <div class="pack-heading-name">
                <h1>@L[CurrentPack?.Name ?? "My Library"] @if(CurrentPack?.Nsfw is true){<span class="nsfw-name-tag">@L["[NSFW]"]</span>}</h1>
                @if (CurrentPack is { } visibilityPack)
                {
                    <span class="pack-visibility-indicator" role="img" aria-label="@L[visibilityPack.Public ? "Public pack" : "Private pack"]" title="@L[visibilityPack.Public ? "Public pack" : "Private pack"]">
                        <Icon Name="@(visibilityPack.Public ? "unlock" : "lock")" />
                    </span>
                }
            </div>
            @if (CurrentPack is { } headingPack) { <p class="helper pack-publisher">@L.Format("By {0}", headingPack.Publisher)</p> }
        </div>
    </div>
    <div class="header-actions sticker-toolbar">
        <ActionMenu Label="@L["Add stickers"]" IconName="plus" Primary="true" Disabled="@busy">
            @StickerImportChoices
        </ActionMenu>
        @if (CurrentPack is not null)
        {
            <ActionMenu Label="@L["Pack options"]" Disabled="@busy">
                <button class="toolbar-menu-option" type="button" @onclick="BeginRenamePack" disabled="@busy">
                    <Icon Name="edit" /><span>@L["Edit pack details"]<small>@L["Change the name, publisher, and cover."]</small></span>
                </button>
                @if (CurrentPack.Collection is not null)
                {
                    <OnlineOnly><button class="toolbar-menu-option" type="button" disabled="@busy" @onclick="UpdateGroupCollection"><Icon Name="upload" /><span>@L["Update group collection"]<small>@L["Share this working copy with the group. Other people’s updates are checked before saving."]</small></span></button></OnlineOnly>
                    <a class="toolbar-menu-option" href="friends/collections/@CurrentPack.Collection.CollectionId"><Icon Name="layers" /><span>@L["View shared collection"]<small>@L["See who added or edited stickers and their reactions."]</small></span></a>
                }
                <button class="toolbar-menu-option" type="button" disabled="@(busy || CurrentPack.Collection is not null)" aria-pressed="@CurrentPack.Public" @onclick="TogglePackVisibility">
                    <Icon Name="@(CurrentPack.Public ? "globe" : "lock")" /><span>@L[CurrentPack.Public ? "Public pack" : "Private pack"]<small>@L[CurrentPack.Public ? "Remove from the friends group and make private. Separate sharing links still work." : "Make public, then use Friends’ packs → Sync my public packs to share."]</small></span>
                </button>
                <button class="toolbar-menu-option" type="button" disabled="@busy" aria-pressed="@CurrentPack.Nsfw" @onclick="() => Run(() => Store.SetPackNsfwAsync(CurrentPack.Id, !CurrentPack.Nsfw))">
                    <Icon Name="eye-off" /><span>@L[CurrentPack.Nsfw ? "Remove NSFW tag" : "Mark pack as NSFW"]<small>@L["Blur previews for every sticker in this pack."]</small></span>
                </button>
                <button class="toolbar-menu-option" type="button" @onclick="() => packToShare = CurrentPack" disabled="@busy">
                    <Icon Name="share" /><span>@L["Share or export"]<small>@L["Save a pack file or create a sharing link."]</small></span>
                </button>
                <div class="toolbar-menu-divider"></div>
                <button class="toolbar-menu-option danger" type="button" @onclick="() => deletePack = true" disabled="@busy">
                    <Icon Name="trash" /><span>@L["Delete pack"]<small>@L["Images stay in your library."]</small></span>
                </button>
            </ActionMenu>
        }
    </div>
</header>

@if (notice is not null)
{
    <div class="notice @(noticeIsError ? "notice-error" : "notice-success")" role="@(noticeIsError ? "alert" : "status")">
        <Icon Name="@(noticeIsError ? "alert" : "check")" />
        <span class="notice-message">
        @L.Message(notice)
        </span>
        <button class="button icon-button" title="@L["Close message"]" @onclick="() => notice = null" aria-label="@L["Close message"]">
            <Icon Name="close" />
        </button>
    </div>
}
@if (busy)
{
    <p class="status-info" role="status">@L.Message(busyText)</p>
}

@{ var visibleImages = Visible; }
<div class="toolbar browse-toolbar">
    <label class="browse-search">@L["Search"]<input type="search" class="search" aria-label="@L["Search images"]" placeholder="@L["Search images or tags"]" @bind="search" @bind:event="oninput" /></label>
    <div class="browse-actions">
        <button class="button @(sort != "default" ? "browse-action-active" : "")" type="button" aria-label="@L["Sort images"]" aria-haspopup="dialog" @onclick='() => browsePanel = "sort"'>@L["Sort"]</button>
        <button class="button @(FilterCount > 0 ? "browse-action-active" : "")" type="button" aria-label="@L["Filter images"]" aria-haspopup="dialog" @onclick='() => browsePanel = "filters"'>Filters @if (FilterCount > 0) { <small class="filter-count">@FilterCount</small> }</button>
    </div>
</div>
@if (browsePanel is not null)
{
<BrowseOptionsPopup Title="@L[browsePanel == "sort" ? "Sort images" : "Filter images"]" OnClose="() => browsePanel = null">
    @if (browsePanel == "sort")
    {
    <label>@L["Sort by"]<select aria-label="@L["Sort images"]" @bind="sort">
        <option value="default">@L[CurrentPack is null ? "Recently added" : "Saved pack order"]</option>
        @if (CurrentPack is null) { <option value="oldest">@L["Oldest added"]</option> }
        <option value="name-asc">@L["Name: A–Z"]</option><option value="name-desc">@L["Name: Z–A"]</option>
        <option value="type">@L["Type"]</option>
        <option value="file-desc">@L["File size: largest first"]</option><option value="file-asc">@L["File size: smallest first"]</option>
        <option value="storage-desc">@L["Stored size: largest first"]</option><option value="storage-asc">@L["Stored size: smallest first"]</option>
    </select></label>
    }
    else
    {
    <div class="browse-filter-fields">
        <label>@L["Type"]<select aria-label="@L["Filter image type"]" @bind="typeFilter"><option value="all">@L["All types"]</option><option value="still">@L["Still images"]</option><option value="animated">@L["GIFs / animations"]</option><option value="layered">@L["Editable layers"]</option></select></label>
        <label>@L["Saved format"]<select aria-label="@L["Filter image format"]" @bind="formatFilter"><option value="all">@L["All formats"]</option><option value="webp">@L["WebP"]</option><option value="png">@L["PNG"]</option><option value="jpeg">@L["JPEG"]</option><option value="gif">@L["GIF"]</option></select></label>
        <label>@L["Total stored size"]<select aria-label="@L["Filter image storage"]" @bind="storageFilter"><option value="all">@L["Any size"]</option><option value="small">Under 100 @SmallSizeUnit</option><option value="medium">100–500 @SmallSizeUnit</option><option value="large">500 @SmallSizeUnit or more</option></select></label>
    </div>
    <p class="helper">@L["File size is the current image; stored size includes originals and layers. Prepared GIFs use WebP but remain under GIFs / animations."]</p>
    <button class="button" type="button" @onclick="ResetFilters">@L["Reset filters"]</button>
    }
</BrowseOptionsPopup>
}
<p class="helper browse-result" role="status">Showing @visibleImages.Count of @(CurrentPack is null ? library.Stickers.Count : PackImages.Count) images.@if (CurrentPack is not null) { <span> @L["Sorting changes this view only; saved sticker order stays the same."]</span> }</p>
@if (PendingPreparationCount > 0)
{
    <p class="helper" role="status">@L.Format("Preparing {0} stickers automatically… You can keep using the app.", PendingPreparationCount)</p>
}
@if (AttentionCount > 0)
{
    <p class="helper">@L.Format("{0} stickers need attention. Open their ⓘ details to see what needs adjusting.", AttentionCount)</p>
}

@if (CurrentPack is not null)
{
    @if (Exporter.IsAvailable)
    {
        <button class="button primary floating-whatsapp" title="@L["Add this pack to WhatsApp"]" @onclick="Export" disabled="@(busy || Validation.Count > 0)">
            <Icon Name="whatsapp" /> @L["Add to WhatsApp"]
        </button>
    }
    else
    {
        <button class="button primary floating-whatsapp" title="@L["Export a sticker pack file. Direct WhatsApp handoff needs a native app."]" @onclick="() => packToShare = CurrentPack" disabled="@busy">
            <Icon Name="download" /> @L["Export pack"]
        </button>
    }
    @if (Issues.Any(issue => issue.StickerId is null))
    {
        <AppDisclosure Class="validation" Open="true"><Header>@L["Fix before adding to WhatsApp"]</Header><ChildContent>
            <ul>
                @foreach (var issue in Issues.Where(issue => issue.StickerId is null))
                {
                    <li>
                        @L.Message(issue.Message)
                    </li>
                }
            </ul>
            <a href="settings#faq">@L["View requirements & FAQ"]</a>
        </ChildContent></AppDisclosure>
    }
}

@if (selected.Count > 0)
{
    <div class="selection-bar">
        <strong>@L.Format("{0} selected", selected.Count)</strong>
        <select aria-label="@L["Destination pack"]" @bind="destination">
            <option value="">@L["Choose pack"]</option>
            @foreach (var pack in library.Packs)
            {
                <option value="@pack.Id">@pack.Name</option>
            }
        </select>
        <button class="button icon-button" @onclick="CopySelection" disabled="@(busy || destination == "")" title="@L["Copy to pack"]" aria-label="@L["Copy to pack"]">
            <Icon Name="copy" />
        </button>
        @if (CurrentPack is not null)
        {
            <button class="button icon-button" @onclick="RemoveSelection" disabled="@busy" title="@L["Remove from pack"]" aria-label="@L["Remove from pack"]">
                <Icon Name="remove" />
            </button>
        }
        <button class="button icon-button" title="@L["Clear selection"]" aria-label="@L["Clear selection"]" @onclick="() => selected.Clear()">
            <Icon Name="close" />
        </button>
    </div>
}

@if (visibleImages.Count == 0 && CurrentPack is null)
{
    <p class="empty-state">@L[library.Stickers.Count == 0 ? "No images yet. Add images or GIFs to get started." : "No images match your search or filters."]</p>
}
else
{
    <div class="image-grid @(CurrentPack is not null ? "pack-stickers" : "")">
        @if (CurrentPack is { } currentPack)
        {
            <ActionMenu Label="@L["Add sticker"]" TileStyle="true" Disabled="@busy">
                <TriggerContent><AddTileLabel Title="@L["Add sticker"]" Hint="@L[currentPack.StickerIds.Count >= 30 ? "Pack full · 30/30 stickers" : "Image, GIF, or layered image"]" /></TriggerContent>
                <ChildContent>@StickerImportChoices</ChildContent>
            </ActionMenu>
        }
        @foreach (var image in visibleImages)
        {
            <article class="image-card" @key="image.Id" @onclick="() => Edit(image)">
                <input type="checkbox" class="image-select" @onclick:stopPropagation aria-label="Select @image.Name"
                       checked="@selected.Contains(image.Id)" @onchange="() => Toggle(image.Id)" />
                <SpoilerPreview IsSpoiler="@library.IsNsfw(image)" Name="@image.Name">
                <button class="image-preview" @onclick:stopPropagation aria-label="Edit @image.Name" @onclick="() => Edit(image)">
                    <img class="spoiler-artwork" src="@previews[image.Id]" alt="@image.Name" loading="lazy" />
                </button>
                </SpoilerPreview>
                <strong>@image.Name</strong>
                <small class="image-file-summary">@image.Width × @image.Height · @L[image.Animated ? "Animated" : "Still"]</small>
                <small class="image-file-summary">@L.Format("File {0} · Stored {1}", Size(ImageSize(image).FileBytes), Size(ImageSize(image).TotalBytes))</small>
                @if (StickerApp.Shared.Services.StickerPreparationService.NeedsPreparation(image))
                {
                    <small class="sticker-preparation-status">@L[Preparation.GetStatus(image)?.Error is not null ? "Needs attention · see ⓘ" : "Preparing…"]</small>
                }
                <div class="card-actions" @onclick:stopPropagation>
                    <div class="sticker-actions">
                        <button class="button icon-button" type="button" @onclick="() => infoImageId = image.Id" title="@L["Sticker details"]" aria-label="Details for @image.Name"><Icon Name="info" /></button>
                        <button class="button icon-button" type="button" @onclick="() => imageToAdd = image"
                                disabled="@busy" title="@L["Add to pack"]" aria-label="Add @image.Name to pack">
                            <Icon Name="folder-plus" />
                        </button>
                        <button class="button icon-button" @onclick="() => Edit(image)" title="@L["Edit image"]" aria-label="Edit @image.Name">
                            <Icon Name="edit" />
                        </button>
                        <button class="button icon-button danger" @onclick="() => pendingRemoval = image" title="@L["Remove sticker"]" aria-label="Remove @image.Name">
                            <Icon Name="trash" />
                        </button>
                    </div>
                </div>
            </article>
        }
    </div>
}

@if (CurrentPack is not null && PackImages.Count > 0 && visibleImages.Count == 0)
{
    <p class="empty-state">@L["No stickers match your search or filters."]</p>
}

@if (InfoImage is { } infoImage)
{
    <StickerInfoDialog Image="infoImage" OnClose="() => infoImageId = null" OnEdit="EditFromInfo" />
}

@if (showLayerEditor)
{
    <LayerEditorDialog StickerId="@compositionStickerId" PackId="@activePack" StartWithText="@compositionStartWithText" StartWithShape="@compositionStartWithShape" InitialSource="@compositionInitialSource" InitialName="@compositionInitialName" InitialNsfw="@compositionInitialNsfw" ReturnToEditor="@compositionFromEditor" Images="@library.Stickers" Previews="@previews"
                       OnCancel="CancelComposition" OnSaved="CompositionSaved" />
}

@if (pendingImports is not null)
{
    <ImportOriginalChoices Items="@pendingImports.Select(file => file.Choice).ToList()" OnConfirm="ConfirmImageImport" OnCancel="CancelImageImport" />
}

@if (editing is not null)
{
    <dialog @ref="editDialog" class="folder-dialog image-edit-dialog" aria-labelledby="edit-title" aria-busy="@(busy || EditorOpening ? "true" : "false")" @onkeydown="EditorKeyDown">
        <div class="editor-dialog-heading">
            <h2 id="edit-title">@L[IsGif ? "Edit GIF" : editing.Animated || replacementAnimated ? "Edit animated image" : "Edit image"]</h2>
            <div class="editor-header-actions" hidden="@editorToolActive">
                <button class="button icon-button" type="button" @onclick="CancelEditing" disabled="@((busy && !editorLoading) || (customizing && !editorToolsLoading))" aria-label="@L["Cancel"]" title="@L["Cancel editing"]"><Icon Name="close" /></button>
                @if (!EditorOpening) { <button class="button primary icon-button" type="button" @onclick="Save" disabled="@(busy || customizing)" aria-label="@L["Save"]" title="@L["Save sticker"]"><Icon Name="check" /></button> }
            </div>
        </div>
        @if (EditorOpening)
        {
            <div class="editor-loading" role="status" aria-live="polite">
                <span class="feedback-spinner" aria-hidden="true"></span>
                <strong>@L.Message(busyText)</strong>
            </div>
        }
        <div class="editor-dialog-body" hidden="@EditorOpening">
            @if (EditingStill || EditingAnimation)
            {
                <ImageCustomizer @key="editSource" Source="@editSource" OnReady="EditorToolsReady" OnAddText="RequestAddText" OnAddShape="RequestAddShape" OnMakeLayered="MakeEditedLayered" Animated="@EditingAnimation" TrimStart="@trimStart" TrimEnd="@(gifDuration > 0 ? trimEnd : null)" OnEditsChanged="recipe => editRecipe = recipe" OnChanged="CustomizeImage" OnBusyChanged="value => customizing = value" OnToolActiveChanged="value => editorToolActive = value">
                    <Timeline Context="playback">
                        @if (EditingAnimation && gifDuration > 0)
                        {
                            <AnimationTimeline Thumbnails="@gifThumbnails" Duration="@gifDuration" Start="@trimStart" End="@trimEnd"
                                               StartChanged="ChangeEditorTrimStart" EndChanged="ChangeEditorTrimEnd" Disabled="@(busy || customizing)">
                                <PlaybackControl><button class="button animation-preview-button" type="button" @onclick="playback.Toggle" disabled="@playback.Disabled" aria-label="@L[playback.Playing ? "Stop preview" : "Preview animation"]"><Icon Name="@(playback.Playing ? "pause" : "play")" />@L[playback.Playing ? "Pause" : "Preview"]</button></PlaybackControl>
                            </AnimationTimeline>
                        }
                    </Timeline>
                    <Options>
                            <label class="toggle-row editor-spoiler-toggle"><input type="checkbox" @bind="editNsfw" disabled="@(busy || customizing)" />@L["NSFW spoiler"]</label>
                            <label>@L["Name"] <input @bind="editName" @bind:event="oninput" maxlength="128" disabled="@busy" /></label>
                            <div class="edit-tools">
                                <label class="button file-button"><Icon Name="image" /> @L["Replace image"]
                                    <InputFile OnChange="Replace" accept="image/*" disabled="@(busy || customizing)" aria-label="@L["Replace image"]" />
                                </label>
                            </div>
                            <label class="toggle-row">
                                <input type="checkbox" @bind="keepEditOriginal" disabled="@(busy || customizing)" />
                                @L["Keep the source image / GIF after saving"]
                            </label>
                            @if (!keepEditOriginal)
                            {
                                <p class="status-info" role="note">@L["Only the prepared sticker will remain after conversion succeeds. You cannot restore the previous image or uncut animation unless you reimport your saved copy."]</p>
                            }
                        @if (EditingAnimation && gifDuration > 0)
                        {
                            <AppDisclosure Class="editor-details"><Header>@L["Precise trim times"]</Header><ChildContent>
                                <div class="trim-fields">
                                    <label>@L["Start (seconds)"]
                                        <input type="number" min="0" max="@GifMax" step="0.01" @bind="trimStart"
                                               @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:event="oninput" @bind:after="TrimStartChanged" disabled="@busy" />
                                    </label>
                                    <label>@L["End (seconds)"]
                                        <input type="number" min="0" max="@GifMax" step="0.01" @bind="trimEnd"
                                               @bind:culture="System.Globalization.CultureInfo.InvariantCulture" @bind:event="oninput" @bind:after="TrimEndChanged" disabled="@busy" />
                                    </label>
                                </div>
                                <button class="button" @onclick="ResetTrim" disabled="@busy"><Icon Name="reset" /> @L["Reset trim"]</button>
                            </ChildContent></AppDisclosure>
                        }
                            <HelpDisclosure Summary="@L["About original files"]">
                                <p class="helper">@L["Keeping a source uses more storage. This choice applies when saving a trim, replacement, or image edit. Cancel keeps everything unchanged. Prepared animated WebP stickers can still be trimmed and edited; editable layer projects keep their own sources."]</p>
                            </HelpDisclosure>
                    </Options>
                </ImageCustomizer>
            }
            else if (!EditorOpening)
            {
                <img class="edit-preview" src="@editPreview" alt="@editing.Name" />
            }
        </div>
        @if (editError is not null) { <p class="error" role="alert">@L.Error(editError)</p> }
    </dialog>
}

@if (pendingRemoval is not null || deletePack)
{
    <div class="modal-backdrop">
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="remove-title">
            <h2 id="remove-title">@L[deletePack ? "Delete pack?" : "Remove sticker?"]</h2>
            <p>@L[deletePack ? "Stickers remain in the library." : pendingRemoval!.Name]</p>
            <div class="dialog-actions">
                <button class="button" @onclick="CancelRemoval">@L["Cancel"]</button>
                <button class="button danger" @onclick="ConfirmRemoval" disabled="@busy"><Icon Name="trash" /> @L["Remove"]</button>
            </div>
        </section>
    </div>
}

@if (imageToAdd is not null)
{
    <AddToPackDialog Image="@imageToAdd" OnAdded="FinishQuickAdd" OnCancel="() => imageToAdd = null" />
}

@if (packToShare is not null)
{
    <SharePackDialog Pack="@packToShare" PreparationPending="@PackImages.Any(StickerApp.Shared.Services.StickerPreparationService.NeedsPreparation)" OnClose="() => packToShare = null" />
}

@if (showGifSearch)
{
    <GifSearchDialog PackId="@activePack" OnImported="Reload" OnClose="() => showGifSearch = false" />
}
@if (renamingPack && CurrentPack is { } detailsPack)
{
    <NewPackDialog Pack="@detailsPack" OnSaved="PackDetailsSaved" OnCancel="() => renamingPack = false" />
}

@if (showVideoImport)
{
    <VideoImportDialog PackId="@activePack" OnClose="() => showVideoImport = false" OnImported="VideoImported" />
}

@code {
    private RenderFragment StickerImportChoices => @<AddStickerChoices @key="importPickerVersion"
        Disabled="@busy" AtCapacity="@(CurrentPack?.StickerIds.Count >= 30)" PackId="@CurrentPack?.Id" PackName="@CurrentPack?.Name"
        CanImportFolder="@BulkImporter.IsAvailable" FolderImportLabel="@BulkImporter.ActionLabel"
        OnImport="Import" OnLayers="NewComposition" OnVideo="() => showVideoImport = true"
        OnGifSearch="() => showGifSearch = true" OnImportFolder="ImportFolder" OnImportPack="ImportPack" />;
}

@if (confirmLayeredText)
{
    <ConfirmLayeringDialog AddingShape="@pendingLayeredShape" OnCancel="() => confirmLayeredText = false" OnContinue="ConfirmAddText" />
}
