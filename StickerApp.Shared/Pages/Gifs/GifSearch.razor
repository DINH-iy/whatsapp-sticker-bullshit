@inject AppLog Log
@inject LibraryStore Store
@inject StickerApp.Shared.Services.IFormFactor FormFactor
@page "/gifs"
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (!Embedded)
{
    <PageTitle>GIF search · Stik-er-in</PageTitle>
    <header class="page-header"><h1>GIF search</h1></header>
}

@if (!isReady)
{
    <p class="helper" role="status">Loading GIF search…</p>
}
else if (!isConfigured)
{
    <section class="settings-card gif-setup">
        <h2>Connect KLIPY</h2>
        <p>Add your KLIPY API key in Settings to search for GIFs.</p>
        <a class="button primary" href="settings#gif-search">Set up GIF search</a>
    </section>
}
else
{
    <form class="gif-search-form" @onsubmit="StartSearch" @onsubmit:preventDefault>
        <label class="visually-hidden" for="gif-query">Search KLIPY GIFs</label>
        <input id="gif-query" class="search" @bind="query" @bind:event="oninput"
               placeholder="Search KLIPY" maxlength="200" disabled="@(isLoading || IsImporting)" autofocus="@Embedded" />
        <button class="button primary" type="submit" disabled="@(isLoading || IsImporting || string.IsNullOrWhiteSpace(query))">Search</button>
    </form>

    <HelpDisclosure Summary="About importing GIFs">
        <p class="helper">Choose Import to add a GIF directly to @(PackId is null ? "All images" : "this pack"). Imports use your GIF original-file setting; sticker preparation runs automatically. Maximum file size: 10 MB.</p>
    </HelpDisclosure>
    @if (IsImporting)
    {
        <div class="notice gif-import-status" role="status">
            <span><span class="feedback-spinner" aria-hidden="true"></span> @(importCommitting ? "Adding GIF…" : "Downloading GIF…")</span>
            <button class="button" type="button" @onclick="CancelImport" disabled="@(importCommitting || importCancellation!.IsCancellationRequested)">Cancel import</button>
        </div>
    }
    @if (importNotice is not null)
    {
        <div class="notice" role="status">@importNotice <a href="@(PackId is { } pack ? $"packs/{pack}" : "library")">View images</a></div>
    }
    @if (importError is not null) { <p class="error" role="alert">@importError</p> }
    @if (hasSearched)
    {
        <h2 class="gif-results-heading">Results for “@activeQuery”</h2>
    }

    @if (selectedGif is not null)
    {
        <div class="gif-share-panel">
            <label for="selected-gif-link">Share link · @selectedGif.Title</label>
            <input id="selected-gif-link" class="folder-input" value="@selectedGif.ShareUrl" readonly />
            <p class="helper" role="status">@shareNotice</p>
        </div>
    }

    <div class="gif-grid" aria-label="KLIPY GIF results" aria-busy="@(isLoading ? "true" : "false")">
        @foreach (var gif in results)
        {
            <article class="gif-card">
                @if (!string.IsNullOrEmpty(gif.PreviewUrl))
                {
                    <img src="@gif.PreviewUrl" alt="@gif.Title" loading="lazy" />
                }
                else
                {
                    <div class="gif-unavailable">Preview unavailable</div>
                }
                <div class="gif-card-footer">
                    <span title="@gif.Title">@gif.Title</span>
                    <div class="gif-card-actions">
                        <button class="button primary gif-import-button" type="button" @onclick="() => ImportGif(gif)"
                                disabled="@(IsImporting || string.IsNullOrEmpty(gif.ShareUrl) || importedUrls.Contains(gif.ShareUrl))"
                                aria-label="@(importedUrls.Contains(gif.ShareUrl) ? $"Imported {gif.Title}" : $"Import {gif.Title}")">
                            <Icon Name="@(importedUrls.Contains(gif.ShareUrl) ? "check" : "plus")" />
                            @(importedUrls.Contains(gif.ShareUrl) ? "Imported" : importingUrl == gif.ShareUrl ? "Importing…" : "Import")
                        </button>
                        <button class="button icon-button" type="button" @onclick="() => CopyLink(gif)"
                                disabled="@(isCopying || string.IsNullOrEmpty(gif.ShareUrl))"
                                title="Copy link" aria-label="Copy link for @gif.Title">
                            <Icon Name="copy" />
                        </button>
                        @if (!string.IsNullOrEmpty(gif.ShareUrl))
                        {
                            <a class="button icon-button" href="@gif.ShareUrl" target="_blank" rel="noopener noreferrer"
                               title="Open original GIF to save" aria-label="Open @gif.Title to save">
                                <Icon Name="download" />
                            </a>
                        }
                    </div>
                </div>
            </article>
        }
    </div>

    @if (isLoading)
    {
        <p class="helper" role="status">Finding GIFs…</p>
    }
    else if (results.Count == 0 && error is null)
    {
        <p class="empty-state">@(hasSearched ? "No GIFs found. Try another search." : "Search for a reaction to get started.")</p>
    }

    @if (hasNextPage)
    {
        <div class="gif-load-more">
            <button class="button" type="button" @onclick="LoadMore" disabled="@(isLoading || IsImporting)">Load more GIFs</button>
        </div>
    }
}

@if (error is not null)
{
    <div class="notice notice-error" role="alert">
        <span>@error</span>
        @if (isConfigured)
        {
            <button class="button" type="button" @onclick="RetrySearch" disabled="@(isLoading || IsImporting)">Try again</button>
        }
    </div>
}
