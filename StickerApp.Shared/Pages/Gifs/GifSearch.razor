@inject StickerApp.Shared.Services.ConnectionState Connection
@inject AppLog Log
@inject LibraryStore Store
@inject StickerApp.Shared.Services.IFormFactor FormFactor
@page "/gifs"
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (!Embedded)
{
    <PageTitle>@L["GIF search · Stik-er-in"]</PageTitle>
    <header class="page-header"><h1>@L["GIF search"]</h1></header>
}

@if (!isReady)
{
    <p class="helper" role="status">@L["Loading GIF search…"]</p>
}
else if (!isConfigured)
{
    <section class="settings-card gif-setup">
        <h2>@L["Connect KLIPY"]</h2>
        <p>@L["Add your KLIPY API key in Settings to search for GIFs."]</p>
        <a class="button primary" href="settings#gif-search">@L["Set up GIF search"]</a>
    </section>
}
else
{
    <OnlineOnly><form class="gif-search-form" @onsubmit="StartSearch" @onsubmit:preventDefault>
        <label class="visually-hidden" for="gif-query">@L["Search KLIPY GIFs"]</label>
        <input id="gif-query" class="search" @bind="query" @bind:event="oninput"
               placeholder="@L["Search KLIPY"]" maxlength="200" disabled="@(isLoading || IsImporting)" autofocus="@Embedded" />
        <button class="button primary" type="submit" disabled="@(isLoading || IsImporting || string.IsNullOrWhiteSpace(query))">@L["Search"]</button>
    </form></OnlineOnly>

    <HelpDisclosure Summary="@L["About importing GIFs"]">
        <p class="helper">@L["Choose Import to save a GIF to your library, then choose a pack or keep it in My Library. Imports use your GIF original-file setting; sticker preparation runs automatically. Maximum file size: 10 MB."]</p>
    </HelpDisclosure>
    @if (IsImporting)
    {
        <div class="notice gif-import-status" role="status">
            <span><span class="feedback-spinner" aria-hidden="true"></span> @L[importCommitting ? "Adding GIF…" : "Downloading GIF…"]</span>
            <button class="button" type="button" @onclick="CancelImport" disabled="@(importCommitting || importCancellation!.IsCancellationRequested)">@L["Cancel import"]</button>
        </div>
    }
    @if (importNotice is not null)
    {
        <div class="notice" role="status">@L.Message(importNotice) <a href="library">@L["View images"]</a></div>
    }
    @if (importError is not null) { <p class="error" role="alert">@L.Error(importError)</p> }
    @if (hasSearched)
    {
        <h2 class="gif-results-heading">@L.Format("Results for “{0}”", activeQuery)</h2>
    }

    <div class="gif-grid" aria-label="@L["KLIPY GIF results"]" aria-busy="@(isLoading ? "true" : "false")">
        @foreach (var gif in results)
        {
            <article class="gif-card">
                @if (!string.IsNullOrEmpty(gif.PreviewUrl))
                {
                    <img src="@gif.PreviewUrl" alt="@gif.Title" loading="lazy" />
                }
                else
                {
                    <div class="gif-unavailable">@L["Preview unavailable"]</div>
                }
                <div class="gif-card-footer">
                    <span title="@gif.Title">@gif.Title</span>
                    <div class="gif-card-actions">
<OnlineOnly>                        <button class="button primary gif-import-button" type="button" @onclick="() => ImportGif(gif)"
                                disabled="@(IsImporting || string.IsNullOrEmpty(gif.ShareUrl) || importedUrls.Contains(gif.ShareUrl))"
                                aria-label="@L[importedUrls.Contains(gif.ShareUrl) ? $"Imported {gif.Title}" : $"Import {gif.Title}"]">
                            <Icon Name="@(importedUrls.Contains(gif.ShareUrl) ? "check" : "plus")" />
                            @L[importedUrls.Contains(gif.ShareUrl) ? "Imported" : importingUrl == gif.ShareUrl ? "Importing…" : "Import"]
                        </button></OnlineOnly>
                        @if (!string.IsNullOrEmpty(gif.ShareUrl))
                        {
                            <a class="button icon-button" href="@gif.ShareUrl" target="_blank" rel="noopener noreferrer"
                               title="@L["Open in browser"]" aria-label="Open @gif.Title in browser">
                                <Icon Name="link" />
                            </a>
                        }
                    </div>
                </div>
            </article>
        }
    </div>

    @if (isLoading)
    {
        <p class="helper" role="status">@L["Finding GIFs…"]</p>
    }
    else if (results.Count == 0 && error is null)
    {
        <p class="empty-state">@L[hasSearched ? "No GIFs found. Try another search." : "Search for a reaction to get started."]</p>
    }

    @if (hasNextPage)
    {
        <div class="gif-load-more">
            <OnlineOnly><button class="button" type="button" @onclick="LoadMore" disabled="@(isLoading || IsImporting)">@L["Load more GIFs"]</button></OnlineOnly>
        </div>
    }
}

@if (error is not null)
{
    <div class="notice notice-error" role="alert">
        <span>@L.Error(error)</span>
        @if (isConfigured)
        {
            <OnlineOnly><button class="button" type="button" @onclick="RetrySearch" disabled="@(isLoading || IsImporting)">@L["Try again"]</button></OnlineOnly>
        }
    </div>
}

@if (importedImage is not null)
{
    <AddToPackDialog Image="@importedImage" Title="@L["Add imported GIF to a pack?"]" CancelLabel="Keep in library"
                     Description="Your GIF is saved. Choose a pack below, or keep it in My Library."
                     OnAdded="ImportAddedToPack" OnCancel="KeepImportedInLibrary" />
}
