@page "/"
@inject LibraryStore Store
@inject NavigationManager Navigation

<PageTitle>Packs · Stick it</PageTitle>
<header class="page-header">
    <h1>Packs</h1>
    <div class="header-actions">
        <label class="button file-button" title="Open a .wastickers pack or an editable ZIP backup">
            <Icon Name="folder-import" /> Import pack
            <InputFile OnChange="ImportPack" accept=".zip,.wastickers" disabled="@busy" aria-label="Import pack file" />
        </label>
    </div>
</header>
@if (error is not null)
{
    <p class="error" role="alert">@error</p>
}
@if (showCreate)
{
    <NewPackDialog OnCreated="PackCreated" OnCancel="() => showCreate = false" />
}
<div class="image-grid pack-grid">
    <AddTile Title="New pack" Hint="Start a sticker collection" Disabled="@(busy || library.Packs.Count >= 10)" OnClick="() => showCreate = true" />
    @foreach (var pack in library.Packs)
    {
        <article class="image-card pack-card" @key="pack.Id">
            <a class="pack-card-link" href="@($"packs/{pack.Id}")" aria-label="@($"Open {pack.Name}")">
                <div class="pack-cover">
                    @if (covers.TryGetValue(pack.Id, out var cover))
                    {
                        <img src="@cover" alt="" loading="lazy" />
                    }
                    else
                    {
                        <Icon Name="image" />
                    }
                </div>
                <strong>@pack.Name</strong>
                <small>@pack.StickerIds.Count @(pack.StickerIds.Count == 1 ? "sticker" : "stickers")</small>
            </a>
            <PackCoverPicker Pack="@pack" OnChanged="Reload" AllowRemove="false" />
        </article>
    }
</div>
@if (library.Packs.Count >= 10)
{
    <p class="helper">This build supports up to 10 packs.</p>
}
