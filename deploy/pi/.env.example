# A hostname you control, e.g. stickers.example.com. Do not include https://.
PACK_DOMAIN=

# Generate a private token with: openssl rand -hex 32
PACK_PUBLISH_TOKEN=

# Default persistent archive storage: 2 GiB. Increase if needed.
PACK_STORAGE_LIMIT_BYTES=2147483648

# Optional: enable the invited-friends pack overview. Generate separately with openssl rand -hex 32.
FRIENDS_INVITE_CODE=
FRIENDS_STORAGE_LIMIT_BYTES=2147483648
